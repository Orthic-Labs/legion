{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arcane-budget-governance-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "contractId", "version", "contractDigest", "objectiveLineageId", "objectiveDigest", "legionBlastMapCapMs", "sagePlanningCapMs", "maxContractVersions", "resumeEvidence", "authentication"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "arcane-budget-governance"},
    "contractId": {"type": "string", "pattern": "^EC-\\d+$"},
    "version": {"type": "integer", "minimum": 1},
    "contractDigest": {"$ref": "#/$defs/digest"},
    "objectiveLineageId": {"type": "string", "minLength": 1},
    "objectiveDigest": {"$ref": "#/$defs/digest"},
    "legionBlastMapCapMs": {"type": "integer", "minimum": 1},
    "sagePlanningCapMs": {"type": "integer", "minimum": 1},
    "maxContractVersions": {"const": 2},
    "resumeEvidence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/resume"}]},
    "amendmentEvidence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/amendment"}]},
    "userScopeExpansionEvidence": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/scopeExpansion"}]},
    "authentication": {"type": "object"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "auth": {"type": "object"},
    "resume": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "objectiveDigest", "priorLineageId", "newLineageId", "userTurnDigest", "sessionId", "observedAt", "authentication"],
      "properties": {"schemaVersion": {"const": 1}, "kind": {"const": "arcane-budget-resume-evidence"}, "objectiveDigest": {"$ref": "#/$defs/digest"}, "priorLineageId": {"type": "string", "minLength": 1}, "newLineageId": {"type": "string", "minLength": 1}, "userTurnDigest": {"$ref": "#/$defs/digest"}, "sessionId": {"type": "string", "minLength": 1}, "observedAt": {"type": "string", "format": "date-time"}, "authentication": {"$ref": "#/$defs/auth"}}
    },
    "amendment": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "priorContractDigest", "newContractDigest", "priorLegionBlastMapCapMs", "newLegionBlastMapCapMs", "priorSagePlanningCapMs", "newSagePlanningCapMs", "scopeExpanded", "invocationProofDigest", "observedAt", "authentication"],
      "properties": {"schemaVersion": {"const": 1}, "kind": {"const": "arcane-budget-amendment"}, "priorContractDigest": {"$ref": "#/$defs/digest"}, "newContractDigest": {"$ref": "#/$defs/digest"}, "priorLegionBlastMapCapMs": {"type": "integer", "minimum": 1}, "newLegionBlastMapCapMs": {"type": "integer", "minimum": 1}, "priorSagePlanningCapMs": {"type": "integer", "minimum": 1}, "newSagePlanningCapMs": {"type": "integer", "minimum": 1}, "scopeExpanded": {"type": "boolean"}, "invocationProofDigest": {"$ref": "#/$defs/digest"}, "observedAt": {"type": "string", "format": "date-time"}, "authentication": {"$ref": "#/$defs/auth"}}
    },
    "scopeExpansion": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "kind", "priorContractDigest", "newContractDigest", "userTurnDigest", "hostEventDigest", "sessionId", "observedAt", "authentication"],
      "properties": {"schemaVersion": {"const": 1}, "kind": {"const": "arcane-budget-scope-expansion-evidence"}, "priorContractDigest": {"$ref": "#/$defs/digest"}, "newContractDigest": {"$ref": "#/$defs/digest"}, "userTurnDigest": {"$ref": "#/$defs/digest"}, "hostEventDigest": {"$ref": "#/$defs/digest"}, "sessionId": {"type": "string", "minLength": 1}, "observedAt": {"type": "string", "format": "date-time"}, "authentication": {"$ref": "#/$defs/auth"}}
    }
  }
}
