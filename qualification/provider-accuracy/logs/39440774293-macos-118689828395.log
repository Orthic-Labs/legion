/Frameworks/Python.framework/Versions/3.14/lib/python3.14/zoneinfo/_common.py":"sha256:0da0f341817363ada0437a53d41611aeb85ac3a9f58229f3b34d4acc49576465","opt/homebrew/Cellar/python@3.14/3.14.7/Frameworks/Python.framework/Versions/3.14/lib/python3.14/zoneinfo/_tzpath.py":"sha256:e5026fcd64e30a41c2d6c7609e6d77757c4da9f431f5a1e14b1bccaf914489c3","opt/homebrew/Cellar/python@3.14/3.14.7/Frameworks/Python.framework/Versions/3.14/lib/python3.14/zoneinfo/_zoneinfo.py":"sha256:0279b3226e70f7ec2a8b0127f4bcab524587486ae1f80b26eb46ee87ba95bfe4","opt/homebrew/Cellar/sqlite/3.53.4/lib/libsqlite3.3.53.4.dylib":"sha256:c8d5d0225a3cf6462b0de9c38ea90c23c84a7234076032876783a92c01949629","opt/homebrew/Cellar/xz/5.8.3/lib/liblzma.5.dylib":"sha256:7a9e58053dfa9296d25076c886b47b6c29ad5e6ae8031789a5bf86b641aa63af","opt/homebrew/Cellar/zstd/1.5.7_1/lib/libzstd.1.5.7.dylib":"sha256:40cde10ac8415f73144109a6e4f80a403ca0a3259e5fd227158277bab146e6d8"},"links":{"opt/homebrew/Cellar/mpdecimal/4.0.1/lib/libmpdec.4.dylib":"libmpdec.4.0.1.dylib","opt/homebrew/Cellar/python@3.14/3.14.7/Frameworks/Python.framework/Versions/3.14/lib/python3.14/config-3.14-darwin/libpython3.14.a":"../../../Python","opt/homebrew/Cellar/python@3.14/3.14.7/Frameworks/Python.framework/Versions/3.14/lib/python3.14/config-3.14-darwin/libpython3.14.dylib":"../../../Python","opt/homebrew/Cellar/sqlite/3.53.4/lib/libsqlite3.dylib":"libsqlite3.3.53.4.dylib","opt/homebrew/Cellar/zstd/1.5.7_1/lib/libzstd.1.dylib":"libzstd.1.5.7.dylib","opt/homebrew/opt/mpdecimal":"../Cellar/mpdecimal/4.0.1","opt/homebrew/opt/openssl@3":"../Cellar/openssl@3/3.6.4","opt/homebrew/opt/sqlite":"../Cellar/sqlite/3.53.4","opt/homebrew/opt/xz":"../Cellar/xz/5.8.3","opt/homebrew/opt/zstd":"../Cellar/zstd/1.5.7_1"},"root":"/","roots":["/Users/runner/work/_temp/legion-python-tools/pip-audit/venv","/opt/homebrew/Cellar/mpdecimal/4.0.1/lib/libmpdec.4.0.1.dylib","/opt/homebrew/Cellar/openssl@3/3.6.4/lib/libcrypto.3.dylib","/opt/homebrew/Cellar/openssl@3/3.6.4/lib