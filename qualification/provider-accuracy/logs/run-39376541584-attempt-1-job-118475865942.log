iption\":\"Attempting to call `grow` on a spilled SmallVec with a value equal to the current capacity causes it to free the existing data. This performs a double free immediately and may lead to use-after-free on subsequent accesses to the SmallVec contents.\\n\\nAn attacker that controls the value passed to `grow` may exploit this flaw to obtain memory contents or gain remote code execution.\\n\\nCredits to [@ehuss](https://github.com/ehuss) for discovering, reporting and fixing the bug.\",\"date\":\"2019-06-06\",\"aliases\":[\"CVE-2019-15551\",\"GHSA-mm7v-vpv8-xfc3\"],\"related\":[],\"collection\":\"crates\",\"categories\":[],\"keywords\":[\"double free\",\"use after free\",\"arbitrary code execution\"],\"cvss\":\"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H\",\"informational\":null,\"references\":[],\"source\":null,\"url\":\"https://github.com/servo/rust-smallvec/issues/148\",\"withdrawn\":null,\"license\":\"CC0-1.0\",\"expect-deleted\":false},\"versions\":{\"patched\":[\">=0.6.10\"],\"unaffected\":[\"<0.6.5\"]},\"affected\":{\"arch\":[],\"os\":[],\"functions\":{\"smallvec::SmallVec::grow\":[\"<0.6.10, >=0.6.5\"]}},\"package\":{\"name\":\"smallvec\",\"version\":\"0.6.9\",\"source\":\"registry+https://github.com/rust-lang/crates.io-index\",\"checksum\":null,\"replace\":null}}]},\"warnings\":{}}\n"},"stderr":{"path":"legion-audit/c9d03cc71494dcb26ad1809c5e147c40986f0d492ebae23c2eae4c6698eae188/stderr","digest":"sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","bytes":0,"immutable":true,"raw":""},"parser":{"attempted":false,"succeeded":false,"error":null},"gaps":[]},"actualStdout":"{\"database\":{\"advisory-count\":1,\"last-commit\":null,\"last-updated\":null},\"lockfile\":{\"dependency-count\":1},\"settings\":{\"target_arch\":[],\"target_os\":[],\"severity\":null,\"ignore\":[],\"informational_warnings\":[\"unmaintained\",\"unsound\",\"notice\"]},\"vulnerabilities\":{\"found\":true,\"count\":1,\"list\":[{\"advisory\":{\"id\":\"RUSTSEC-2019-0009\",\"package\":\"smallvec\",\"title\":\"Double-free and use-after-free in SmallVec::grow()\",\"description\":\"Attempting to call `grow` on a spilled SmallVec with a value equal to the current capacity causes it to free the existing data. This performs a double free immediately and may lead to use-after-free on subsequent accesses to the SmallVec contents.\\n\\nAn attacker that controls the value passed to `grow` may exploit this flaw to obtain memory contents or gain remote code execution.\\n\\nCredits to [@ehuss](https://github.com/ehuss) for discovering, reporting and fixing the bug.\",\"date\":\"2019-06-06\",\"aliases\":[\"CVE-2019-15551\",\"GHSA-mm7v-vpv8-xfc3\"],\"related\":[],\"collection\":\"crates\",\"categories\":[],\"keywords\":[\"double free\",\"use after free\",\"arbitrary code execution\"],\"cvss\":\"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H\",\"informational\":null,\"references\":[],\"source\":null,\"url\":\"https://github.com/servo/rust-smallvec/issues/148\",\"withdrawn\":null,\"license\":\"CC0-1.0\",\"expect-deleted\":false},\"versions\":{\"patched\":[\">=0.6.10\"],\"unaffected\":[\"<0.6.5\"]},\"affected\":{\"arch\":[],\"os\":[],\"functions\":{\"smallvec::SmallVec::grow\":[\"<0.6.10, >=0.6.5\"]}},\"package\":{\"name\":\"smallvec\",\"version\":\"0.6.9\",\"source\":\"registry+https://github.com/rust-lang/crates.io-index\",\"checksum\":null,\"replace\":null}}]},\"warnings\":{}}\n","actualStderr":"","actualToolReport":{"database":{"advisory-count":1,"last-commit":null,"last-updated":null},"lockfile":{"dependency-count":1},"settings":{"target_arch":[],"target_os":[],"severity":null,"ignore":[],"informational_warnings":["unmaintained","unsound","notice"]},"vulnerabilities":{"found":true,"count":1,"list":[{"advisory":{"id":"RUSTSEC-2019-0009","package":"smallvec","title":"Double-free and use-after-free in SmallVec::grow()","description":"Attempting to call `grow` on a spilled SmallVec with a value equal to the current capacity causes it to free the existing data. This performs a double free immediately and may lead to use-after-free on subsequent accesses to the SmallVec contents.\n\nAn attacker that controls the value passed to `grow` may exploit this flaw to obtain memory contents or gain remote code execution.\n\nCredits to [@ehuss](https://github.com/ehuss) for discovering, reporting and fixing the bug.","date":"2019-06-06","aliases":["CVE-2019-15551","GHSA-mm7v-vpv8-xfc3"],"related":[],"collection":"crates","categories":[],"keywords":["double free","use after free","arbitrary code execution"],"cvss":"CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H","informational":null,"references":[],"source":null,"url":"https://github.com/servo/rust-smallvec/issues/148","withdrawn":null,"license":"CC0-1.0","expect-deleted":false},"versions":{"patched":[">=0.6.10"],"unaffected":["<0.6.5"]},"affected":{"arch":[],"os":[],"functions":{"smallvec::SmallVec::grow":["<0.6.10, >=0.6.5"]}},"package":{"name":"smallvec","version":"0.6.9","source":"registry+https://github.com/rust-lang/crates.io-index","checksum":null,"replace":null}}]},"warnings":{}}},{"control":"absence","root":"/Users/runner/work/_temp/legion-provider-qualification/cargo-audit/absence/source","run":"/Users/runner/work/_temp/legion-provider-qualification/cargo-audit/absence/run","database":"/Users/runner/work/_temp/legion-provider-qualification/cargo-audit/absence/database","databaseSources":{"crates/smallvec/RUSTSEC-2019-0009.md":"sha256:678bd66f3703ac7279a9b9fe4219fbe3903395d8411d899647ee8136d19241c5"},"fixtureSources":{".cargo/audit.toml":"sha256:b0246a1f453f5a3c0cf6ee0435d35a34def185cd18270ecf81c9ba5311e4ea95","Cargo.lock":"sha256:c5715698ef57081530d4a7d85cb5b0baa58aadb45339b618ee2cac20faa93879","Cargo.toml":"sha256:a86b38920681eb24aeb86ffef354d20f3a923e3cafb0f39e76c1a8119ae51c53"},"fixtureLockControl":"absence","matched":true,"invocationScope":"shipped provider argv","inventory":{"schemaVersion":1,"repositoryId":"absence","generation":"filesystem:sha256:b80b9bf73c