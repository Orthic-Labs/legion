        },
        "request-mutation/child.stdout.log": {
          "$ref": "#/$defs/reference"
        },
        "request-mutation/child.stderr.log": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "family",
        "record",
        "stage",
        "scope",
        "sourceClosure",
        "provenance",
        "provenanceVerification"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "enum": [
            "file",
            "shellcheck",
            "scanner",
            "git",
            "extra-scanner",
            "linter",
            "harness-scanner",
            "harness-iac",
            "bench-known-answer",
            "harness-quality",
            "harness-ast-grep",
            "harness-machete",
            "license-checker",
            "cargo-deny",
            "cargo-audit-sdk",
            "visual",
            "opengrep-artifact",
            "osv-artifact",
            "cargo-geiger",
            "secrets-history",
            "pip-audit",
            "semgrep-sdk",
            "harness-rust-outdated",
            "node-outdated",
            "code-sdk",
            "code-long-tail",
            "code-python-sdk",
            "code-php-ruby-sdk",
            "ownership-native",
            "compatibility-report",
            "code-jvm-sdk",
            "code-mobile-sdk",
            "code-c-family-sdk",
            "javascript-sdk",
            "dotnet-sdk",
            "code-rust-sdk",
            "quality-test-native",
            "backend-source-facts",
            "supply-chain-native",
            "runtime-app-sdk",
            "reasoning-runtime"
          ]
        },
        "record": {
          "$ref": "#/$defs/record"
        },
        "stage": {
          "enum": [
            "candidate",
            "finding",
            "fact-output",
            "outcome"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "sourceClosure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sources",
            "digest"
          ],
          "properties": {
            "sources": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/path"
              },
              "additionalProperties": {
                "$ref": "#/$defs/digest"
              }
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "provenance": {
          "oneOf": [
            {
              "$ref": "#/$defs/provenance"
            },
            {
              "$ref": "#/$defs/reasoningProvenance"
            }
          ]
        },
        "provenanceVerification": {
          "$ref": "#/$defs/reference"
        },
        "codeMobileEvidence": {
          "$ref": "#/$defs/codeMobileEvidence"
        },
        "codeSdkEvidence": {
          "$ref": "#/$defs/codeSdkEvidence"
        },
        "phpRubySdkEvidence": {
          "$ref": "#/$defs/phpRubySdkEvidence"
        },
        "pythonSdkEvidence": {
          "$ref": "#/$defs/pythonSdkEvidence"
        },
        "jvmSdkEvidence": {
          "$ref": "#/$defs/jvmSdkEvidence"
        },
        "javascriptSdkEvidence": {
          "$ref": "#/$defs/javascriptSdkEvidence"
        },
        "dotnetSdkEvidence": {
          "$ref": "#/$defs/dotnetSdkEvidence"
        },
        "rustSdkEvidence": {
          "$ref": "#/$defs/rustSdkEvidence"
        },
        "qualityTestEvidence": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/path"
          },
          "additionalProperties": {
            "$ref": "#/$defs/reference"
          },
          "minProperties": 1
        },
        "backendSourceEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nativeStream"
          ],
          "properties": {
            "nativeStream": {
              "$ref": "#/$defs/reference"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "family": {
                "const": "compatibility-report"
              }
            }
          },
          "then": {
            "properties": {
              "provider": {
                "const": "compatibility.core"
              },
              "stage": {
                "const": "fact-output"
              },
              "scope": {
                "const": "native Audit report v1/v2 v1-core preservation; excludes v2-only fields/extensions"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "code-mobile-sdk"
              }
            }
          },
          "then": {
            "required": [
              "codeMobileEvidence"
            ]
          },
          "else": {
            "not": {
              "required": [
                "codeMobileEvidence"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "code-c-family-sdk"
              }
            }
          },
          "then": {
            "properties": {
              "provider": {
                "const": "code.c-family"
              },
              "stage": {
                "const": "finding"
              },
              "scope": {
                "const": "source-bound CMake/Clang C-family operations/v1 known-answer SDK fixtures"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "code-sdk"
              }
            }
          },
          "then": {
            "required": [
              "codeSdkEvidence"
            ]
          },
          "else": {
            "not": {
              "required": [
                "codeSdkEvidence"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "code-php-ruby-sdk"
              }
            }
          },
          "then": {
            "required": [
              "phpRubySdkEvidence"
            ],
            "properties": {
              "provider": {
                "const": "code.php-ruby"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "phpRubySdkEvidence"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "code-python-sdk"
              }
            }
          },
          "then": {
            "required": [
              "pythonSdkEvidence"
            ],
            "properties": {
              "provider": {
                "const": "code.python"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "pythonSdkEvidence"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "code-jvm-sdk"
              }
            }
          },
          "then": {
            "required": [
              "jvmSdkEvidence"
            ],
            "properties": {
              "provider": {
                "const": "code.jvm"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "jvmSdkEvidence"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "javascript-sdk"
              }
            }
          },
          "then": {
            "required": [
              "javascriptSdkEvidence"
            ]
          },
          "else": {
            "not": {
              "required": [
                "javascriptSdkEvidence"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "dotnet-sdk"
              }
            }
          },
          "then": {
            "required": [
              "dotnetSdkEvidence"
            ],
            "properties": {
              "provider": {
                "const": "code.dotnet"
              },
              "stage": {
                "const": "finding"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "dotnetSdkEvidence"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "code-rust-sdk"
              }
            }
          },
          "then": {
            "required": [
              "rustSdkEvidence"
            ],
            "properties": {
              "provider": {
                "const": "code.rust"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "rustSdkEvidence"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "quality-test-native"
              }
            }
          },
          "then": {
            "required": [
              "qualityTestEvidence"
            ],
            "properties": {
              "provider": {
                "const": "legacy.quality.test"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "qualityTestEvidence"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "backend-source-facts"
              }
            }
          },
          "then": {
            "required": [
              "backendSourceEvidence"
            ],
            "properties": {
              "provider": {
                "const": "framework.backend"
              },
              "stage": {
                "const": "fact-output"
              },
              "scope": {
                "const": "exact thirteen named literal backend source-fact controls; runtime, mount composition & auth remain unproven"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "backendSourceEvidence"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "reasoning-runtime"
              }
            }
          },
          "then": {
            "properties": {
              "stage": {
                "const": "finding"
              },
              "scope": {
                "const": "known-answer-fixture-cases"
              },
              "provenance": {
                "$ref": "#/$defs/reasoningProvenance"
              }
            }
          },
          "else": {
            "properties": {
              "provenance": {
                "$ref": "#/$defs/provenance"
              }
            }
          }
        }
      ]
    },
    "provenanceVerification": {
      "description": "Separate source-owned object populated only by maintainers after authenticated GitHub retrieval; never inferred from CI numbers or produced by this checker.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "method",
        "verified",
        "repository",
        "runId",
        "runAttempt",
        "jobId",
        "workflow",
        "commit",
        "platform",
        "jobConclusion",
        "qualificationConclusion",
        "validationBasis",
        "checks",
        "recordSha256",
        "provenanceDigest",
        "logSha256",
        "validatorSha256",
        "sourceClosureDigest",
        "summaryDigest"
      ],
      "properties": {
        "schema": {
          "const": "legion-provider-accuracy-provenance-verification/2"
        },
        "method": {
          "const": "authenticated-github-retrieval"
        },
        "verified": {
          "const": true
        },
        "repository": {
          "const": "Orthic-Labs/legion"
        },
        "runId": {
          "type": "integer",
          "minimum": 1
        },
        "runAttempt": {
          "type": "integer",
          "minimum": 1
        },
        "jobId": {
          "type": "integer",
          "minimum": 1
        },
        "workflow": {
          "const": ".github/workflows/ci.yml"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "platform": {
          "enum": [
            "macos-15",
            "windows-2025"
          ]
        },
        "jobConclusion": {
          "$ref": "#/$defs/jobConclusion"
        },
        "qualificationConclusion": {
          "const": "success"
        },
        "validationBasis": {
          "enum": [
            "native-family-validator",
            "source-owned-harness-success"
          ]
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/terminalCheck"
          }
        },
        "recordSha256": {
          "$ref": "#/$defs/digest"
        },
        "provenanceDigest": {
          "$ref": "#/$defs/digest"
        },
        "logSha256": {
          "$ref": "#/$defs/digest"
        },
        "validatorSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceClosureDigest": {
          "$ref": "#/$defs/digest"
        },
        "summaryDigest": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
