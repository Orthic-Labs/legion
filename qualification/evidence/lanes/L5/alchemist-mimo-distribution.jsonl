eContents.map((entry) => typeof entry === 'string' ? entry : entry.name));\n  const blockers = shipped.flatMap((component) => {\n    const missing = [];\n    if (!content.has(component.name)) missing.push({ kind: 'shipped-component-absent', component: component.name });\n    if (!component.digest || !component.license || !component.source) missing.push({ kind: 'component-metadata-incomplete', component: component.name });\n    return missing;\n  });\n  return { components: shipped, blockers, decision: blockers.length ? 'BLOCKED' : 'QUALIFIED' };\n}\n```\n\nTo:\n```js\nexport function reconcileDistributionContents(components = [], packageContents = []) {\n  const shipped = components.filter(({ shipped }) => shipped);\n  const content = new Set(packageContents.map((entry) => typeof entry === 'string' ? entry : entry.name));\n  const inPackage = (component) => content.has(component.name) || [...content].some((entry) => entry.startsWith(component.name + '/'));\n  const blockers = shipped.flatMap((component) => {\n    const missing = [];\n    if (!inPackage(component)) missing.push({ kind: 'shipped-component-absent', component: component.name });\n    if (!component.digest || !component.license || !component.source || !component.version) missing.push({ kind: 'component-metadata-incomplete', component: component.name });\n    return missing;\n  });\n  return { components: shipped, blockers, decision: blockers.length ? 'BLOCKED' : 'QUALIFIED' };\n}\n```\n\n### Edit 2: release-manifest.mjs - validate channel id, platform, semantic equivalent\n\nIn `buildReleaseManifest`, add validation after the `if (!root || !version || !sourceRevision)` check:\n```js\nfor (const artifact of artifacts ?? []) {\n  if (artifact.type === 'native' && !artifact.platform) throw new Error(`native artifact ${artifact.path} must specify a platform`);\n  if (artifact.semanticEquivalent === false) throw new Error(`artifact ${artifact.path} has semanticEquivalent=false and cannot be released`);\n}\nfor (const channel of channels ?? []) {\n  if (!channel.id) throw new Error('channel must have an id');\n}\n```\n\nWait, but this adds throw conditions to the builder. The acceptance says the verifier should reject gaps. The builder throwing is a stricter check. Let me think about whether the builder should throw or just include the information for the verifier to catch.\n\nThe release manifest builder is what creates the manifest. If a native artifact has no platform, the builder should fail early rather than creating a manifest that the verifier would reject. This is defensive and correct.\n\nBut `semanticEquivalent === false` might be intentional for some artifacts (e.g., a native binary that's not semantically equivalent to the JS version). The builder shouldn't necessarily reject this, but the verifier should flag it. Let me leave the semantic equivalent check to the verifier only.\n\nFor the channel id: the builder creates channel records with id. If the input channel doesn't have an id, it would be undefined in the output. The verifier should catch this. Let me add the id check to the builder too.\n\nActually, looking at the builder code more carefully:\n```js\nchannels: channels.map((channel) => ({ ...channel, decision: channel.decision ?? 'BLOCKED', ... })),\n```\n\nIf channel.id is missing, it would be undefined in the output. The verifier then uses `channel.id ?? 'channel'` as the artifact name in issues, which handles the undefined case. So the verifier is already resilient to missing ids.\n\nBut the acceptance criteria says the manifest should bind every referenced byte. If a channel has no id, it's not properly identified. Let me add validation in the builder.\n\nActually, the acceptance criteria specifically says \"Release manifest binds every referenced byte & verifier rejects missing/null/digest/signature/notarization/version/platform/equivalence/channel gaps.\" The binding is about the builder, the rejection is about the verifier. The builder should ensure all bytes are bound (have digests). The verifier should reject other gaps.\n\nLet me focus on the verifier gaps instead of adding builder validation, since the builder already binds bytes (artifacts have digests).\n\n### Edit 3: verify-release.mjs - channel path matching, signature status, notarization status\n\n1. Fix channel check to verify path-level matching:\n```js\n// Instead of:\nfor (const channel of manifest.channels ?? []) if ((channel.artifacts ?? []).length !== (manifest.artifacts ?? []).length) issues.push(...)\n\n// Do:\nfor (const channel of manifest.channels ?? []) {\n  const channelPaths = new Set((channel.artifacts ?? []).map((a) => a.path));\n  for (const artifact of manifest.artifacts ?? []) {\n    if (!channelPaths.has(artifact.path)) issues.push({ artifact: channel.id ?? 'channel', issue: 'artifact-decision-missing' });\n    break; // Only report once per channel }\n}\n```\n\nWait, this would report one issue per channel with missing artifacts. But the original code reports one issue per channel too. Let me keep it simple:\n\n```js\nfor (const channel of manifest.channels ?? []) {\n  const channelPaths = new Set((channel.artifacts ?? []).map((a) => a.path));\n  const missing = (manifest.artifacts ?? []).some((a) => !channelPaths.has(a.path));\n  if (missing || (channel.artifacts ?? []).length !== (manifest.artifacts ?? []).length) issues.push({ artifact: channel.id ?? 'channel', issue: 'artifact-decision-missing' });\n}\n```\n\n2. Fix signature status check:\n```js\n// Instead of:\nfor (const signature of manifest.signatures ?? []) if (!signature.digest || ['placeholder', 'missing'].includes(signature.status)) issues.push(...)\n\n// Do:\nfor (const signature of manifest.signatures ?? []) if (!signature.digest || !signature.status || ['placeholder', 'missing'].includes(signature.status)) issues.push(...)\n```\n\nWait, `!signature.status` would catch undefined, null, empty string, and 0. That's correct.\n\n3. Add notarization status check: