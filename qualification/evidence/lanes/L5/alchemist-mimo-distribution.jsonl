{"type":"item.completed","item":{"id":"item_62","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"Get-Content \\\"D:\\\\Claude\\\\tools\\\\skills\\\\nemesis\\\\scripts\\\\verify-source-provenance.mjs\\\" -Raw\"","aggregated_output":"#!/usr/bin/env node\r\n// Rights evidence is fail-closed: absent grants or digest mismatches block\r\n// distribution and never become an inferred redistribution right.\r\n\r\nimport { existsSync, readFileSync, writeFileSync } from 'node:fs';\nimport { resolve } from 'node:path';\r\nimport { fileURLToPath } from 'node:url';\r\nimport { fileDigest } from '../lib/distribution/release-manifest.mjs';\r\n\r\nconst root = resolve(fileURLToPath(new URL('..', import.meta.url)));\r\n\r\nexport function verifySourceProvenance(manifest, { verifyFiles = true } = {}) {\n  const sources = manifest?.sources ?? [];\r\n  const blockers = [];\r\n  for (const source of sources) {\n    const digestPattern = /^sha256:[0-9a-f]{64}$/i;\n    if (!source.id || !source.status || !source.digest) blockers.push({ kind: 'source-record-incomplete', source: source.id ?? null });\n    if (!digestPattern.test(source.digest ?? '') || !digestPattern.test(source.outputDigest ?? '')) blockers.push({ kind: 'source-digest-unresolved', source: source.id ?? null });\n    if (source.shipped && source.redistributionGrant !== true) blockers.push({ kind: 'redistribution-right-unresolved', source: source.id });\n    if (!source.outputDigest) blockers.push({ kind: 'transformation-manifest-incomplete', source: source.id });\n    if (!Array.isArray(source.transformations) || !source.transformations.length) blockers.push({ kind: 'transformation-manifest-incomplete', source: source.id });\n    if (source.promptProseShipped === true) blockers.push({ kind: 'creator-prompt-prose-shipped', source: source.id });\n    if (['designer', 'writing'].includes(source.id) && source.userOwned !== true) blockers.push({ kind: 'source-ownership-unattested', source: source.id });\n    if (!Array.isArray(source.categoryMappings) || !source.categoryMappings.length || source.originalRuleOwnership !== 'repository-original' || !Array.isArray(source.shippedOutputs)) blockers.push({ kind: 'transformation-proof-incomplete', source: source.id });\n    if (verifyFiles && source.path && fileDigest(resolve(root, source.path)) !== source.digest) blockers.push({ kind: 'source-digest-mismatch', source: source.id });\n  }\r\n  if (!sources.length) blockers.push({ kind: 'source-provenance-absent' });\r\n  return { schemaVersion: 1, kind: 'nemesis-source-provenance-qualification', decision: blockers.length ? 'BLOCKED' : 'QUALIFIED', blockers, sources: sources.map(({ path, ...source }) => source) };\r\n}\n\nexport function writeSourceProvenanceQualification(manifest, outputPath, options = {}) {\n  if (!outputPath) throw new Error('outputPath is required');\n  const result = verifySourceProvenance(manifest, options);\n  writeFileSync(resolve(outputPath), `${JSON.stringify(result, null, 2)}\\n`, 'utf8');\n  return result;\n}\n\r\nif (import.meta.url === new URL(`file://${process.argv[1]}`).href) {\r\n  const input = resolve(root, process.argv[2] ?? 'references/source-provenance/creator-skills.json');\n  const result = existsSync(input) ? verifySourceProvenance(JSON.parse(readFileSync(input, 'utf8'))) : verifySourceProvenance(null);\n  const outIndex = process.argv.indexOf('--out');\n  if (outIndex >= 0) writeFileSync(resolve(process.argv[outIndex + 1]), `${JSON.stringify(result, null, 2)}\\n`, 'utf8');\n  console.log(JSON.stringify(result));\n  process.exit(result.decision === 'QUALIFIED' ? 0 : 1);\r\n}\r\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"Get-Content \\\"D:\\\\Claude\\\\tools\\\\skills\\\\nemesis\\\\lib\\\\distribution\\\\sbom.mjs\\\" -Raw\"","aggregated_output":"import { fileDigest } from './release-manifest.mjs';\r\n\r\nexport function cyclonedxSbom({ components = [], serialNumber = null } = {}) {\r\n  const normalized = components.map((component) => ({\r\n    type: component.type ?? 'library', name: component.name, version: component.version,\r\n    licenses: component.license ? [{ license: { id: component.license } }] : [],\r\n    hashes: component.path && fileDigest(component.path) ? [{ alg: 'SHA-256', content: fileDigest(component.path).slice(7) }] : [],\r\n  }));\r\n  if (!normalized.length) throw new Error('SBOM cannot be empty');\r\n  return { bomFormat: 'CycloneDX', specVersion: '1.5', serialNumber, version: 1, components: normalized };\r\n}\r\n\r\nexport function spdxSbom({ name, components = [] } = {}) {\n  if (!name || !components.length) throw new Error('SPDX SBOM needs a package name and components');\r\n  return { SPDXID: 'SPDXRef-DOCUMENT', spdxVersion: 'SPDX-2.3', name, dataLicense: 'CC0-1.0', packages: components };\r\n}\n\nexport function generateSboms({ name, components = [], serialNumber = null } = {}) {\n  return { cyclonedx: cyclonedxSbom({ components, serialNumber }), spdx: spdxSbom({ name, components }) };\n}\n\nexport function inventoryRuntimeDependencies({ packageManifest = {}, provenance = {} } = {}) {\n  return Object.entries(packageManifest.dependencies ?? {}).sort(([a], [b]) => a.localeCompare(b)).map(([name, version]) => ({\n    type: 'library', name, version, source: provenance[name]?.source ?? 'npm', digest: provenance[name]?.digest ?? null,\n    license: provenance[name]?.license ?? null, shipped: true, distributionStatus: provenance[name]?.distributionStatus ?? 'integrated',\n  }));\n}\n\nexport function inventoryDistribution({ runtime = [], externalTools = [], grammars = [], ruleMaterial = [], creatorMaterial = [] } = {}) {\n  return [...runtime, ...externalTools, ...grammars, ...ruleMaterial, ...creatorMaterial]\n    .map((component) => ({\n      type: component.type ?? 'library', name: component.name, version: component.version ?? null,\n      source: component.source ?? null, digest: component.digest ?? null, license: component.license ?? null,\n      shipped: component.shipped === true, distributionStatus: component.distributionStatus ?? 'reference-only',\n    }))\n    .sort((a, b) => `${a.type}:${a.name}`.localeCompare(`${b.type}:${b.name}`));\n}\n\nexport function reconcileDistributionContents(components = [], packageContents = []) {\n  const shipped = components.filter(({ shipped }) => shipped);\n  const content = new Set(packageContents.map((entry) => typeof entry === 'string' ? entry : entry.name));\n  const blockers = shipped.flatMap((component) => {\n    const missing = [];\n    if (!content.has(component.name)) missing.push({ kind: 'shipped-component-absent', component: component.name });\n    if (!component.digest || !component.license || !component.source) missing.push({ kind: 'component-metadata-incomplete', component: component.name });\n    return missing;\n  });\n  return { components: shipped, blockers, decision: blockers.length ? 'BLOCKED' : 'QUALIFIED' };\n}\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_64","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"Get-Content \\\"D:\\\\Claude\\\\tools\\\\skills\\\\nemesis\\\\scripts\\\\verify-release.mjs\\\" -Raw\"","aggregated_output":"#!/usr/bin/env node\r\n// Release artifact verification per PR43. Validates checksums, SBOMs, notices,\r\n// signature manifests, and attestation references in a release manifest.\r\n\r\nimport { existsSync, readFileSync } from 'node:fs';\r\nimport { relative, resolve, sep } from 'node:path';\r\nimport { fileDigest } from '../lib/distribution/release-manifest.mjs';\r\n\r\nexport function sha256File(path) {\r\n  return fileDigest(path);\r\n}\r\n\r\nfunction resolvedArtifact(root, path) {\r\n  if (typeof path !== 'string' || !path || path.includes('\\0')) return null;\r\n  const absolute = resolve(root, path);\r\n  const rel = relative(root, absolute);\r\n  return rel && rel !== '..' && !rel.startsWith(`..${sep}`) ? absolute : null;\r\n}\r\n\r\nfunction verifyReferenced(root, entries, type, issues) {\r\n  for (const entry of entries ?? []) {\r\n    const record = typeof entry === 'string' ? { path: entry } : entry;\r\n    const path = resolvedArtifact(root, record.path);\r\n    if (!path || !existsSync(path)) issues.push({ artifact: record.path ?? type, issue: 'missing' });\n    else if (!record.digest) issues.push({ artifact: record.path, issue: 'digest-missing' });\n    else if (sha256File(path) !== record.digest) issues.push({ artifact: record.path, issue: 'digest-mismatch' });\n  }\r\n}\r\n\r\nexport function verifyReleaseManifest(manifestPath, { distDir = null } = {}) {\n  const manifest = JSON.parse(readFileSync(resolve(manifestPath), 'utf8'));\n  return verifyReleaseManifestObject(manifest, { root: resolve(distDir ?? resolve(resolve(manifestPath), '..')), manifestPath });\n}\n\nexport function verifyReleaseManifestObject(manifest, { root, manifestPath = null } = {}) {\n  if (manifest.schemaVersion !== 1 || manifest.kind !== 'nemesis-release-manifest') {\r\n    throw new Error('release manifest must be nemesis-release-manifest schemaVersion=1');\r\n  }\r\n  const dir = resolve(root);\n  const issues = [];\r\n  for (const entry of manifest.artifacts ?? []) {\r\n    const path = resolvedArtifact(dir, entry.path);\r\n    if (!path) { issues.push({ artifact: entry.path, issue: 'path-escape' }); continue; }\r\n    const observed = sha256File(path);\r\n    if (observed === null) {\r\n      issues.push({ artifact: entry.path, issue: 'missing' });\r\n    } else if (observed !== entry.digest) {\r\n      issues.push({ artifact: entry.path, issue: 'digest-mismatch' });\r\n    }\r\n  }\r\n  for (const [field, label] of [['checksums', 'SHA256SUMS'], ['sboms', 'SBOM'], ['notices', 'THIRD_PARTY_NOTICES'], ['signatures', 'signature'], ['notarization', 'notarization'], ['qualificationArtifacts', 'qualification']]) {\n    if (!(manifest[field] ?? []).length) issues.push({ artifact: label, issue: 'missing' });\r\n    else verifyReferenced(dir, manifest[field], label, issues);\r\n  }\n  for (const entry of manifest.sboms ?? []) {\n    const path = resolvedArtifact(dir, entry.path);\n    if (path && existsSync(path)) {\n      try { const value = JSON.parse(readFileSync(path, 'utf8')); if (!(value.components ?? value.packages ?? []).length) issues.push({ artifact: entry.path, issue: 'empty-sbom' }); }\n      catch { issues.push({ artifact: entry.path, issue: 'invalid-sbom' }); }\n    }\n  }\n  for (const signature of manifest.signatures ?? []) if (!signature.digest || ['placeholder', 'missing'].includes(signature.status)) issues.push({ artifact: signature.path ?? 'signature', issue: 'placeholder-signature' });\n  for (const artifact of manifest.artifacts ?? []) {\n    if (artifact.type === 'native' && !artifact.platform) issues.push({ artifact: artifact.path, issue: 'platform-missing' });\n    if (artifact.semanticEquivalent === false) issues.push({ artifact: artifact.path, issue: 'semantic-equivalence-failed' });\n  }\n  for (const channel of manifest.channels ?? []) if ((channel.artifacts ?? []).length !== (manifest.artifacts ?? []).length) issues.push({ artifact: channel.id ?? 'channel', issue: 'artifact-decision-missing' });\n  if (!manifest.version || !manifest.sourceRevision) issues.push({ artifact: 'manifest', issue: 'identity-missing' });\r\n  return {\r\n    schemaVersion: 1,\r\n    kind: 'nemesis-release-verification',\r\n    manifest: manifestPath ? resolve(manifestPath) : null,\n    valid: issues.length === 0,\r\n    issues,\r\n  };\r\n}\r\n\r\nif (process.argv[1] && process.argv[1].endsWith('verify-release.mjs')) {\r\n  const [manifestPath] = process.argv.slice(2);\r\n  if (!manifestPath) {\r\n    console.error('usage: verify-release.mjs <release-manifest.json>');\r\n    process.exit(4);\r\n  }\r\n  try {\r\n    const result = verifyReleaseManifest(manifestPath);\r\n    console.log(JSON.stringify(result, null, 2));\r\n    process.exit(result.valid ? 0 : 1);\r\n  } catch (error) {\r\n    console.error(error.message);\r\n    process.exit(2);\r\n  }\r\n}\r\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_61","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"Get-Content \\\"D:\\\\Claude\\\\tools\\\\skills\\\\nemesis\\\\lib\\\\distribution\\\\claims.mjs\\\" -Raw\"","aggregated_output":"const STATES = new Set(['deterministic-measured', 'interpretive-measured', 'experimental', 'unproven', 'unavailable']);\r\n\r\nexport function generateClaims(qualifications = []) {\n  return qualifications.map((item) => {\r\n    const state = item.state ?? 'unproven';\r\n    if (!STATES.has(state)) throw new Error(`unknown claim state: ${state}`);\r\n    const identity = { artifactDigest: item.artifactDigest, corpusDigest: item.corpusDigest, providerDigest: item.providerDigest };\n    const expected = item.expectedIdentity ?? null;\n    const qualified = Boolean(expected && identity.artifactDigest && identity.corpusDigest && identity.providerDigest && Object.keys(identity).every((key) => identity[key] === expected[key]));\n    return {\r\n      id: item.id,\r\n      subject: item.subject,\r\n      state: qualified ? state : 'unproven',\r\n      qualification: qualified ? identity : null,\n      limitations: item.limitations ?? (qualified ? [] : ['qualification identity incomplete']),\n      hostCapabilities: item.hostCapabilities ?? [],\n      resourceConstraints: item.resourceConstraints ?? {},\n      reasoningRequirements: item.reasoningRequirements ?? [],\n      authorityLimits: item.authorityLimits ?? [],\n    };\n  });\n}\n\nexport function renderSupportMarkdown(claims = []) {\n  return `# Generated support claims\\n\\n${claims.map((claim) => `- **${claim.subject ?? claim.id}** — ${claim.state}${claim.limitations.length ? `; limitations: ${claim.limitations.join(', ')}` : ''}`).join('\\n')}\\n`;\n}\n\nexport function generateClaimsFromQualification(qualification, expectedIdentity) {\n  const records = qualification?.claims ?? qualification?.features ?? [];\n  return {\n    schemaVersion: 1,\n    kind: 'nemesis-generated-claims',\n    qualificationIdentity: expectedIdentity ?? null,\n    claims: generateClaims(records.map((record) => ({ ...record, expectedIdentity }))),\n    knownGaps: expectedIdentity ? [] : ['exact qualification identity is absent'],\n  };\n}\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_65","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"Get-Content \\\"D:\\\\Claude\\\\tools\\\\skills\\\\nemesis\\\\THIRD_PARTY_NOTICES.md\\\" -Raw\"","aggregated_output":"# Third-party notices\r\n\r\nNemesis is built from and integrates third-party software and rule material.\r\nThis inventory is populated only with **actual** dependencies, rules, and\r\nintegrated engines that ship in or are executed by the product.\r\n\r\nThe current source-use license and the licenses of every integrated engine,\r\nparser grammar, and rule set must be reviewed together before any public\r\npackage or community SDK release. No legal terms are changed by this\r\nengineering inventory.\r\n\r\n## Runtime dependencies\r\n\r\nThe canonical package manifest (`@orthic-labs/nemesis`, PR05) declares no\r\nruntime dependencies yet; every future dependency must be listed here with its\r\nlicense and provenance before release.\r\n\r\n## Integrated engines and rule material\r\n\r\nNo external engine binary, parser grammar, or creator prompt archive is shipped\nin the current package. Optional executables invoked from a host installation\nare excluded from this shipped-content notice & remain tracked by generated\ndistribution inventory. Rule packs under `registry/rules/` are original Nemesis\nmaterial.\n\r\n## Rule packs and fixtures\r\n\r\nThe benchmark fixture corpus (`bench/fixtures/`) is original Nemesis material.\r\nAny rule text, grammar, or methodology adapted from an external project\r\n(including OpenGrep, ast-grep, Semgrep, CodeQL, and Decepticon concepts) must\r\nbe listed here with its license and attribution before it ships.\r\n\r\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_66","type":"reasoning","text":"Now I have a clear picture of all the files. Let me identify the remaining acceptance gaps against the criteria:\n\n**Acceptance Criteria Review:**\n\n1. **SBOM/notices inventory shipped content & reconcile package contents; unresolved rights block.**\n   - `inventoryDistribution` doesn't pass through `redistributionGrant` → `buildNoticeInventory` checks for it but it's always `undefined`. This is a gap: the rights field must flow through inventory.\n   - `reconcileDistributionContents` checks for `digest`, `license`, `source` but doesn't check `redistributionGrant` for shipped external components. The notices path (`buildNoticeInventory`) does check it, but the SBOM reconciliation doesn't validate rights completeness.\n\n2. **Release manifest binds every referenced byte & verifier rejects missing/null/digest/signature/notarization/version/platform/equivalence/channel gaps.**\n   - In `verify-release.mjs`, the signature check: `!signature.digest || ['placeholder', 'missing'].includes(signature.status)` — if `signature.status` is null, `['placeholder','missing'].includes(null)` is false, so null-status signatures pass. This is a gap.\n   - Notarization entries: no individual null-digest check in `verifyReferenced` beyond the digest-missing check. That's handled already by the `!record.digest` branch.\n   - Artifact entry null digest: when `artifact.digest` is null and the file exists, `observed !== null` and `null !== null` is false, so it doesn't catch the null-digest case. The `observed === entry.digest` would be `null === null` which is true, so null digest passes! This is a gap - must reject null artifact digests.\n   - The channel check only verifies artifact count, not that each channel artifact has a decision set.\n\n3. **Claims derive from exact qualification identity & downgrade mismatches.**\n   - `generateClaims`: when `expected` is set but identity doesn't match, the limitation defaults to `['qualification identity incomplete']`. But when `expected` exists and identity differs, it should say `['qualification identity mismatch']` to distinguish \"incomplete\" from \"mismatched\". The current code treats both cases identically.\n   - `generateClaimsFromQualification`: when `expectedIdentity` is null, `knownGaps` says \"exact qualification identity is absent\". This is correct.\n   - `claims.json`: has `knownGaps: [\"final qualification, provider, corpus, skill, and artifact digests are absent\"]` - this is a more specific description of what's absent vs the code's generic \"exact qualification identity is absent\". The generated claims.json should be consistent with what the code would produce.\n   - Actually, looking more carefully: `claims.json` is a static file that represents the current actual state. The `knownGaps` there reads \"final qualification, provider, corpus, skill, and artifact digests are absent\" which is a specific description. But the code's `generateClaimsFromQualification` with null expectedIdentity produces \"exact qualification identity is absent\". These are inconsistent - the claims.json was manually written with more specific text, while the code produces a generic message. The generated output should match what the code generates.\n\n4. **Creator provenance verifies archive/output digests, category mappings, originality, shipped outputs, ownership, transformations, & writes qualification only when explicitly requested.**\n   - `verify-source-provenance.mjs`: the `writeSourceProvenanceQualification` function writes unconditionally when called, but only when explicitly requested via `--out` in the CLI. That seems correct.\n   - `creator-skills.json`: both sources have `shipped: false`, `redistributionGrant: false`, `categoryMappings: []`, `originalRuleOwnership: \"unverified\"`, `shippedOutputs: []`. The `originalRuleOwnership` being \"unverified\" is checked against `'repository-original'` in the verifier. That's correct - it will produce a blocker.\n   - The `shippedOutputs` is an empty array `[]` - `Array.isArray(source.shippedOutputs)` is true, so that check passes. But maybe shippedOutputs should be validated as non-empty for shipped sources? Since these aren't shipped, it's fine.\n   - `categoryMappings: []` — `Array.isArray(source.categoryMappings) && source.categoryMappings.length` → this is false (empty array), so it produces a blocker. That's correct.\n   - Wait, for non-shipped sources, do we need originalRuleOwnership and categoryMappings validation? The current code always checks them regardless of shipping status. That seems overly strict for reference-only sources. But the acceptance criteria says \"Creator provenance verifies archive/output digests, category mappings, originality, shipped outputs, ownership, transformations\" — it's listed as universal verification, not conditional on shipping. So the current behavior is correct per acceptance criteria.\n\nNow let me list the concrete gaps I've found:\n\n### Gap 1: `inventoryDistribution` drops `redistributionGrant` \n**File:** `lib/distribution/sbom.mjs`  \n**Fix:** Add `redistributionGrant: component.redistributionGrant ?? null` to the map in `inventoryDistribution`. Without this, `buildNoticeInventory` in notices.mjs always sees `undefined` for the redistributionGrant field, making rights checks for shipped external components always block.\n\n### Gap 2: `verify-release.mjs` null-status signature passes\n**File:** `scripts/verify-release.mjs`  \n**Fix:** Change the signature check from `['placeholder', 'missing'].includes(signature.status)` to also reject null/undefined status. A signature with no status is not a real signature.\n\n### Gap 3: `verify-release.mjs` null artifact digest passes\n**File:** `scripts/verify-release.mjs`  \n**Fix:** After the `observed === null` (file missing) check, add a check for `entry.digest === null` (file exists but no binding). Currently if digest is null and file exists, `observed !== null` is true and `null !== null` is false so it passes the mismatch check — it should be flagged.\n\n### Gap 4: `generateClaims` mismatch limitation message\n**File:** `lib/distribution/claims.mjs`  \n**Fix:** When `expected` exists but identity doesn't fully match, use `'qualification identity mismatch'` instead of `'qualification identity incomplete'`. This distinguishes \"no expected identity set\" from \"expected identity set but digests don't match\".\n\n### Gap 5: `verify-release.mjs` artifact null version/notarization/version not checked\n**File:** `scripts/verify-release.mjs`  \nActually looking again at the acceptance criteria: \"verifier rejects missing/null/digest/signature/notarization/version/platform/equivalence/channel gaps\". Let me check what's covered:\n- missing: ✓ (via file checks)\n- null digest: ✗ (gap 3)\n- signature: ✓ mostly (gap 2 for null status)\n- notarization: covered by `verifyReferenced` digest check\n- version: manifest version is checked. Artifact version is not checked. But the schema doesn't require artifact version.\n- platform: ✓ (native platform check)\n- equivalence: ✓ (semanticEquivalent check)\n- channel: ✓ (artifact count check)\n\nWait, also: for the signature check, the current code is:\n```js\nif (!signature.digest || ['placeholder', 'missing'].includes(signature.status)) issues.push(...)\n```\nIf `signature.digest` is `null`, `!null` is true, so it catches null digests. Good.\nBut if `signature.digest` is present and `signature.status` is `null`, then `['placeholder', 'missing'].includes(null)` is false, so it passes. This is a gap.\n\nAlso for notarization: `verifyReferenced` checks `!record.digest` (catches null) and digest mismatch. But it doesn't check for a null status field like signatures do. Should it? The acceptance criteria says \"notarization\" gaps should be rejected. Let me check if there's a `status` field on notarization entries... Looking at the code, the `verifyReferenced` function only checks digest, not status. For signatures, there's a separate check for status. Notarization should probably also check for null/placeholder status.\n\n### Gap 5 (revised): `verify-release.mjs` notarization null/placeholder status not checked\n**File:** `scripts/verify-release.mjs`  \n**Fix:** Add a check for notarization entries with null or placeholder status, similar to the signature check.\n\n### Gap 6: `claims.json` knownGaps inconsistent with code output\n**File:** `references/generated/claims.json`  \nThe file has `\"knownGaps\": [\"final qualification, provider, corpus, skill, and artifact digests are absent\"]` but the code produces `\"knownGaps\": [\"exact qualification identity is absent\"]`. The claims.json is a generated artifact. Since we can't run the generator, the claims.json should reflect what the code would actually produce. But actually, the claims.json is a static snapshot — it was likely hand-written to describe the actual current state. The code's generic message is less informative. However, the acceptance criteria says \"Claims derive from exact qualification identity & downgrade mismatches.\" The claims.json file should be consistent with what the code generates.\n\nActually, I need to be more careful here. The `claims.json` is under `references/generated/` — this is a generated file that gets regenerated by the pipeline. It could have been manually tweaked. But the acceptance criteria says claims should \"derive from exact qualification identity.\" The generated file's `knownGaps` should match what the code outputs. Since the code says `\"exact qualification identity is absent\"`, the file should say the same.\n\nBut wait — the task says \"Find remaining acceptance gaps & make smallest corrections, max 180 changed lines.\" And the non-goals say \"Preserve unrelated dirt.\" The claims.json is a static generated file that gets regenerated by the pipeline. Should I update it? It's in the list of allowed files. Let me check: the generated claims.json has `\"qualificationIdentity\": null` and `\"knownGaps\": [\"final qualification, provider, corpus, skill, and artifact digests are absent\"]`. The code `generateClaimsFromQualification(null, null)` would produce `\"knownGaps\": [\"exact qualification identity is absent\"]`. The description in the generated file is more specific, which is fine, but it's inconsistent with the code. I should make it match.\n\nActually, let me reconsider. The `knownGaps` in claims.json is a descriptive field that records what's missing. The code just produces a generic string. The actual artifact could be produced by a richer pipeline that provides more detail. The question is whether the *consistency* between the code output and the generated artifact matters for acceptance.\n\nLooking at the acceptance criteria: \"Claims derive from exact qualification identity & downgrade mismatches.\" The key is that claims derive from the qualification identity (checked by `generateClaims`) and downgrade when mismatches occur (the `qualified ? state : 'unproven'` logic). The `knownGaps` is supplementary metadata. I think making the generated file match the code is the safest small fix, but I need to weigh it against other higher-impact fixes.\n\nLet me prioritize by acceptance gap impact:\n\n1. **sbom.mjs redistributionGrant passthrough** — HIGH: Without this, rights checks in notices always fail for external components. Directly affects \"unresolved rights block\" criterion.\n\n2. **verify-release.mjs null artifact digest** — HIGH: Without this, an artifact with no digest binding passes verification, violating \"release manifest binds every referenced byte.\"\n\n3. **verify-release.mjs null-status signature** — HIGH: A signature without a valid status passes verification.\n\n4. **verify-release.mjs notarization status check** — MEDIUM: Notarization entries with null status aren't caught.\n\n5. **claims.mjs mismatch vs incomplete limitation** — MEDIUM: Distinguishes between \"no identity expected\" and \"identity expected but doesn't match.\" Directly relates to \"downgrade mismatches.\"\n\n6. **claims.json knownGaps wording** — LOW: Static generated file, but should match code output for consistency.\n\nThat's 6 changes, well under 180 lines. Let me now also check if there's a missing null/artifact version check in verify-release.mjs per the criteria \"rejects missing/null/digest/signature/notarization/version/platform/equivalence/channel gaps.\"\n\nThe \"version\" gap: the manifest has a version field that's already checked (`!manifest.version`). Artifact-level version isn't in the schema as required. So that's fine.\n\nLet me finalize the changes:\n\n**sbom.mjs:** Add `redistributionGrant` passthrough in `inventoryDistribution` map (+1 line)\n\n**verify-release.mjs:** \n- Reject null artifact digests (+2 lines)\n- Reject null-status signatures (+1 line change)  \n- Reject null/placeholder notarization status (+2 lines)\n\n**claims.mjs:**\n- Distinguish mismatch from incomplete (+2 lines change)\n\n**claims.json:**\n- Update knownGaps to match code output (change the string, +0 net lines)\n\n**support.md:** \n- Update to match code's renderSupportMarkdown output consistency\n\nTotal: ~10 lines changed. Well within 180.\n\nLet me now apply all patches."}}
