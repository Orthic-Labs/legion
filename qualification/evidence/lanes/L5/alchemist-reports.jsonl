{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"Get-Content \\\"D:\\\\Claude\\\\nemesis\\\\lib\\\\report\\\\model.mjs\\\" -Raw\"","aggregated_output":"/**\n * @fileoverview Canonical report model for Nemesis (B1-019).\n *\n * This module builds the canonical `report.json` — the single source\n * of truth for a completed audit run.  All other formats and agent\n * tools consume this artifact.\n *\n * The report model:\n *\n *  1. Consumes product portfolio, component/stack/external-system graphs,\n *     release contract, product context, control baseline, evidence\n *     capabilities, scenarios, reconciled facts, validated adjudication,\n *     variants, policy, and artifact manifest.\n *  2. Materializes final findings only from authorized provider roles or\n *     completed candidate lifecycles.\n *  3. Materializes control states only from complete mapped evidence\n *     requirements.\n *  4. Groups systemic root causes while preserving each target, control,\n *     family, finding, gap, scenario, and evidence chain.\n *  5. Computes per-target inventory/source/runtime/product/release claim\n *     decisions plus aggregate product status, policy, integrity,\n *     completeness, and exit code.\n *\n * Forbidden: Do not compute a universal repository score.\n * Do not use family completion as substitute for control completion.\n */\n\nimport {\n  IntegrityFailure,\n  IncompleteEvidence,\n  InternalError,\n  PolicyFailure,\n} from '../errors.mjs';\nimport { computeDigest, computeDigestId, digestsEqual } from '../artifacts/digests.mjs';\nimport { SCHEMA_VERSION, PRODUCER, VERSION } from '../version.mjs';\nimport {\n  CLAIM_LEVEL_HIERARCHY,\n  CLAIM_DECISION_STATUS,\n  createClaimDecision,\n  computeAchievedLevel,\n  computeOverallStatus,\n  claimLevelAtOrAbove,\n} from '../core/claim-levels.mjs';\nimport { ROLE_OUTPUT_AUTHORITY } from '../providers/sdk/dag.mjs';\n\n/**\n * The schema version for the canonical report.\n */\nexport const REPORT_SCHEMA_VERSION = SCHEMA_VERSION;\n\n/**\n * The kind value for the canonical report.\n */\nexport const REPORT_KIND = 'nemesis-report';\n\n/**\n * CLI exit codes.\n */\nexport const EXIT_CODES = Object.freeze({\n  PASS: 0,\n  USAGE: 1,\n  INCOMPLETE: 2,\n  FAIL: 3,\n  INTEGRITY: 4,\n  INTERNAL: 5,\n});\n\n/**\n * Build the canonical report from all run inputs.\n *\n * @param {object} input\n * @param {object} input.plan               Sealed plan.\n * @param {object} input.facts              Reconciled facts from reconcileRun.\n * @param {object} [input.adjudication]      Adjudication result from adjudicateRun.\n * @param {object|null} [input.productPortfolio]  Product portfolio (targets, components, stacks).\n * @param {object|null} [input.controlBaseline]   Selected control baseline (SNIP-27).\n * @param {object|null} [input.releaseContract]    Release contract.\n * @param {object|null} [input.evidenceCapabilities] Evidence capabilities.\n * @param {object|null} [input.scenarioMatrices]   Scenario matrices.\n * @param {object|null} [input.artifactManifest]   Run manifest from RunStore.\n * @param {object} [input.policy]            Run policy.\n * @param {object} [input.host]              Injected host.\n * @returns {Readonly<object>} Canonical report.\n */\nexport function buildReport(input) {\n  const {\n    plan,\n    facts,\n    adjudication = null,\n    productPortfolio = null,\n    controlBaseline = null,\n    releaseContract = null,\n    evidenceCapabilities = null,\n    scenarioMatrices = null,\n    artifactManifest = null,\n    policy = {},\n    host = null,\n  } = input;\n\n  if (!plan) {\n    throw new IntegrityFailure('buildReport: plan is required', {\n      code: 'E_REPORT_NO_PLAN', context: {},\n    });\n  }\n  if (!facts) {\n    throw new IntegrityFailure('buildReport: facts are required', {\n      code: 'E_REPORT_NO_FACTS', context: {},\n    });\n  }\n\n  const requestedLevel = plan.claimLevel ?? facts.requestedLevel ?? 'inventory';\n  const achievedLevel = facts.achievedLevel ?? null;\n  const overallStatus = facts.status ?? 'INCOMPLETE';\n  const binding = plan.binding ?? {};\n\n  // ── 1. Materialize findings ──\n  const findings = _materializeFindings(facts, adjudication);\n\n  // ── 2. Materialize control states ──\n  const controlStates = _materializeControlStates(facts, controlBaseline);\n\n  // ── 3. Compute per-target claim decisions ──\n  const targets = _computeTargetDecisions(\n    productPortfolio,\n    facts,\n    findings,\n    requestedLevel,\n    binding,\n  );\n\n  // ── 4. Compute aggregate product status ──\n  const aggregateProductStatus = _computeAggregateStatus(targets, overallStatus);\n\n  // ── 5. Group systemic root causes ──\n  const systemicRootCauses = _groupSystemicRootCauses(findings, facts.gaps ?? []);\n\n  // ── 6. Compute integrity ──\n  const integrity = _computeIntegrity(facts, artifactManifest, binding);\n\n  // ── 7. Compute completeness ──\n  const completeness = _computeCompleteness(facts);\n\n  // ── 8. Compute exit code ──\n  const exitCode = _computeExitCode(overallStatus, integrity);\n\n  const now = host?.clock?.now?.() ?? 0;\n\n  /** @type {object} */\n  const report = {\n    schemaVersion: REPORT_SCHEMA_VERSION,\n    kind: REPORT_KIND,\n    planDigest: plan.planDigest ?? null,\n    binding,\n    requestedLevel,\n    achievedLevel,\n    status: overallStatus,\n    targets: Object.freeze(targets),\n    aggregateProductStatus,\n    findings: Object.freeze(findings),\n    gaps: Object.freeze([...(facts.gaps ?? [])]),\n    acceptedRisks: Object.freeze([...(facts.acceptedRisks ?? [])]),\n    systemicRootCauses: Object.freeze(systemicRootCauses),\n    integrity: Object.freeze(integrity),\n    completeness: Object.freeze(completeness),\n    policy: Object.freeze({ ...policy }),\n    exitCode,\n    producer: PRODUCER,\n    producerVersion: VERSION,\n    generatedAt: now,\n  };\n\n  // Compute report digest\n  const { digest: _omit, ...digestInput } = report;\n  report.digest = computeDigestId(JSON.stringify(digestInput));\n\n  return Object.freeze(report);\n}\n\n/**\n * Validate a canonical report.\n *\n * @param {object} report\n * @throws {IntegrityFailure} if the report is invalid.\n */\nexport function validateReport(report) {\n  if (!report || typeof report !== 'object') {\n    throw new IntegrityFailure('validateReport: report must be an object', {\n      code: 'E_REPORT_NOT_OBJECT', context: {},\n    });\n  }\n  if (report.schemaVersion !== REPORT_SCHEMA_VERSION) {\n    throw new IntegrityFailure(\n      `validateReport: schemaVersion must be ${REPORT_SCHEMA_VERSION}`,\n      { code: 'E_REPORT_SCHEMA', context: { schemaVersion: report.schemaVersion } },\n    );\n  }\n  if (report.kind !== REPORT_KIND) {\n    throw new IntegrityFailure(\n      `validateReport: kind must be \"${REPORT_KIND}\"`,\n      { code: 'E_REPORT_KIND', context: { kind: report.kind } },\n    );\n  }\n  if (!['PASS', 'FAIL', 'INCOMPLETE', 'BLOCKED'].includes(report.status)) {\n    throw new IntegrityFailure(\n      `validateReport: invalid status \"${report.status}\"`,\n      { code: 'E_REPORT_STATUS', context: { status: report.status } },\n    );\n  }\n}\n\n// ── Internal helpers ─────────────────────────────────────\n\n/**\n * Materialize findings only from authorized provider roles or\n * completed candidate lifecycles.\n *\n * @param {object} facts       Reconciled facts.\n * @param {object|null} adjudication  Adjudication result.\n * @returns {object[]}\n * @private\n */\nfunction _materializeFindings(facts, adjudication) {\n  const findings = [];\n  const seen = new Set();\n\n  // From reconciled receipts — only from authorized roles\n  for (const receipt of facts.evidenceResults ?? []) {\n    if (!receipt.complete) continue;\n\n    const execReceipt = receipt.executionReceipt;\n    if (!execReceipt) continue;\n\n    // Check role authority\n    const role = execReceipt.toolIdentity?.runnerKind ?? receipt.runnerKind;\n    const authority = ROLE_OUTPUT_AUTHORITY[role];\n    if (!authority?.findings) continue;\n\n    // Materialize findings from the receipt\n    for (const finding of execReceipt.findings ?? []) {\n      const id = finding.id ?? `${receipt.providerId}:${finding.channel ?? 'finding'}`;\n      if (seen.has(id)) continue;\n      seen.add(id);\n\n      findings.push({\n        id,\n        severity: finding.severity ?? 'info',\n        source: {\n          providerId: receipt.providerId,\n          role,\n          artifactDigest: receipt.digest ?? null,\n        },\n        targetId: finding.targetId ?? null,\n        controlId: finding.controlId ?? null,\n        family: finding.family ?? null,\n        lens: finding.lens ?? null,\n        description: finding.description ?? finding.message ?? '',\n        evidenceRefs: finding.evidenceRefs ?? [],\n      });\n    }\n  }\n\n  // From adjudication — only from completed candidate lifecycles\n  if (adjudication?.judgments) {\n    for (const judgment of adjudication.judgments) {\n      // Only materialize findings from confirmed or rejected judgments\n      if (judgment.verdict !== 'CONFIRMED' && judgment.verdict !== 'REJECTED') continue;\n\n      const id = `judgment:${judgment.subjectId}:${judgment.family}`;\n      if (seen.has(id)) continue;\n      seen.add(id);\n\n      findings.push({\n        id,\n        severity: judgment.verdict === 'REJECTED' ? 'high' : 'info',\n        source: {\n          providerId: judgment.reviewer.provider,\n          role: 'adjudicator',\n          artifactDigest: judgment.digest,\n        },\n        targetId: null,\n        controlId: null,\n        family: judgment.family,\n        lens: judgment.lens,\n        description: `Judgment: ${judgment.verdict}`,\n        evidenceRefs: judgment.evidenceRefs ?? [],\n      });\n    }\n  }\n\n  return findings;\n}\n\n/**\n * Materialize control states only from complete mapped evidence\n * requirements.\n *\n * @param {object} facts         Reconciled facts.\n * @param {object|null} baseline  Control baseline.\n * @returns {Record<string, string>}\n * @private\n */\nfunction _materializeControlStates(facts, baseline) {\n  const states = {};\n\n  if (!baseline?.controls) return states;\n\n  for (const control of baseline.controls) {\n    if (control.applicability !== 'applicable') {\n      states[control.controlId] = control.applicability;\n      continue;\n    }\n\n    // Check if all evidence requirements are complete\n    const targetControls = facts.controlState?.targets ?? {};\n    let allComplete = true;\n\n    for (const [_, tc] of Object.entries(targetControls)) {\n      if (tc.controls?.[control.controlId] !== 'pass') {\n        allComplete = false;\n        break;\n      }\n    }\n\n    states[control.controlId] = allComplete ? 'pass' : 'incomplete';\n  }\n\n  return states;\n}\n\n/**\n * Compute per-target claim decisions for all claim levels.\n *\n * @param {object|null} productPortfolio\n * @param {object} facts\n * @param {object[]} findings\n * @param {string} requestedLevel\n * @param {object} binding\n * @returns {object[]}\n * @private\n */\nfunction _computeTargetDecisions(productPortfolio, facts, findings, requestedLevel, binding) {\n  const targets = productPortfolio?.targets ?? [{ id: 'default' }];\n  const result = [];\n\n  for (const target of targets) {\n    const targetId = target.id ?? target.targetId ?? 'unknown';\n    const targetFindings = findings.filter(\n      (f) => !f.targetId || f.targetId === targetId,\n    );\n\n    const decisions = [];\n\n    for (const level of CLAIM_LEVEL_HIERARCHY) {\n      const levelStatuses = {};\n\n      // Check if this level is satisfied\n      let status = 'PASS';\n      const targetControls = facts.controlState?.targets?.[targetId] ?? {};\n\n      if (claimLevelAtOrAbove(level, 'product')) {\n        if (!targetControls.complete) {\n          status = 'INCOMPLETE';\n        }\n      }\n\n      if (claimLevelAtOrAbove(level, 'source')) {\n        if (!facts.familyPolicy?.complete) {\n          status = 'INCOMPLETE';\n        }\n      }\n\n      // Check for critical findings\n      if (targetFindings.some((f) => f.severity === 'critical')) {\n        status = 'FAIL';\n      }\n\n      decisions.push({\n        level,\n        status,\n        controlCoverage: targetControls.controls ?? {},\n        evidenceCoverage: {},\n        scenarioCoverage: {},\n        findings: targetFindings,\n        gaps: (facts.gaps ?? []).filter(\n          (g) => !g.targetId || g.targetId === targetId,\n        ),\n      });\n    }\n\n    result.push({\n      targetId,\n      decisions,\n    });\n  }\n\n  return result;\n}\n\n/**\n * Compute the aggregate product status from per-target decisions.\n *\n * @param {object[]} targets\n * @param {string} overallStatus\n * @returns {string}\n * @private\n */\nfunction _computeAggregateStatus(targets, overallStatus) {\n  const allStatuses = [];\n\n  for (const target of targets) {\n    for (const decision of target.decisions ?? []) {\n      allStatuses.push(decision.status);\n    }\n  }\n\n  if (allStatuses.includes('FAIL')) return 'FAIL';\n  if (allStatuses.includes('INCOMPLETE')) return 'INCOMPLETE';\n  if (allStatuses.includes('BLOCKED')) return 'BLOCKED';\n  return overallStatus;\n}\n\n/**\n * Group systemic root causes while preserving each target, control,\n * family, finding, gap, scenario, and evidence chain.\n *\n * @param {object[]} findings\n * @param {object[]} gaps\n * @returns {object[]}\n * @private\n */\nfunction _groupSystemicRootCauses(findings, gaps) {\n  /** @type {Map<string, object>} */\n  const groups = new Map();\n\n  // Group findings by family + root cause pattern\n  for (const finding of findings) {\n    const family = finding.family ?? 'unknown';\n    const key = `${family}:${finding.description?.split(':')[0] ?? 'general'}`;\n\n    if (!groups.has(key)) {\n      groups.set(key, {\n        id: `root-cause:${key}`,\n        description: finding.description ?? 'Unknown root cause',\n        affectedTargets: [],\n        affectedControls: [],\n        affectedFamilies: [],\n        affectedFindings: [],\n        affectedGaps: [],\n        affectedScenarios: [],\n        affectedEvidence: [],\n      });\n    }\n\n    const group = groups.get(key);\n    if (finding.targetId && !group.affectedTargets.includes(finding.targetId)) {\n      group.affectedTargets.push(finding.targetId);\n    }\n    if (finding.controlId && !group.affectedControls.includes(finding.controlId)) {\n      group.affectedControls.push(finding.controlId);\n    }\n    if (finding.family && !group.affectedFamilies.includes(finding.family)) {\n      group.affectedFamilies.push(finding.family);\n    }\n    if (!group.affectedFindings.includes(finding.id)) {\n      group.affectedFindings.push(finding.id);\n    }\n    for (const ref of finding.evidenceRefs ?? []) {\n      if (!group.affectedEvidence.includes(ref.digest ?? ref)) {\n        group.affectedEvidence.push(ref.digest ?? ref);\n      }\n    }\n  }\n\n  // Add gaps\n  for (const gap of gaps) {\n    const key = `gap:${gap.type}`;\n    if (!groups.has(key)) {\n      groups.set(key, {\n        id: `root-cause:${key}`,\n        description: gap.reason ?? 'Gap root cause',\n        affectedTargets: [],\n        affectedControls: [],\n        affectedFamilies: [],\n        affectedFindings: [],\n        affectedGaps: [],\n        affectedScenarios: [],\n        affectedEvidence: [],\n      });\n    }\n    groups.get(key).affectedGaps.push(gap.type);\n    if (gap.targetId) groups.get(key).affectedTargets.push(gap.targetId);\n    if (gap.controlId) groups.get(key).affectedControls.push(gap.controlId);\n  }\n\n  return [...groups.values()];\n}\n\n/**\n * Compute integrity verification results.\n *\n * @param {object} facts\n * @param {object|null} artifactManifest\n * @param {object} binding\n * @returns {object}\n * @private\n */\nfunction _computeIntegrity(facts, artifactManifest, binding) {\n  const reconciliationErrors = facts.executionFailure ?? [];\n  const verificationErrors = facts.verificationErrors ?? [];\n\n  return {\n    bindingValid: reconciliationErrors.length === 0,\n    artifactCount: artifactManifest?.artifactCount ?? 0,\n    digestMismatches: verificationErrors.filter(\n      (e) => e.type === 'consumed-artifacts' || e.type === 'produced-artifacts',\n    ),\n    reconciliationErrors,\n    verificationErrors,\n  };\n}\n\n/**\n * Compute completeness dimensions.\n *\n * @param {object} facts\n * @returns {object}\n * @private\n */\nfunction _computeCompleteness(facts) {\n  return {\n    familyLens: facts.familyLensCompleteness ?? {},\n    targetControl: facts.targetControlCompleteness ?? {},\n    aggregateProduct: facts.aggregateProductCompleteness ?? {},\n  };\n}\n\n/**\n * Compute the CLI exit code from the overall status and integrity.\n *\n * @param {string} status\n * @param {object} integrity\n * @returns {number}\n * @private\n */\nfunction _computeExitCode(status, integrity) {\n  if (!integrity.bindingValid) return EXIT_CODES.INTEGRITY;\n  switch (status) {\n    case 'PASS': return EXIT_CODES.PASS;\n    case 'FAIL': return EXIT_CODES.FAIL;\n    case 'INCOMPLETE': return EXIT_CODES.INCOMPLETE;\n    case 'BLOCKED': return EXIT_CODES.INCOMPLETE;\n    default: return EXIT_CODES.INTERNAL;\n  }\n}\n\r\n","exit_code":0,"status":"completed"}}
