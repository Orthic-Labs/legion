{"type":"item.completed","item":{"id":"item_102","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command \"Get-Content \\\"D:\\\\Claude\\\\nemesis\\\\scripts\\\\qualify-book.mjs\\\" -Raw\"","aggregated_output":"#!/usr/bin/env node\n/**\n * @fileoverview Book qualification dispatcher for the Nemesis audit\n * system (B1-027, SNIP-17).\n *\n * Discovers and runs test suites for a given book number, runs the\n * package smoke test, compares serial and auto semantic digests,\n * and writes a content-digested qualification receipt to\n * `qualification/book-N.json`.\n *\n * Usage:\n *   node scripts/qualify-book.mjs --book 1\n *\n * Exit codes:\n *   0 — PASS (all tests pass, digests match)\n *   2 — INCOMPLETE (some subsystems not yet implemented)\n *   3 — FAIL (one or more tests failed)\n *\n * Forbidden: This script creates the dispatcher and fixtures but\n * the actual qualification run is deferred.\n */\n\nimport { readdirSync, statSync, mkdirSync, writeFileSync, existsSync } from 'node:fs';\nimport { fileURLToPath } from 'node:url';\nimport { dirname, resolve as pathResolve, join, relative } from 'node:path';\nimport { spawn } from 'node:child_process';\nimport { createRequire } from 'node:module';\n\nconst _require = createRequire(import.meta.url);\n\nconst _scriptDir = dirname(fileURLToPath(import.meta.url));\nconst _pkgRoot = pathResolve(_scriptDir, '..');\n\n// ── Exit codes ─────────────────────────────────────────\nconst EXIT_PASS = 0;\nconst EXIT_INCOMPLETE = 2;\nconst EXIT_FAIL = 3;\n\n// ── Book → test directory mapping ──────────────────────\nconst BOOK_TEST_DIRS = {\n  1: ['tests/core', 'tests/skills', 'tests/distribution/package'],\n  2: [\n    'tests/core',\n    'tests/inventory/product-portfolio',\n    'tests/inventory/component-graph',\n    'tests/inventory/components/build-deploy',\n    'tests/inventory/components/logical',\n    'tests/inventory/external-systems',\n    'tests/inventory/journeys',\n    'tests/inventory/product-target-detectors',\n    'tests/inventory/product-target-review',\n    'tests/inventory/stack-graph',\n    'tests/controls/baseline',\n    'tests/controls/contracts',\n    'tests/controls/evidence',\n    'tests/controls/scenarios',\n    'tests/controls/sources/creator-audits',\n    'tests/controls/sources/platform-checklists',\n    'tests/controls/packs/universal',\n    'tests/controls/packs/web',\n    'tests/controls/packs/desktop',\n    'tests/controls/packs/mobile',\n    'tests/controls/packs/service-data',\n    'tests/controls/packs/developer-tools',\n    'tests/controls/packs/infrastructure-release',\n    'tests/controls/packs/conditional',\n  ],\n  3: [],\n  4: [],\n  5: [],\n  6: [],\n  7: [],\n  8: [],\n};\n\n// ── Helpers ────────────────────────────────────────────\n\n/**\n * Recursively discover all .test.mjs files under a directory.\n *\n * @param {string} dir  Absolute directory path.\n * @returns {string[]}  Sorted array of absolute file paths.\n */\nfunction _discoverTests(dir) {\n  if (!existsSync(dir)) return [];\n  const results = [];\n  function _walk(d) {\n    const entries = readdirSync(d);\n    for (const entry of entries) {\n      const full = join(d, entry);\n      const stat = statSync(full);\n      if (stat.isDirectory()) {\n        _walk(full);\n      } else if (entry.endsWith('.test.mjs')) {\n        results.push(full);\n      }\n    }\n  }\n  _walk(dir);\n  return results.sort();\n}\n\n/**\n * Parse --book N from argv.\n *\n * @param {string[]} argv\n * @returns {{ book: number | null; error?: string }}\n */\nfunction _parseArgs(argv) {\n  let book = null;\n  for (let i = 0; i < argv.length; i++) {\n    if (argv[i] === '--book') {\n      if (i + 1 >= argv.length) {\n        return { book: null, error: '--book requires a value' };\n      }\n      const n = Number(argv[i + 1]);\n      if (!Number.isInteger(n) || n < 1 || n > 8) {\n        return { book: null, error: `--book must be 1-8, got ${argv[i + 1]}` };\n      }\n      book = n;\n      i++;\n    }\n  }\n  return { book };\n}\n\n/**\n * Run a single test module by importing it and calling run().\n *\n * Falls back to spawning `node --test` when the module does not export\n * a `run()` function (the `node:test` describe/it pattern).\n *\n * @param {string} testPath  Absolute path to the .test.mjs file.\n * @returns {Promise<{ pass: boolean; name: string; checks?: number; passed?: number; failed?: number; error?: string }>}\n */\nasync function _runTestModule(testPath) {\n  try {\n    const mod = await import(testPath);\n    if (typeof mod.run === 'function') {\n      let result;\n      try {\n        result = await mod.run();\n      } catch (runErr) {\n        return {\n          pass: false,\n          name: relative(_pkgRoot, testPath),\n          error: runErr?.message ?? String(runErr),\n        };\n      }\n      // Some test files only log results and return undefined.\n      // Treat as pass if no exception was thrown.\n      if (result === undefined || result === null) {\n        return {\n          pass: true,\n          name: relative(_pkgRoot, testPath),\n        };\n      }\n      return {\n        pass: result.pass === true,\n        name: result.name ?? relative(_pkgRoot, testPath),\n        checks: result.checks,\n        passed: result.passed,\n        failed: result.failed,\n        error: result.error,\n      };\n    }\n    // Fall back to node --test for describe/it pattern.\n    return await _runNodeTest(testPath);\n  } catch (err) {\n    return {\n      pass: false,\n      name: relative(_pkgRoot, testPath),\n      error: err?.message ?? String(err),\n    };\n  }\n}\n\n/**\n * Run a test file using `node --test` and parse the resulting pass/fail.\n *\n * @param {string} testPath  Absolute path to the .test.mjs file.\n * @returns {Promise<{ pass: boolean; name: string; passed?: number; failed?: number; error?: string }>}\n */\nfunction _runNodeTest(testPath) {\n  return new Promise((resolve) => {\n    const child = spawn('node', ['--test', testPath], {\n      cwd: _pkgRoot,\n      stdio: ['pipe', 'pipe', 'pipe'],\n    });\n    let stdout = '';\n    let stderr = '';\n    child.stdout.on('data', (d) => { stdout += d.toString(); });\n    child.stderr.on('data', (d) => { stderr += d.toString(); });\n    child.on('error', () => {\n      resolve({ pass: false, name: relative(_pkgRoot, testPath), error: 'spawn failed' });\n    });\n    child.on('close', (code) => {\n      // Parse the summary line: \"ℹ tests N\\nℹ pass P\\nℹ fail F\\n\"\n      const passedMatch = stdout.match(/ℹ pass (\\d+)/);\n      const failedMatch = stdout.match(/ℹ fail (\\d+)/);\n      const testsMatch = stdout.match(/ℹ tests (\\d+)/);\n      const suitesMatch = stdout.match(/ℹ suites (\\d+)/);\n      const passed = passedMatch ? Number(passedMatch[1]) : 0;\n      const failed = failedMatch ? Number(failedMatch[1]) : 0;\n      const checks = testsMatch ? Number(testsMatch[1]) : 0;\n      const suites = suitesMatch ? Number(suitesMatch[1]) : 0;\n      // Treat empty test files (0 suites) as pass — they are placeholders.\n      const hasNoTests = suites === 0 && checks <= 1;\n      resolve({\n        pass: (code === 0 && failed === 0) || hasNoTests,\n        name: relative(_pkgRoot, testPath),\n        passed,\n        failed,\n        checks,\n        error: code === 0 || hasNoTests ? null : (stderr.slice(0, 500) || `exit ${code}`),\n      });\n    });\n  });\n}\n\n/**\n * Run the package-smoke.mjs script as a child process.\n *\n * @returns {Promise<{ pass: boolean; exitCode: number; stdout: string; stderr: string }>}\n */\nfunction _runPackageSmoke() {\n  return new Promise((resolve) => {\n    const child = spawn('node', [join(_scriptDir, 'package-smoke.mjs')], {\n      cwd: _pkgRoot,\n      stdio: ['pipe', 'pipe', 'pipe'],\n    });\n    let stdout = '';\n    let stderr = '';\n    child.stdout.on('data', (d) => { stdout += d.toString(); });\n    child.stderr.on('data', (d) => { stderr += d.toString(); });\n    child.on('error', () => {\n      resolve({ pass: false, exitCode: -1, stdout, stderr });\n    });\n    child.on('close', (code) => {\n      resolve({\n        pass: code === 0,\n        exitCode: code,\n        stdout,\n        stderr,\n      });\n    });\n  });\n}\n\n/**\n * Get the git revision synchronously.\n *\n * @returns {string}\n */\nfunction _getGitRevision() {\n  try {\n    const { execSync } = _require('node:child_process');\n    return execSync('git rev-parse HEAD', { cwd: _pkgRoot, encoding: 'utf-8' }).trim();\n  } catch {\n    return 'unknown';\n  }\n}\n\n/**\n * Compute canonical JSON hash of an object.\n *\n * @param {unknown} obj\n * @returns {string} sha256: prefixed digest.\n */\nfunction _canonicalJsonHash(obj) {\n  // Inline implementation to avoid import issues in dispatcher\n  const crypto = _require('node:crypto');\n  function _canonical(value) {\n    if (value === null || value === undefined) return 'null';\n    if (typeof value === 'boolean') return value ? 'true' : 'false';\n    if (typeof value === 'number') return Number.isFinite(value) ? String(value) : 'null';\n    if (typeof value === 'string') return JSON.stringify(value);\n    if (Array.isArray(value)) return '[' + value.map(_canonical).join(',') + ']';\n    if (typeof value === 'object') {\n      const keys = Object.keys(value).sort();\n      return '{' + keys.map(k => JSON.stringify(k) + ':' + _canonical(value[k])).join(',') + '}';\n    }\n    return 'null';\n  }\n  const canonical = _canonical(obj);\n  const hash = crypto.createHash('sha256').update(canonical, 'utf-8').digest('hex');\n  return 'sha256:' + hash;\n}\n\n/**\n * Build serial and auto semantic projections and compare their digests.\n *\n * Uses the same plan with different schedule modes to verify that\n * the semantic projection is stable across scheduling strategies.\n *\n * @returns {Promise<{ serialDigest: string; autoDigest: string; match: boolean; error?: string }>}\n */\nasync function _compareSemanticDigests() {\n  try {\n    const { buildSemanticProjection } = await import(join(_pkgRoot, 'lib', 'verification', 'projection.mjs'));\n    const { computeDigestId } = await import(join(_pkgRoot, 'lib', 'artifacts', 'digests.mjs'));\n    const { SCHEMA_VERSION } = await import(join(_pkgRoot, 'lib', 'version.mjs'));\n\n    const basePlan = {\n      schemaVersion: SCHEMA_VERSION,\n      kind: 'nemesis-plan',\n      planDigest: computeDigestId('qualify-book-plan'),\n      binding: {\n        planDigest: computeDigestId('qualify-book-plan'),\n        configDigest: computeDigestId('qualify-cfg'),\n        repositoryRevision: _getGitRevision(),\n        dirtyOverlayDigest: null,\n        cortexProvider: 'bundled',\n        cortexVersion: '0.1.0',\n        cortexGenerationId: 'gen-qualify',\n        cortexManifestDigest: computeDigestId('cortex'),\n        familyRegistryDigest: computeDigestId('families'),\n        providerRegistryDigest: computeDigestId('providers'),\n        skillRegistryDigest: computeDigestId('skills'),\n        productTargetRegistryDigest: null,\n        componentRegistryDigest: null,\n        stackCatalogueDigest: null,\n        controlSourceCatalogueDigest: null,\n        controlPackRegistryDigest: null,\n        scenarioRegistryDigest: null,\n        releaseContractDigest: null,\n        externalEvidenceManifestDigest: null,\n      },\n      nodes: [\n        {\n          providerId: 'p1',\n          dependsOn: [],\n          scheduleClass: 'parallel-safe',\n          reasoningRequirement: 'none',\n          reviewTrigger: 'never',\n          produces: ['findings'],\n          consumes: [],\n          denominator: 'denom-1',\n          providerVersion: '1.0',\n        },\n        {\n          providerId: 'p2',\n          dependsOn: ['p1'],\n          scheduleClass: 'parallel-safe',\n          reasoningRequirement: 'none',\n          reviewTrigger: 'never',\n          produces: ['verdicts'],\n          consumes: ['findings'],\n          denominator: 'denom-2',\n          providerVersion: '1.0',\n        },\n      ],\n      selectedFamilies: ['static-analysis'],\n      selectedLenses: ['security'],\n      executionPolicy: { scheduleMode: 'auto' },\n      sealed: true,\n    };\n\n    // Serial projection — plan with serial schedule mode\n    const serialPlan = {\n      ...basePlan,\n      executionPolicy: { ...basePlan.executionPolicy, scheduleMode: 'serial' },\n    };\n    const serialProjection = buildSemanticProjection({ plan: serialPlan });\n\n    // Auto projection — plan with auto schedule mode\n    const autoPlan = {\n      ...basePlan,\n      executionPolicy: { ...basePlan.executionPolicy, scheduleMode: 'auto' },\n    };\n    const autoProjection = buildSemanticProjection({ plan: autoPlan });\n\n    return {\n      serialDigest: serialProjection.semanticDigest,\n      autoDigest: autoProjection.semanticDigest,\n      match: serialProjection.semanticDigest === autoProjection.semanticDigest,\n    };\n  } catch (err) {\n    return {\n      serialDigest: 'unknown',\n      autoDigest: 'unknown',\n      match: false,\n      error: err?.message ?? String(err),\n    };\n  }\n}\n\n/**\n * Build the SNIP-17 qualification bundle.\n *\n * @param {object} params\n * @param {number} params.book\n * @param {object[]} params.testRuns\n * @param {object} params.smokeResult\n * @param {object} params.digestComparison\n * @param {string} params.qualificationDigest\n * @returns {object} SNIP-17 bundle\n */\nfunction _buildQualificationBundle({ book, testRuns, smokeResult, digestComparison, qualificationDigest }) {\n  const allTestsPass = testRuns.every(t => t.pass);\n  const smokePass = smokeResult.pass;\n  const digestsMatch = digestComparison.match;\n\n  let decision;\n  if (allTestsPass && smokePass && digestsMatch) {\n    decision = 'RELEASE';\n  } else if (allTestsPass && (smokePass || digestsMatch)) {\n    decision = 'INTERNAL_ONLY';\n  } else {\n    decision = 'BLOCKED';\n  }\n\n  return {\n    schemaVersion: 1,\n    kind: 'nemesis-release-qualification',\n    sourceRevision: _getGitRevision(),\n    book,\n    package: {\n      name: '@orthic-labs/nemesis',\n      version: '0.1.0-dev.0',\n    },\n    skillBundles: [],\n    nativeArtifacts: [],\n    signatures: [],\n    checksums: [],\n    sboms: [],\n    testRuns,\n    benchmarks: [],\n    topologyQualifications: [],\n    controlPackQualifications: [],\n    platformQualifications: [],\n    familyQualifications: [],\n    lensQualifications: [],\n    schedulerQualification: {\n      serialDigest: digestComparison.serialDigest,\n      autoDigest: digestComparison.autoDigest,\n      digestsMatch: digestComparison.match,\n      error: digestComparison.error ?? null,\n    },\n    reviewerQualifications: [],\n    governanceEvidence: [],\n    knownGaps: [\n      'B1 baseline: lifecycle functions throw IncompleteEvidence',\n      'B1 baseline: no external provider integration',\n      'B1 baseline: no SBOM generation',\n      'B1 baseline: no signature infrastructure',\n    ],\n    smokeTest: {\n      pass: smokeResult.pass,\n      exitCode: smokeResult.exitCode,\n      output: smokeResult.stdout?.slice(0, 500) ?? '',\n    },\n    qualificationDigest,\n    decision,\n    generatedAt: new Date().toISOString(),\n  };\n}\n\n// ── Main ───────────────────────────────────────────────\nasync function main() {\n  const { book, error: parseError } = _parseArgs(process.argv.slice(2));\n\n  if (parseError) {\n    console.error(`Error: ${parseError}`);\n    console.error('Usage: node scripts/qualify-book.mjs --book N (1-8)');\n    process.exitCode = EXIT_INCOMPLETE;\n    return;\n  }\n\n  if (book === null) {\n    console.error('Error: --book is required');\n    console.error('Usage: node scripts/qualify-book.mjs --book N (1-8)');\n    process.exitCode = EXIT_INCOMPLETE;\n    return;\n  }\n\n  console.log(`\\n════════════════════════════════════════════════════`);\n  console.log(`  Nemesis Book ${book} Qualification`);\n  console.log(`════════════════════════════════════════════════════\\n`);\n\n  const testRuns = [];\n\n  // ── Discover and run test suites ──\n  const testDirs = BOOK_TEST_DIRS[book] ?? [];\n  if (testDirs.length > 0) {\n    console.log('─ Test Discovery ─────────────────────────────────');\n    const allTests = [];\n    for (const dir of testDirs) {\n      const absDir = join(_pkgRoot, dir);\n      const tests = _discoverTests(absDir);\n      for (const t of tests) {\n        allTests.push(t);\n        console.log(`  discovered: ${relative(_pkgRoot, t)}`);\n      }\n    }\n    console.log(`  total: ${allTests.length} test files\\n`);\n\n    // ── Run tests ──\n    console.log('─ Test Execution ────────────────────────────────');\n    for (const testPath of allTests) {\n      const result = await _runTestModule(testPath);\n      const status = result.pass ? 'PASS' : 'FAIL';\n      const detail = result.checks\n        ? ` (${result.passed ?? 0}/${result.checks} checks)`\n        : '';\n      console.log(`  [${status}] ${result.name}${detail}`);\n      if (result.error) {\n        console.log(`         ${result.error}`);\n      }\n      testRuns.push({\n        name: result.name,\n        pass: result.pass,\n        checks: result.checks,\n        passed: result.passed,\n        failed: result.failed,\n        error: result.error ?? null,\n      });\n    }\n    console.log('');\n  } else {\n    console.log('  (no test directories for this book)\\n');\n  }\n\n  // ── Run package smoke test ──\n  console.log('─ Package Smoke Test ────────────────────────────');\n  const smokeResult = await _runPackageSmoke();\n  console.log(`  [${smokeResult.pass ? 'PASS' : 'FAIL'}] exit code: ${smokeResult.exitCode}`);\n  if (smokeResult.stderr) {\n    console.log(`  stderr: ${smokeResult.stderr.slice(0, 200)}`);\n  }\n  console.log('');\n\n  // ── Compare serial and auto semantic digests ──\n  console.log('─ Semantic Digest Comparison ────────────────────');\n  const digestComparison = await _compareSemanticDigests();\n  console.log(`  serial digest: ${digestComparison.serialDigest.slice(0, 24)}...`);\n  console.log(`  auto digest:   ${digestComparison.autoDigest.slice(0, 24)}...`);\n  console.log(`  match: ${digestComparison.match}`);\n  if (digestComparison.error) {\n    console.log(`  error: ${digestComparison.error}`);\n  }\n  console.log('');\n\n  // ── Build qualification bundle ──\n  // Compute the qualification digest (content-digested receipt)\n  const bundleData = {\n    book,\n    testRuns: testRuns.map(t => ({\n      name: t.name,\n      pass: t.pass,\n      checks: t.checks,\n      passed: t.passed,\n      failed: t.failed,\n    })),\n    smokeTest: {\n      pass: smokeResult.pass,\n      exitCode: smokeResult.exitCode,\n    },\n    digestComparison: {\n      serialDigest: digestComparison.serialDigest,\n      autoDigest: digestComparison.autoDigest,\n      match: digestComparison.match,\n    },\n  };\n  const qualificationDigest = _canonicalJsonHash(bundleData);\n\n  const bundle = _buildQualificationBundle({\n    book,\n    testRuns,\n    smokeResult,\n    digestComparison,\n    qualificationDigest,\n  });\n\n  // ── Write qualification receipt ──\n  const qualDir = join(_pkgRoot, 'qualification');\n  if (!existsSync(qualDir)) {\n    mkdirSync(qualDir, { recursive: true });\n  }\n  const receiptPath = join(qualDir, `book-${book}.json`);\n  writeFileSync(receiptPath, JSON.stringify(bundle, null, 2) + '\\n', 'utf-8');\n  console.log(`─ Qualification Receipt ──────────────────────────`);\n  console.log(`  written: ${relative(_pkgRoot, receiptPath)}`);\n  console.log(`  digest:  ${qualificationDigest.slice(0, 24)}...`);\n  console.log(`  decision: ${bundle.decision}\\n`);\n\n  // ── Determine exit code ──\n  const allTestsPass = testRuns.every(t => t.pass);\n  const smokePass = smokeResult.pass;\n  const digestsMatch = digestComparison.match;\n\n  console.log('════════════════════════════════════════════════════');\n  console.log(`  Tests:    ${testRuns.filter(t => t.pass).length}/${testRuns.length} pass`);\n  console.log(`  Smoke:    ${smokePass ? 'PASS' : 'FAIL'}`);\n  console.log(`  Digests:  ${digestsMatch ? 'MATCH' : 'MISMATCH'}`);\n  console.log(`  Decision: ${bundle.decision}`);\n  console.log('════════════════════════════════════════════════════\\n');\n\n  if (allTestsPass && smokePass && digestsMatch) {\n    process.exitCode = EXIT_PASS;\n  } else if (!allTestsPass || !smokePass) {\n    process.exitCode = EXIT_FAIL;\n  } else {\n    process.exitCode = EXIT_INCOMPLETE;\n  }\n}\n\nmain().catch((err) => {\n  console.error('Fatal error in qualification dispatcher:', err);\n  process.exitCode = EXIT_FAIL;\n});\n\r\n","exit_code":0,"status":"completed"}}
