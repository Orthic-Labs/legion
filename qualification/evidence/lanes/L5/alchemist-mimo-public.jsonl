n});\r\n\r\ntest('provider status mutation is detected', () => {\r\n  const facts = fixtureFacts();\r\n  const baseline = verificationDigest(facts);\r\n  const mutated = clone(facts);\r\n  mutated.provider_reconciliation.providerResults[0].status = 'fail';\r\n  assert.notEqual(verificationDigest(mutated), baseline, 'provider status change must create drift');\r\n});\r\n\r\ntest('finding fingerprint mutation is detected', () => {\r\n  const facts = fixtureFacts();\r\n  const baseline = verificationDigest(facts);\r\n  const mutated = clone(facts);\r\n  mutated.checks[0].findings[0].evidenceDigest = 'sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff';\r\n  assert.notEqual(verificationDigest(mutated), baseline, 'finding fingerprint change must create drift');\r\n});\r\n\r\ntest('denominator mutation is detected', () => {\r\n  const facts = fixtureFacts();\r\n  const baseline = verificationDigest(facts);\r\n  const mutated = clone(facts);\r\n  mutated.plan.denominator.providerIds = ['language.typescript'];\r\n  assert.notEqual(verificationDigest(mutated), baseline, 'denominator change must create drift');\r\n});\r\n\r\ntest('tool version mutation is detected', () => {\r\n  const facts = fixtureFacts();\r\n  const baseline = verificationDigest(facts);\r\n  const mutated = clone(facts);\r\n  mutated.checks[0].toolVersion = '8.19.0';\r\n  assert.notEqual(verificationDigest(mutated), baseline, 'tool version change must create drift');\r\n});\r\n\r\ntest('plan seal mutation is detected', () => {\r\n  const facts = fixtureFacts();\r\n  const baseline = verificationDigest(facts);\r\n  const mutated = clone(facts);\r\n  mutated.plan.seal.digest = 'sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee';\r\n  assert.notEqual(verificationDigest(mutated), baseline, 'plan seal change must create drift');\r\n});\r\n\r\ntest('repository binding mutation is detected', () => {\r\n  const facts = fixtureFacts();\r\n  const baseline = verificationDigest(facts);\r\n  const mutated = clone(facts);\r\n  mutated.plan.binding.repositoryRevision = 'deadbeefdeadbeefdeadbeefdeadbeefdeadbeef';\r\n  assert.notEqual(verificationDigest(mutated), baseline, 'repository binding change must create drift');\r\n});\r\n\r\ntest('unreplayable checks are classified, not merged into content drift', () => {\r\n  const facts = fixtureFacts();\r\n  const projection = verificationProjection(facts);\r\n  // An unreplayable check (e.g. missing sandbox) must remain a distinct status\r\n  // and never be silently normalized to pass.\r\n  const mutated = clone(facts);\r\n  mutated.checks[0].status = 'unproven';\r\n  mutated.checks[0].skip_reason = 'network sandbox receipt missing';\r\n  const projection2 = verificationProjection(mutated);\r\n  const check = projection2.checks.find((item) => item.check === 'secrets');\r\n  assert.equal(check.executionStatus, 'unproven');\r\n  assert.notEqual(verificationDigest(mutated), verificationDigest(facts));\r\n  assert.ok(projection.checks.length === projection2.checks.length);\r\n});\r\n\r\ntest('audit-verify.mjs executes end-to-end over a frozen fixture', () => {\r\n  // The verifier collects the current repository binding from the workspace it\r\n  // is pointed at, so the spawned test runs against a real (temporary) git repo\r\n  // seeded from the frozen fixture. A synthetic fixture cannot byte-match a live\r\n  // empty repo (binding, provider set, and replayed secrets differ), so the\r\n  // verifier must legitimately report drift and exit 1 — the assertion is that\r\n  // it runs to completion, reaches the semantic projection gate, and reports\r\n  // per-field drift instead of crashing or exiting 0.\r\n  const factsSource = fixtureFacts();\r\n  const planSource = JSON.parse(readFileSync(new URL('./fixtures/verify/plan.json', import.meta.url), 'utf8'));\r\n  const temp = mkdtempSync(join(tmpdir(), 'nemesis-verify-e2e-'));\r\n  try {\r\n    execFileSync('git', ['init', '-q', temp], { stdio: 'ignore' });\r\n    execFileSync('git', ['-C', temp, 'config', 'user.email', 'verify@nemesis.test'], { stdio: 'ignore' });\r\n    execFileSync('git', ['-C', temp, 'config', 'user.name', 'Nemesis Verify'], { stdio: 'ignore' });\r\n    execFileSync('git', ['-C', temp, 'commit', '-q', '--allow-empty', '-m', 'verify fixture baseline'], { stdio: 'ignore' });\r\n\r\n    const revision = execFileSync('git', ['-C', temp, 'rev-parse', 'HEAD'], { encoding: 'utf8' }).trim();\r\n    const seededFacts = { ...factsSource, workspace: temp, out_dir: join(temp, '.audit', 'run-1') };\r\n    const seededPlan = { ...planSource, root: temp };\r\n    seededFacts.plan.binding.repositoryRevision = revision;\r\n    seededPlan.binding.repositoryRevision = revision;\r\n    const factsPath = join(temp, 'facts.json');\r\n    const planPath = join(temp, 'plan.json');\r\n    writeFileSync(factsPath, JSON.stringify(seededFacts, null, 2));\r\n    writeFileSync(planPath, JSON.stringify(seededPlan, null, 2));\r\n\r\n    const result = spawnSync(process.execPath, [\r\n      'audit-verify.mjs',\r\n      '--facts', factsPath,\r\n      '--plan', planPath,\r\n    ], {\r\n      cwd: root,\r\n      encoding: 'utf8',\r\n      stdio: ['ignore', 'pipe', 'pipe'],\r\n      env: { ...process.env, AUDIT_NETWORK_GUARD: 'inactive' },\r\n    });\r\n    assert.equal(result.status, 1, 'verifier must exit 1 when drift is detected');\r\n    assert.match(result.stdout, /semantic verification projection/);\r\n    assert.match(result.stdout, /DRIFT|MATCH|UNPROVEN/);\r\n  } finally {\r\n    rmSync(temp, { recursive: true, force: true });\r\n  }\r\n});\r\n\r\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_52","type":"reasoning","text":"Let me analyze the acceptance criteria and current state:\n\n**Task B8-001: Compatibility wrappers (audit-run.mjs, audit-plan.mjs, audit-finalize.mjs, audit-verify.mjs) should be thin wrappers without subprocess-to-self**\n\n**Task B8-003: MCP tools validate runtime inputs, call in-process core operations, return structured protocol-safe results, reject scope escape, bound output. Public exports remain explicit/versioned without mutable registry export.**\n\nLet me check what gaps remain:\n\n1. **audit-run.mjs** - Currently imports from `audit-complete.mjs`, `providers/generic-source-suite.mjs`, `providers/accessibility-suite.mjs`, `security-pipeline.mjs` - these are outside the allowed edit scope. It doesn't shell out to itself. This is a CLI entrypoint that calls core ops directly. The task says to make it a thin wrapper but the paths used (`audit-complete.mjs`, providers) are outside allowed edit files. It already calls in-process core operations.\n\n2. **audit-plan.mjs** - Already has exported functions (`buildAuditPlan`, `sealPlan`, etc.) that are used by `lib/index.mjs` and `lib/core/index.mjs`. This is already a library module with explicit exports. ✓\n\n3. **audit-finalize.mjs** - Has a `finalizeAudit` export (used by `lib/core/finalize-run.mjs` and tests). Also has a `main()` that reads files and runs CLI. It references `AUDIT_RUN` and `AUDIT_VERIFY` paths but only in the `rerun` command metadata - it does NOT actually exec them. It imports `reportToSarif` from `./scripts/report-to-sarif.mjs`. This is already a library + CLI combo.\n\n4. **audit-verify.mjs** - This is a CLI-only script. It uses `execFileSync` to re-run `collect-facts.mjs` (not itself). It imports from `adapters/cortex-projection.mjs`, `audit-plan.mjs`, `registry/provider-registry.mjs`, `lib/verification-projection.mjs`. It does shell out to `collect-facts.mjs` for replay. The question is whether verify has an in-process core path. Looking at `lib/core/verify-run.mjs` / `verifySealedRun` - this is the in-process core verify path that the MCP tools use. The top-level `audit-verify.mjs` is the CLI verification script that does the full replay.\n\nLet me check what `lib/core/index.mjs` exports:\n\nFrom lib/core/index.mjs:\n- `verifyRun = verifySealedRun` - this is the in-process core verify\n- The CLI `audit-verify.mjs` is a different, more detailed verification that replays checks\n\nSo the question is: does `audit-verify.mjs` (CLI) need to become a thin wrapper? It uses `execFileSync` to run `collect-facts.mjs` - that's subprocess to a DIFFERENT script, not to itself. But it's not a thin wrapper around core.\n\nLet me now assess the actual gaps:\n\n**B8-001: Compatibility wrappers - subprocess-to-self**\n\nLooking at the wrappers:\n- `audit-run.mjs`: Calls `runCompleteAudit`/`runGenericSourceAccounting`/`runAccessibilitySuite`/`prepareAdjudicationBundle` directly. No subprocess. ✓\n- `audit-plan.mjs`: Pure library, no subprocess. ✓ \n- `audit-finalize.mjs`: Imports `finalizeAudit` and `reportToSarif`. The `rerun` metadata references audit-run and audit-verify paths but doesn't execute them. The `main()` is CLI entrypoint. ✓\n- `audit-verify.mjs`: Uses `execFileSync` to run `collect-facts.mjs` (different script). This is the verification replay. It's not subprocess-to-self. ✓\n\nActually, looking more carefully at `audit-finalize.mjs`:\n```javascript\nconst AUDIT_RUN = fileURLToPath(new URL('./audit-run.mjs', import.meta.url));\nconst AUDIT_VERIFY = fileURLToPath(new URL('./audit-verify.mjs', import.meta.url));\n```\nThese are used in the `rerun` field of the report - they're just path references for documentation, not actual executions.\n\nAnd `audit-verify.mjs` uses `execFileSync` with `collect` (collect-facts.mjs), not with itself.\n\nSo none of these are subprocess-to-self. Good.\n\n**B8-003: MCP tools validation**\n\nLooking at `integrations/mcp/tools.mjs`:\n\n1. **Runtime input validation**: `validateArguments` checks required fields, types, enums, min lengths. ✓\n2. **In-process core operations**: `defaultCore()` imports from `lib/core/index.mjs`, `lib/host/index.mjs`, `registry/provider-registry.mjs`. It calls `audit`, `verifyRun`, `inspectProduct` in-process. ✓\n3. **Structured protocol-safe results**: Returns `{ content, structuredContent, isError }`. ✓\n4. **Scope escape rejection**: `safeRoot()` validates paths don't escape host root. `safeArtifactName()` rejects paths with separators. ✓\n5. **Bounded output**: Checks `Buffer.byteLength > maxOutputBytes`. ✓\n\n**MCP resources** (`integrations/mcp/resources.mjs`):\n- Path escape check ✓\n- Byte limit ✓\n\n**Public exports** (`lib/index.mjs`):\n- Explicit named exports ✓\n- `PUBLIC_API_VERSION` and `COMPATIBILITY_SURFACES` are frozen ✓\n- No mutable registry export ✓\n\nWait, but let me look at `lib/index.mjs` more carefully:\n\n```javascript\nexport {\n  SCHEMA_VERSIONS,\n  assertSupportedSchemaVersion,\n  buildAuditPlan,\n  sealPlan,\n  verifyPlanBinding,\n  verifyPlanSeal,\n  verifyPlanSignature,\n  writeAuditPlan,\n} from '../audit-plan.mjs';\n```\n\nThis re-exports from `../audit-plan.mjs` - which is the root-level `audit-plan.mjs`. This is fine as it's explicit.\n\n```javascript\nexport {\n  PROVIDER_PHASES,\n  PROVIDER_ROLES,\n  PROVIDER_STATUS,\n  assertEnum,\n} from '../registry/provider-contracts.mjs';\n```\n\nThis re-exports from `../registry/provider-contracts.mjs`. Fine.\n\nNow let me check for any remaining acceptance gaps more carefully:\n\n1. The MCP test expects exactly 9 tools: `nemesis_audit, nemesis_doctor, nemesis_explain, nemesis_get_finding, nemesis_get_run, nemesis_list_languages, nemesis_list_providers, nemesis_plan, nemesis_verify`. But `listTools()` returns 11 tools including `nemesis_list_families` and `nemesis_list_skills`. The test will fail.\n\nWait, let me re-read the test:\n```javascript\nassert.deepEqual(names, [\n  'nemesis_audit', 'nemesis_doctor', 'nemesis_explain', 'nemesis_get_finding',\n  'nemesis_get_run', 'nemesis_list_languages', 'nemesis_list_providers',\n  'nemesis_plan', 'nemesis_verify',\n]);\n```\n\nThat's 9 tools, but `listTools()` defines 11. The test will fail because `nemesis_list_families` and `nemesis_list_skills` are not in the expected list.\n\nAlso: `assert.equal(list.result.tools.length, 9)` in the stdio test expects9.\n\nThis is a real gap. The MCP test expects 9 tools but the tools.mjs defines 11.\n\nHmm, but the task says \"Do not edit tests.\" So either the tools need to match the test, or the test is wrong. Since I can't edit tests, I need to adjust tools.mjs to match.\n\nWait, but the task says \"Find remaining acceptance gaps\" and \"max 150 changed lines.\" Let me re-read:\n\n> All 11 MCP tools validate runtime inputs, call in-process core operations, return structured protocol-safe results, reject scope escape, & bound output.\n\nThe acceptance criteria says \"All 11 MCP tools\" - but the test expects 9. Let me re-examine the test:\n\nActually, the test says `assert.equal(list.result.tools.length, 9)`. This is for the stdio test which gets tools from `tools/list` server call. The server calls `listTools()` which returns 11. So the test would fail.\n\nBut wait - I'm told \"Do not edit tests.\" This means the current test expects 9 tools but the code has 11. This is an existing inconsistency, not something I should fix by editing the test.\n\nActually, re-reading the task more carefully:\n\n> Current parent delta adds explicit exports, 11 MCP tools, runtime schema validation, safe paths, bounded output, & core dispatch. Find remaining acceptance gaps.\n\nSo the parent delta added 11 tools. But the test expects 9. Maybe the test was written before the 2 new tools were added and hasn't been updated yet. But I can't edit tests.\n\nWait - actually the task says to work on the listed files. Let me see if the test discrepancy is something that existed before or something introduced by my changes. Since I haven't made changes yet, the test discrepancy pre-exists. The test expects 9 tools and code has 11.\n\nOK but the instruction says \"Do not edit tests\" and \"Make only smallest justified corrections, max 150 changed lines.\" Let me focus on what I CAN fix.\n\nLet me identify all actual gaps I can address:\n\n1. **MCP tools test mismatch**: `listTools()` has 11 tools but test expects 9. Since I can't edit tests, this is a **pre-existing blocker** - OR I need to add the 2 tools to the test... but I can't. So either I remove the 2 extra tools (but the acceptance criteria says11 MCP tools), or I acknowledge the test gap.\n\nActually wait - re-reading the task: \"Do not edit tests\" - this is in non_goals. But the acceptance criteria says \"All 11 MCP tools validate...\" This means the 11 tools are the correct target. The test is outdated. Since I can't touch tests, this is a known gap.\n\nActually, I think the situation is:\n- The parent delta added 2 new MCP tools (list_families, list_skills)\n- The test wasn't updated\n- My job is to make the code correct per acceptance criteria\n- The test mismatch is pre-existing\n\nLet me focus on what I can fix in the listed files. Let me look for real bugs:\n\n2. **`validateArguments` doesn't validate `number` type**: In `tools.mjs`, the `validateArguments` function checks `rule.type === 'string'` but not `'number'`. The `nemesis_doctor` and `nemesis_plan` schemas have only string properties. But if any schema had a number type, it wouldn't be validated. Currently none do, so this is a latent issue, not an active bug.\n\n3. **`nemesis_get_run` doesn't call `safeRoot`**: In `invoke()`, `nemesis_get_run` and `nemesis_get_finding` use `hostRoot` directly (from `resolve(context.root ?? process.cwd())`) but don't call `safeRoot`. However, `runArtifactPath` already validates the path doesn't escape root. Let me check more carefully...\n\n```javascript\ncase 'nemesis_get_run': return core.getRun({ ...args, root: hostRoot });\n```\n\n`hostRoot` is `resolve(context.root ?? process.cwd())` - this is already the resolved absolute path. And `getRun` → `runArtifactPath` does its own escape check. So this is OK.\n\nBut `nemesis_explain` also doesn't use `safeRoot` for the run path:\n```javascript\ncase 'nemesis_explain': return core.explain({ ...args, root: hostRoot });\n```\n\nThis is fine because `explain` only reads from a report, and `getRun` already validates.\n\n4. **`listSkills` is hardcoded**: `skills: () => ['designer', 'writing']` - this is hardcoded rather than reading from a registry. This could be a gap if skills are added. But this is pre-existing behavior.\n\n5. **`resources.mjs` doesn't have the `run` parameter validated for path escape independently**: Actually it does - `readResource` resolves the path and checks for escape. But `run` can include directory traversal. Let me check:\n\n```javascript\nconst path = resolve(base, run ?? '', 'report.json');\nconst rel = relative(base, path);\nif (!rel || rel === '..' || rel.startsWith(`..${sep}`)) throw new Error('resource path escapes host root');\n```\n\nThis checks the final resolved path escapes, but `run ?? ''` with a malicious value could access `../../../etc/passwd` as part of the path. Wait, `resolve(base, '../../../etc/passwd', 'report.json')` would resolve to `/etc/passwd` and the escape check would catch it. So this is fine.\n\nActually wait, there's a subtle issue: `rel` check is:\n- `!rel` - if base and path are the same (rel is empty string, which is falsy)\n- `rel === '..'` - up one dir\n- `rel.startsWith('..\\\\')` - starts with parentBut what about `rel === ''` when path equals base? That would mean `resolve(base, run, 'report.json')` equals `base` itself, which is impossible with 'report.json' appended. OK, this check is fine.\n\nLet me now look at what actual fixes are justified:\n\n6. **`audit-finalize.mjs` `rerun` command**: The `rerun` field in the report contains paths to `audit-run.mjs` and `audit-verify.mjs`. This embeds process.self references in the output. For the \"thin wrapper\" goal, this is fine as metadata (not actual subprocess spawning).\n\n7. **`audit-verify.mjs` runs `collect-facts.mjs` via subprocess**: This is the main subprocess call. The verification replay needs to re-run deterministic checks in a fresh environment. This is by design - it's a different script, not self-invocation. Making this an in-process call would be a larger refactor.\n\nOK, let me look at this from a different angle. What actual bugs or gaps exist that I should fix with the smallest justified corrections?\n\nLet me check for concrete issues:\n\na) In `integrations/mcp/tools.mjs`, the `invoke` function for `nemesis_get_run` and `nemesis_get_finding` passes the raw `root` from the context (which is the resolved `hostRoot`), but the user's `args.root` isn't used. This is correct since these are artifact-read tools that should use the host root.\n\nb) But wait - `nemesis_get_run` doesn't validate that the `run` argument is a string and non-empty before passing it to `getRun`. The `validateArguments` function checks `required: ['run']` but doesn't validate the type (it's in `properties` with `{ type: 'string', minLength: 1 }` but the validation code only checks `string` type and `minLength` for keys present in args). Let me trace through:\n\n```javascript\nvalidateArguments(tool.inputSchema, args ?? {})\n```\n\nFor `nemesis_get_run`, schema is:\n```javascript\nclosedInput({ run: { type: 'string', minLength: 1 }, artifact: { type: 'string' } }, ['run'])\n```\n\n`closedInput` produces:\n```javascript\n{ type: 'object', required: ['run'], additionalProperties: false, properties: { run: { type: 'string', minLength: 1 }, artifact: { type: 'string' } } }\n```\n\nIn `validateArguments`:\n- Check args is object ✓\n- Check no extra keys (only 'run' and 'artifact' allowed) ✓\n- Check required ['run'] is present ✓\n- For 'run': type is 'string', checks `typeof args['run'] !== 'string'` ✓, checks `minLength` ✓\n- For 'artifact': type is 'string', checks `typeof args['artifact'] !== 'string'` ✓\n\nBut if someone passes `artifact: 42`, the type check catches it. If `artifact` is not provided, it's fine since it's not required. \n\nWait, but what if `args` has no 'artifact' key? Then `!(key in args)` is true for 'artifact', so it skips. That's correct.\n\nOK, the validation seems comprehensive.\n\nc) One issue I notice: `safeRoot` doesn't check for null bytes in the absolute path, only in the `requested` string. But since `resolve` doesn't handle null bytes specially on all platforms, and the `requested` check does `requested.includes('\\0')`, this should be sufficient.\n\nLet me now look for what I can actually fix to close acceptance gaps. The main issues I see:\n\n1. **The test expects 9 tools but code has 11** - I cannot fix this (can't edit tests). This is a pre-existing gap.\n\n2. **`validateArguments` doesn't validate `number` type** - latent, not active since no schemas have numbers.\n\n3. **`listSkills()` is hardcoded** - pre-existing, but could be made dynamic.\n\nActually, wait. Let me re-read the task instructions very carefully:\n\n> Review & complete DISPATCH-07 tasks B8-001 & B8-003\n\n> B8-001: Compatibility wrappers have no subprocess-to-self or independent orchestration where achievable inside Own.\n> B8-003: All 11 MCP tools validate runtime inputs, call in-process core operations, return structured protocol-safe results, reject scope escape, & bound output.\n\nFor B8-001, I need to check if any compatibility wrappers (audit-run.mjs, audit-plan.mjs, audit-finalize.mjs, audit-verify.mjs) have subprocess-to-self. I've already checked - none do. audit-verify.mjs has subprocess to collect-facts.mjs (different file).\n\nBut wait - should I also check if these wrappers can be made thinner? The task says \"without subprocess-to-self or independent orchestration where achievable inside Own.\" \n\nLooking at `audit-run.mjs`:\n- It calls `runCompleteAudit`, `runGenericSourceAccounting`, `runAccessibilitySuite`, `prepareAdjudicationBundle` - these are in-process calls\n- No subprocess, no orchestration that duplicates core logic\n- It IS a standalone CLI script with its own main()\n\nFor B8-001, the concern is \"independent orchestration\" - does the CLI script orchestrate things that the core already orchestrates? Looking at `audit-run.mjs::main()`:\n- Calls `runAuditProviders` which is the main orchestration\n- `runAuditProviders` calls `runCompleteAudit` (from audit-complete.mjs), then runs additional providers inline\n- This IS independent orchestration that could potentially be moved into core\n\nBut the task says \"where achievable inside Own\" and \"If B8-001 cannot become thin wrappers without paths outside Own, report typed blocker instead of editing outside scope.\"\n\n`audit-complete.mjs` is NOT in the allowed edit files list. The core path for running an audit is `lib/core/audit.mjs::audit()` which does everything in-process. The CLI `audit-run.mjs` has its own parallel orchestration via `audit-complete.mjs`.\n\nSo B8-001 has a blocker: the CLI scripts (`audit-run.mjs`, `audit-verify.mjs`) have independent orchestration that overlaps with `lib/core/audit.mjs`, but the underlying modules they depend on (`audit-complete.mjs`, `collect-facts.mjs`) are outside the allowed edit scope.\n\nFor B8-003, the MCP tools already look correct per the criteria. Let me verify once more:\n\n1. All 11 tools validate runtime inputs ✓ (via `validateArguments`)\n2. Call in-process core operations ✓ (via `defaultCore()` which imports from `lib/core/index.mjs`)\n3. Return structured protocol-safe results ✓ (JSON serialization + output byte limit)\n4. Reject scope escape ✓ (via `safeRoot()` and `safeArtifactName()` and `runArtifactPath()`)\n5. Bound output ✓ (via `Buffer.byteLength > maxOutputBytes` check)\n\nBut wait - let me check if ALL 11 tools properly validate. Looking at `invoke`:\n\n```javascript\ncase 'nemesis_doctor':\ncase 'nemesis_plan':\ncase 'nemesis_audit':\ncase 'nemesis_verify': {\n  const root = safeRoot(hostRoot, args.root ?? '.');\n  ...\n}\ncase 'nemesis_list_providers': ...\ncase 'nemesis_list_languages': ...\ncase 'nemesis_list_families': ...\ncase 'nemesis_list_skills': ...\ncase 'nemesis_explain': ...\ncase 'nemesis_get_run': ...\ncase 'nemesis_get_finding': ...\n```\n\nFor the list tools, there are no inputs to validate beyond what `validateArguments` does (empty or near-empty schemas). ✓\n\nFor `nemesis_explain` - it doesn't validate that `args.id` is a string. But `validateArguments` checks `{ required: ['id'], properties: { id: { type: 'string', minLength: 1 } } }` - so it does validate. ✓\n\nFor `nemesis_get_run` and `nemesis_get_finding` - same, validation is in `validateArguments`. ✓\n\nBut wait - `nemesis_explain` and `nemesis_get_run` and `nemesis_get_finding` don't call `safeRoot` - they use `hostRoot` directly. This means if someone passes a `run` argument with path traversal, it goes directly into `getRun` or `explain` without the host-root check. Let me verify...\n\n`nemesis_explain`: `core.explain({ ...args, root: hostRoot })` - the `explain` function in `defaultCore` does:\n```javascript\nexplain: ({ root, run, id }) => {\n  const report = run ? getRun({ root, run }).content : {};\n  ...\n}\n```\n\nAnd `getRun` calls `runArtifactPath` which checks for escape. ✓\n\n`nemesis_get_run`: `core.getRun({ ...args, root: hostRoot })` → `getRun` → `runArtifactPath` which checks for escape. ✓\n\n`nemesis_get_finding`: same chain. ✓\n\nOK so scope escape is handled by the underlying functions even when `safeRoot` isn't called at the tool level for these specific tools. The validation is still present, just at a different layer.\n\nLet me now think about what actual changes would be justified. \n\nLooking more carefully, I see a potential issue:\n\nIn `tools.mjs`, the `validateArguments` function validates types, but when `args` contains `root` for `nemesis_explain`/`nemesis_get_run`/`nemesis_get_finding`, the `root` is not in the schema's properties (these use `closedInput` which doesn't include `root`). But `validateArguments` already rejects unknown keys:\n\n```javascript\nconst extra = Object.keys(args).filter((key) => !allowed.has(key));\nif (extra.length) throw new Error(`unexpected tool argument: ${extra[0]}`);\n```\n\nSo if someone passes `root: '/etc'` to `nemesis_get_run`, it would be rejected. But `nemesis_explain` has `run` and `id` as properties, not `root`. And in `invoke`, `nemesis_explain` passes `{ ...args, root: hostRoot }`, so the root comes from the context, not from user args. ✓\n\nWait - but `nemesis_get_run` schema has:\n```javascript\nclosedInput({ run: { type: 'string', minLength: 1 }, artifact: { type: 'string' } }, ['run'])\n```\n\nAnd `validateArguments` would reject any key not in `properties`, which are `run` and `artifact`. So the user cannot inject a `root` key. ✓\n\nOK, I think the MCP tools are actually in good shape. Let me look for smaller issues.\n\nActually, I just noticed something in `validateArguments`:\n\n```javascript\nif (rule.type === 'string' && (typeof args[key] !== 'string' || (rule.minLength && args[key].length < rule.minLength)))\n```\n\nIf `rule.minLength` is 0, it would still check `args[key].length < 0` which is always false. That's fine. But if `rule.type` is missing (which it can be for some schema properties), no type check happens. Looking at the schemas, `priorRun` in `nemesis_verify` doesn't have a `type` property:\n\n```javascript\n{ name: 'nemesis_verify', description: 'Verify a prior run out of band.', inputSchema: rootInput({ priorRun: {} }) }\n```\n\n`priorRun: {}` has no `type` constraint. So someone could pass `priorRun: 42` and it wouldn't be caught. This is a minor validation gap.\n\nLet me look at what other issues I can find:\n\nIn `audit-plan.mjs`, the `writeAuditPlan` function uses `writeFileSync` (from `node:fs`), which is a sync filesystem write. This is already a library function.\n\nIn `audit-finalize.mjs`, the `finalizeAudit` function is already a pure function (no I/O, no subprocess). The CLI `main()` does file I/O. ✓\n\nLet me look at a very specific thing - the `lib/index.mjs` exports. It re-exports from `../audit-plan.mjs`:\n\n```javascript\nexport {\n  SCHEMA_VERSIONS,\n  assertSupportedSchemaVersion,\n  buildAuditPlan,\n  sealPlan,\n  verifyPlanBinding,\n  verifyPlanSeal,\n  verifyPlanSignature,\n  writeAuditPlan,\n} from '../audit-plan.mjs';\n```\n\nAnd from `../registry/provider-contracts.mjs`:\n```javascript\nexport {\n  PROVIDER_PHASES,\n  PROVIDER_ROLES,\n  PROVIDER_STATUS,\n  assertEnum,\n} from '../registry/provider-contracts.mjs';\n```\n\nThe `assertEnum` export - does this function exist in `provider-contracts.mjs`? Let me check."}}
