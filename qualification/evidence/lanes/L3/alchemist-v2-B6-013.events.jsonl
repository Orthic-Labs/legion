, start), text.lastIndexOf('!', start), text.lastIndexOf('?', start)) + 1;\n49:  const rightCandidates = [text.indexOf('.', end), text.indexOf('!', end), text.indexOf('?', end)].filter((index) => index >= 0);\n50:  const right = rightCandidates.length ? Math.min(...rightCandidates) + 1 : text.length;\n51:  return text.slice(left, right).trim();\n52:}\n54:function hasPersonalizationEvidence(item) {\n55:  return Boolean(\n56:    item.personalizationRefs?.length\n57:    || item.constraints?.personalizationEvidence?.length\n58:    || item.constraints?.personalizedBy\n59:    || item.surface?.personalization,\n60:  );\n61:}\n63:function isCtaContext(item) {\n64:  const role = contextFor(item).role.toLocaleLowerCase();\n65:  const purpose = String(item.purpose ?? '').toLocaleLowerCase();\n66:  return ['button', 'link', 'cta'].includes(role)\n67:    || Boolean(item.desiredAction)\n68:    || /\\b(?:cta|call to action|prompt|invite|signup|sign up|conversion|action)\\b/.test(purpose);\n69:}\n71:function featureMatch(rule, text, item, options, duplicateCounts) {\n72:  if (rule.match) return rule.match(text, item, options, duplicateCounts);\n73:  return text.match(rule.pattern);\n74:}\n76:function candidate(item, rule, span, reason, proofRefs, denominatorDigest, binding, options = {}) {\n77:  const featureVector = {\n78:    feature: rule.feature,\n79:    span,\n80:    context: contextFor(item),\n81:    claimType: item.claimRefs?.length ? 'bound-claim' : 'unbound-copy',\n82:    surroundingSentence: sentenceFor(item.text ?? '', span),\n83:    technicalUseExcluded: technicalTerm(item, span, options),\n84:    personalizationEvidenceBound: hasPersonalizationEvidence(item),\n85:  };\n86:  const base = {\n87:    schemaVersion: 1,\n88:    kind: 'nemesis-copy-candidate',\n89:    producer: PROVIDER,\n90:    provider: PROVIDER,\n91:    providerVersion: '1.0.0',\n92:    ruleId: rule.id,\n93:    dimension: rule.dimension,\n94:    contentItemIds: [item.id],\n95:    claim: `${rule.claim} becau