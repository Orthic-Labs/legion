/\\b(?:at the end of the day|it goes without saying|when it comes to|for all intents and purposes|in order to|as you know|basically|simply)\\b/i,\n225:    reason: 'the phrase can be removed without changing the copy\\'s information',\n226:  },\n227:];\n229:export function detectAntiSlop(items = [], options = {}) {\n230:  const binding = options.binding ?? {};\n231:  const denominator = { kind: 'user-visible-content-items', expected: items.length, examined: items.length };\n232:  const denominatorDigest = digest(items.map(({ id, textDigest, text }) => [id, textDigest ?? digest(text ?? '')]));\n233:  const proofByClaim = new Map((options.claimProofLedger?.claims ?? []).map((claim) => [claim.id, claim]));\n234:  const duplicateCounts = new Map();\n235:  for (const item of items) {\n236:    const normalized = (item.text ?? '').toLocaleLowerCase().replace(/\\s+/g, ' ').trim();\n237:    duplicateCounts.set(normalized, (duplicateCounts.get(normalized) ?? 0) + 1);\n238:  }\n239:  const candidates = [];\n240:  const findings = [];\n242:  for (const item of items) {\n243:    const text = item.text ?? '';\n244:    for (const ban of options.explicitBans ?? []) {\n245:      const match = text.match(new RegExp(escaped(ban.phrase), 'i'));\n246:      if (match) findings.push({\n247:        ruleId: ban.id,\n248:        detectorKind: 'deterministic',\n249:        contentItemIds: [item.id],\n250:        span: match[0],\n251:        evidenceRefs: item.evidenceRefs ?? [],\n252:        binding,\n253:      });\n254:    }\n256:    if (text.trim().split(/\\s+/).length < 4 || !hasContext(item)) continue;\n257:    for (const rule of INTERPRETIVE_RULES) {\n258:      if (rule.id === 'copy.anti-slop.fake-personalization' && hasPersonalizationEvidence(item)) continue;\n259:      const match = featureMatch(rule, text, item, options, duplicateCounts);\n260:      const span = match?.[1] ?? match?.[0];\n261:      if (match && span && !technicalTerm(item, span, options)) {\n262:        candidates.push