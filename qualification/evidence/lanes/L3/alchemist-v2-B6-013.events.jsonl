{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command '$test = @'\"'\nimport test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nimport { fileURLToPath } from 'node:url';\nimport { dirname, join } from 'node:path';\nimport { detectAntiSlop } from '../providers/copy/anti-slop.mjs';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = dirname(__filename);\n\nconst binding = { repository: 'sha256:b6-013-test' };\n\nfunction fixtureItems() {\n  return JSON.parse(readFileSync(join(__dirname, '..', 'bench', 'corpora', 'copy', 'anti-slop', 'fixture-items.json'), 'utf8'));\n}\n\n// ──────────────────────────────────────────────────────────\n// 1. Generic opener detection\n// ──────────────────────────────────────────────────────────\ntest('B6-013 generic-opener: detects generic opening phrases', () => {\n  const result = detectAntiSlop([{\n    id: 'test:gen-opener',\n    text: \\\"In today's fast-paced digital world, every team needs better tools.\\\",\n    surface: { type: 'paragraph' },\n    audience: 'eng leaders',\n    purpose: 'introduce product',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.ok(result.candidates.some(c => c.ruleId === 'copy.anti-slop.generic-opener'),\n    'should detect generic opener');\n});\n\ntest('B6-013 generic-opener: technical near-miss is not flagged', () => {\n  const result = detectAntiSlop([{\n    id: 'test:gen-tech',\n    text: 'In this ever-changing digital world of version control, Git remains dominant.',\n    surface: { type: 'documentation' },\n    audience: 'developers',\n    purpose: 'explain version control landscape',\n    constraints: { technicalTerms: ['version control', 'Git'], technicalUse: true },\n    evidenceRefs: ['evidence:git-doc'],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.generic-opener' && c.contentItemIds.includes('test:gen-tech')), false,\n    'technical use should not be flagged');\n});\n\n// ──────────────────────────────────────────────────────────\n// 2. Empty intensifier detection\n// ──────────────────────────────────────────────────────────\ntest('B6-013 empty-intensifier: detects intensifier without measurable qualifier', () => {\n  const result = detectAntiSlop([{\n    id: 'test:empty-int',\n    text: 'Our incredibly fast parser makes development easy.',\n    surface: { type: 'paragraph' },\n    audience: 'developers',\n    purpose: 'describe capability',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.ok(result.candidates.some(c => c.ruleId === 'copy.anti-slop.empty-intensifier'),\n    'should detect empty intensifier');\n});\n\ntest('B6-013 empty-intensifier: measured qualifier suppresses finding', () => {\n  const result = detectAntiSlop([{\n    id: 'test:measured-int',\n    text: 'Our incredibly fast parser processes 12,000 events per second.',\n    surface: { type: 'paragraph' },\n    audience: 'engineers',\n    purpose: 'describe throughput',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.empty-intensifier' && c.contentItemIds.includes('test:measured-int')), false,\n    'measured qualifier should suppress');\n});\n\ntest('B6-013 empty-intensifier: technicalUse=true suppresses finding', () => {\n  const result = detectAntiSlop([{\n    id: 'test:tech-int',\n    text: 'The incredibly low-latency path handles p99 in under 3 ms.',\n    surface: { type: 'documentation' },\n    audience: 'platform engineers',\n    purpose: 'document performance',\n    constraints: { technicalTerms: ['low-latency'], technicalUse: true },\n    evidenceRefs: ['evidence:perf-doc'],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.empty-intensifier' && c.contentItemIds.includes('test:tech-int')), false,\n    'technicalUse should suppress');\n});\n\n// ──────────────────────────────────────────────────────────\n// 3. Unsupported superlative\n// ──────────────────────────────────────────────────────────\ntest('B6-013 unsupported-superlative: flags superlative without bound claims', () => {\n  const result = detectAntiSlop([{\n    id: 'test:supper',\n    text: 'We are the best analytics platform on the market.',\n    surface: { type: 'paragraph' },\n    audience: 'prospects',\n    purpose: 'establish position',\n    claimRefs: ['claim:pos'],\n    evidenceRefs: [],\n    binding,\n  }], {\n    claimProofLedger: { claims: [{ id: 'claim:pos', disposition: 'unproven', evidenceRefs: [] }] },\n    binding,\n  });\n  assert.ok(result.candidates.some(c => c.ruleId === 'copy.anti-slop.unsupported-superlative'),\n    'should detect unsupported superlative');\n});\n\ntest('B6-013 unsupported-superlative: bound claim suppresses finding', () => {\n  const result = detectAntiSlop([{\n    id: 'test:supper-bound',\n    text: 'We are the fastest query engine in benchmarks.',\n    surface: { type: 'paragraph' },\n    audience: 'prospects',\n    purpose: 'establish position',\n    claimRefs: ['claim:fastest'],\n    evidenceRefs: [],\n    binding,\n  }], {\n    claimProofLedger: { claims: [{ id: 'claim:fastest', disposition: 'bound', evidenceRefs: ['evidence:bench'] }] },\n    binding,\n  });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.unsupported-superlative' && c.contentItemIds.includes('test:supper-bound')), false,\n    'bound claim should suppress');\n});\n\ntest('B6-013 unsupported-superlative: technicalUse=true suppresses finding', () => {\n  const result = detectAntiSlop([{\n    id: 'test:supper-tech',\n    text: 'Select the best-fit algorithm for this data set.',\n    surface: { type: 'documentation' },\n    audience: 'data engineers',\n    purpose: 'give configuration instruction',\n    constraints: { technicalTerms: ['best-fit'], technicalUse: true },\n    evidenceRefs: ['evidence:algo'],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.unsupported-superlative' && c.contentItemIds.includes('test:supper-tech')), false,\n    'technicalUse should suppress');\n});\n\n// ──────────────────────────────────────────────────────────\n// 4. Interchangeable competitor copy\n// ──────────────────────────────────────────────────────────\ntest('B6-013 interchangeable-competitor-copy: detects generic comparison', () => {\n  const result = detectAntiSlop([{\n    id: 'test:competitor',\n    text: 'Better than competitors and ahead of the rest.',\n    surface: { type: 'paragraph' },\n    audience: 'buyers',\n    purpose: 'compare to market',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.ok(result.candidates.some(c => c.ruleId === 'copy.anti-slop.interchangeable-competitor-copy'),\n    'should detect generic competitor comparison');\n});\n\ntest('B6-013 interchangeable-competitor-copy: named competitor with differentiator suppresses', () => {\n  const result = detectAntiSlop([{\n    id: 'test:competitor-named',\n    text: 'Unlike Datadog, our agent uses 60% less memory on equivalent workloads.',\n    surface: { type: 'paragraph' },\n    audience: 'SREs',\n    purpose: 'compare specific capability',\n    constraints: { competitorNames: ['Datadog'] },\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.interchangeable-competitor-copy' && c.contentItemIds.includes('test:competitor-named')), false,\n    'named competitor with bounded outcome should not be flagged as generic');\n});\n\n// ──────────────────────────────────────────────────────────\n// 5. Passive unspecific CTA\n// ──────────────────────────────────────────────────────────\ntest('B6-013 passive-unspecific-cta: detects passive language in CTA context', () => {\n  const result = detectAntiSlop([{\n    id: 'test:cta-passive',\n    text: 'Your experience can be transformed with our solution.',\n    surface: { type: 'button' },\n    audience: 'users',\n    purpose: 'call to action',\n    desiredAction: 'sign up',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.ok(result.candidates.some(c => c.ruleId === 'copy.anti-slop.passive-unspecific-cta'),\n    'should detect passive CTA');\n});\n\ntest('B6-013 passive-unspecific-cta: active CTA is not flagged', () => {\n  const result = detectAntiSlop([{\n    id: 'test:cta-active',\n    text: 'Start your free trial today.',\n    surface: { type: 'button' },\n    audience: 'users',\n    purpose: 'call to action',\n    desiredAction: 'start trial',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.passive-unspecific-cta' && c.contentItemIds.includes('test:cta-active')), false,\n    'active CTA should not be flagged');\n});\n\ntest('B6-013 passive-unspecific-cta: non-CTA context suppresses finding', () => {\n  const result = detectAntiSlop([{\n    id: 'test:not-cta',\n    text: 'The dashboard can be configured to display custom metrics.',\n    surface: { type: 'documentation' },\n    audience: 'operators',\n    purpose: 'explain configuration options',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.passive-unspecific-cta' && c.contentItemIds.includes('test:not-cta')), false,\n    'non-CTA context should not be flagged');\n});\n\n// ──────────────────────────────────────────────────────────\n// 6. Abstract benefit stacking\n// ──────────────────────────────────────────────────────────\ntest('B6-013 abstract-benefit-stacking: detects three or more abstract terms', () => {\n  const result = detectAntiSlop([{\n    id: 'test:stacking',\n    text: 'Drive success through innovation and growth, unlocking value, excellence, and potential.',\n    surface: { type: 'paragraph' },\n    audience: 'leaders',\n    purpose: 'inspire',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.ok(result.candidates.some(c => c.ruleId === 'copy.anti-slop.abstract-benefit-stacking'),\n    'should detect abstract benefit stacking');\n});\n\ntest('B6-013 abstract-benefit-stacking: two abstract terms is not flagged', () => {\n  const result = detectAntiSlop([{\n    id: 'test:two-abstract',\n    text: 'We focus on innovation and growth for our customers.',\n    surface: { type: 'paragraph' },\n    audience: 'leaders',\n    purpose: 'state strategy',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.abstract-benefit-stacking' && c.contentItemIds.includes('test:two-abstract')), false,\n    'two abstract terms should not trigger stacking');\n});\n\n// ──────────────────────────────────────────────────────────\n// 7. Template repetition\n// ──────────────────────────────────────────────────────────\ntest('B6-013 template-repetition: detects duplicate content across items', () => {\n  const result = detectAntiSlop([\n    {\n      id: 'test:rep-a',\n      text: 'We help teams unlock their potential with solutions that inspire confidence.',\n      surface: { type: 'paragraph' },\n      audience: 'managers',\n      purpose: 'explain value',\n      claimRefs: [],\n      evidenceRefs: [],\n      binding,\n    },\n    {\n      id: 'test:rep-b',\n      text: 'We help teams unlock their potential with solutions that inspire confidence.',\n      surface: { type: 'paragraph' },\n      audience: 'managers',\n      purpose: 'explain value',\n      claimRefs: [],\n      evidenceRefs: [],\n      binding,\n    },\n  ], { binding });\n  const repCandidates = result.candidates.filter(c => c.ruleId === 'copy.anti-slop.template-repetition');\n  assert.ok(repCandidates.length >= 1, 'should detect template repetition');\n  assert.ok(repCandidates.some(c => c.contentItemIds.includes('test:rep-a')), 'should include first copy');\n  assert.ok(repCandidates.some(c => c.contentItemIds.includes('test:rep-b')), 'should include second copy');\n});\n\ntest('B6-013 template-repetition: unique content is not flagged', () => {\n  const result = detectAntiSlop([\n    {\n      id: 'test:uniq-a',\n      text: 'The parser handles JSON, YAML, and TOML with configurable error recovery.',\n      surface: { type: 'paragraph' },\n      audience: 'engineers',\n      purpose: 'describe format support',\n      claimRefs: [],\n      evidenceRefs: [],\n      binding,\n    },\n    {\n      id: 'test:uniq-b',\n      text: 'Error recovery modes include strict, lenient, and skip-and-log.',\n      surface: { type: 'paragraph' },\n      audience: 'engineers',\n      purpose: 'describe recovery modes',\n      claimRefs: [],\n      evidenceRefs: [],\n      binding,\n    },\n  ], { binding });\n  assert.equal(result.candidates.some(c => c.ruleId === 'copy.anti-slop.template-repetition'), false,\n    'unique content should not trigger repetition');\n});\n\n// ──────────────────────────────────────────────────────────\n// 8. Fake personalization\n// ──────────────────────────────────────────────────────────\ntest('B6-013 fake-personalization: detects unbound personalization language', () => {\n  const result = detectAntiSlop([{\n    id: 'test:fake-pers',\n    text: 'This recommendation was made just for you based on your interests.',\n    surface: { type: 'hint' },\n    audience: 'end users',\n    purpose: 'surface suggestion',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.ok(result.candidates.some(c => c.ruleId === 'copy.anti-slop.fake-personalization'),\n    'should detect fake personalization');\n});\n\ntest('B6-013 fake-personalization: bound personalization evidence suppresses', () => {\n  const result = detectAntiSlop([{\n    id: 'test:bound-pers',\n    text: 'This recommendation was made just for you based on your search history.',\n    surface: { type: 'hint' },\n    audience: 'end users',\n    purpose: 'surface suggestion',\n    personalizationRefs: ['behavior:recent-search'],\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.fake-personalization' && c.contentItemIds.includes('test:bound-pers')), false,\n    'bound personalization evidence should suppress');\n});\n\n// ──────────────────────────────────────────────────────────\n// 9. Vague transformation claims\n// ──────────────────────────────────────────────────────────\ntest('B6-013 vague-transformation: detects transformation without mechanism or outcome', () => {\n  const result = detectAntiSlop([{\n    id: 'test:vague',\n    text: 'Transform your business with our innovative approach.',\n    surface: { type: 'paragraph' },\n    audience: 'executives',\n    purpose: 'motivate adoption',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.ok(result.candidates.some(c => c.ruleId === 'copy.anti-slop.vague-transformation'),\n    'should detect vague transformation');\n});\n\ntest('B6-013 vague-transformation: mechanism + outcome suppresses finding', () => {\n  const result = detectAntiSlop([{\n    id: 'test:vague-bound',\n    text: 'Transform your CI pipeline with GitHub Actions to cut build times by 40%.',\n    surface: { type: 'paragraph' },\n    audience: 'devops engineers',\n    purpose: 'advise on CI',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.vague-transformation' && c.contentItemIds.includes('test:vague-bound')), false,\n    'mechanism + outcome should suppress');\n});\n\n// ──────────────────────────────────────────────────────────\n// 10. Informational filler\n// ──────────────────────────────────────────────────────────\ntest('B6-013 informational-filler: detects filler phrases', () => {\n  const result = detectAntiSlop([{\n    id: 'test:filler',\n    text: 'At the end of the day, the tool generates a report you can review.',\n    surface: { type: 'paragraph' },\n    audience: 'operators',\n    purpose: 'explain outcome',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.ok(result.candidates.some(c => c.ruleId === 'copy.anti-slop.informational-filler'),\n    'should detect informational filler');\n});\n\ntest('B6-013 informational-filler: content without filler is not flagged', () => {\n  const result = detectAntiSlop([{\n    id: 'test:no-filler',\n    text: 'The report includes CPU, memory, and network utilization per container.',\n    surface: { type: 'paragraph' },\n    audience: 'operators',\n    purpose: 'document report contents',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.informational-filler' && c.contentItemIds.includes('test:no-filler')), false,\n    'content without filler should not be flagged');\n});\n\n// ──────────────────────────────────────────────────────────\n// 11. Single word / short text guard (4-word minimum)\n// ──────────────────────────────────────────────────────────\ntest('B6-013 short text guard: items under 4 words produce no interpretive candidates', () => {\n  const result = detectAntiSlop([\n    { id: 'test:short-1', text: 'Revolutionary', surface: { type: 'heading' }, audience: 'buyers', purpose: 'label', binding },\n    { id: 'test:short-2', text: 'Incredible results', surface: { type: 'heading' }, audience: 'buyers', purpose: 'label', binding },\n    { id: 'test:short-3', text: 'Best-in-class', surface: { type: 'heading' }, audience: 'buyers', purpose: 'label', binding },\n  ], { binding });\n  const interpretive = result.candidates.filter(c => c.detectorKind === 'interpretive');\n  assert.equal(interpretive.length, 0, 'short text should not produce interpretive candidates');\n});\n\n// ──────────────────────────────────────────────────────────\n// 12. Context requirement: missing audience/purpose suppresses interpretive candidates\n// ──────────────────────────────────────────────────────────\ntest('B6-013 context requirement: items missing audience and purpose produce no interpretive candidates', () => {\n  const result = detectAntiSlop([{\n    id: 'test:no-context',\n    text: \\\"In today's fast-paced world, our platform delivers truly incredible results with guaranteed outcomes.\\\",\n    surface: { type: 'paragraph' },\n    binding,\n  }], { binding });\n  const interpretive = result.candidates.filter(c => c.detectorKind === 'interpretive');\n  assert.equal(interpretive.length, 0, 'missing context should suppress all interpretive candidates');\n});\n\n// ──────────────────────────────────────────────────────────\n// 13. Deterministic findings are exclusive to explicitBans\n// ──────────────────────────────────────────────────────────\ntest('B6-013 no interpretive rule produces a deterministic finding', () => {\n  const result = detectAntiSlop([{\n    id: 'test:determ-check',\n    text: \\\"In today's fast-paced digital world, our best platform transforms your experience with incredible impact.\\\",\n    surface: { type: 'paragraph' },\n    audience: 'everyone',\n    purpose: 'everything',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  const deterministic = result.findings.filter(f => f.detectorKind === 'deterministic');\n  assert.equal(deterministic.length, 0, 'interpretive rules should not produce deterministic findings');\n  assert.ok(result.candidates.length > 0, 'should have interpretive candidates');\n});\n\ntest('B6-013 explicitBans produce deterministic findings only', () => {\n  const result = detectAntiSlop([{\n    id: 'test:ban-only',\n    text: 'Guaranteed returns are expected.',\n    surface: { type: 'paragraph' },\n    audience: 'investors',\n    purpose: 'project returns',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], {\n    explicitBans: [{ id: 'claims.no-guaranteed-profit', phrase: 'guaranteed returns' }],\n    binding,\n  });\n  assert.equal(result.findings.length, 1);\n  assert.equal(result.findings[0].detectorKind, 'deterministic');\n  assert.equal(result.findings[0].ruleId, 'claims.no-guaranteed-profit');\n});\n\n// ──────────────────────────────────────────────────────────\n// 14. Feature vectors on every candidate\n// ──────────────────────────────────────────────────────────\ntest('B6-013 every candidate carries a complete feature vector', () => {\n  const result = detectAntiSlop([{\n    id: 'test:fv',\n    text: \\\"In today's fast-paced world, our best-in-class platform provides truly excellent service.\\\",\n    surface: { type: 'paragraph' },\n    audience: 'operators',\n    purpose: 'describe platform',\n    claimRefs: ['claim:quality'],\n    evidenceRefs: [],\n    binding,\n  }], {\n    claimProofLedger: { claims: [{ id: 'claim:quality', disposition: 'unproven', evidenceRefs: [] }] },\n    binding,\n  });\n  assert.ok(result.candidates.length > 0);\n  for (const c of result.candidates) {\n    const fv = c.featureVector;\n    assert.ok(fv, \"'`candidate ${c.ruleId} must have featureVector`);\n    assert.ok(fv.feature, `featureVector must have feature`);\n    assert.ok(fv.span, `featureVector must have span`);\n    assert.ok(typeof fv.context === '\"'object', 'featureVector.context must be object');\n    assert.ok(fv.claimType === 'bound-claim' || fv.claimType === 'unbound-copy', 'claimType must be bound-claim or unbound-copy');\n    assert.ok(typeof fv.surroundingSentence === 'string', 'featureVector.surroundingSentence must be string');\n    assert.ok(typeof fv.technicalUseExcluded === 'boolean', 'featureVector.technicalUseExcluded must be boolean');\n    assert.ok(typeof fv.personalizationEvidenceBound === 'boolean', 'featureVector.personalizationEvidenceBound must be boolean');\n  }\n});\n\n// ──────────────────────────────────────────────────────────\n// 15. Candidate claim includes \\\"because\\\" clause\n// ──────────────────────────────────────────────────────────\ntest('B6-013 candidate claims explain why copy is generic or unsupported', () => {\n  const result = detectAntiSlop([\n    { id: 'test:why-a', text: \\\"In today's fast-paced world, our product leads the market.\\\", surface: { type: 'paragraph' }, audience: 'users', purpose: 'introduce', claimRefs: [], evidenceRefs: [], binding },\n    { id: 'test:why-b', text: 'Our incredibly powerful engine changes everything.', surface: { type: 'paragraph' }, audience: 'users', purpose: 'describe', claimRefs: [], evidenceRefs: [], binding },\n    { id: 'test:why-c', text: 'At the end of the day, we provide solutions for your needs.', surface: { type: 'paragraph' }, audience: 'users', purpose: 'explain', claimRefs: [], evidenceRefs: [], binding },\n  ], { binding });\n  assert.ok(result.candidates.length >= 3);\n  for (const c of result.candidates) {\n    assert.ok(c.claim.includes('because'), \"'`claim must include '\"'because': \"'${c.claim}`);\n    assert.ok(c.claim.length > 30, `claim should be explanatory, not terse: ${c.claim}`);\n  }\n});\n\n// ──────────────────────────────────────────────────────────\n// 16. Fixture corpus round-trip\n// ──────────────────────────────────────────────────────────\ntest('\"'B6-013 fixture corpus produces expected rule coverage', () => {\n  const items = fixtureItems();\n  const result = detectAntiSlop(items, {\n    claimProofLedger: { claims: [{ id: 'claim:market-position', disposition: 'unproven', evidenceRefs: [] }] },\n    binding,\n  });\n  const ruleIds = new Set(result.candidates.map(c => c.ruleId));\n  assert.ok(ruleIds.has('copy.anti-slop.generic-opener'), 'corpus should cover generic-opener');\n  assert.ok(ruleIds.has('copy.anti-slop.empty-intensifier'), 'corpus should cover empty-intensifier');\n  assert.ok(ruleIds.has('copy.anti-slop.fake-personalization'), 'corpus should cover fake-personalization');\n  assert.ok(ruleIds.has('copy.anti-slop.vague-transformation'), 'corpus should cover vague-transformation');\n  assert.ok(ruleIds.has('copy.anti-slop.unsupported-superlative'), 'corpus should cover unsupported-superlative');\n  assert.ok(ruleIds.has('copy.anti-slop.interchangeable-competitor-copy'), 'corpus should cover interchangeable-competitor-copy');\n  assert.ok(ruleIds.has('copy.anti-slop.passive-unspecific-cta'), 'corpus should cover passive-unspecific-cta');\n  assert.ok(ruleIds.has('copy.anti-slop.abstract-benefit-stacking'), 'corpus should cover abstract-benefit-stacking');\n  assert.ok(ruleIds.has('copy.anti-slop.template-repetition'), 'corpus should cover template-repetition');\n  assert.ok(ruleIds.has('copy.anti-slop.informational-filler'), 'corpus should cover informational-filler');\n\n  // Near-miss items should NOT produce candidates\n  const nearMissIds = items\n    .filter(i => i.id.startsWith('fixture:near-miss'))\n    .map(i => i.id);\n  for (const nm of nearMissIds) {\n    assert.equal(result.candidates.some(c => c.contentItemIds.includes(nm)), false,\n      \"'`near-miss item ${nm} should not produce a candidate`);\n  }\n});\n\n// ──────────────────────────────────────────────────────────\n// 17. Binding is preserved through candidate output\n// ──────────────────────────────────────────────────────────\ntest('\"'B6-013 binding is forwarded to every candidate and finding', () => {\n  const customBinding = { repository: 'sha256:binding-test' };\n  const result = detectAntiSlop([{\n    id: 'test:bind',\n    text: \\\"In today's ever-changing world, our remarkable platform leads the market.\\\",\n    surface: { type: 'paragraph' },\n    audience: 'teams',\n    purpose: 'introduce',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding: customBinding,\n  }], { binding: customBinding });\n  for (const c of result.candidates) {\n    assert.deepEqual(c.binding, customBinding, 'candidate binding must match input');\n  }\n  for (const f of result.findings) {\n    assert.deepEqual(f.binding, customBinding, 'finding binding must match input');\n  }\n});\n\n// ──────────────────────────────────────────────────────────\n// 18. One word alone cannot create a finding\n// ──────────────────────────────────────────────────────────\ntest('B6-013 single banned-word phrase does not produce an interpretive finding from alone', () => {\n  const result = detectAntiSlop([{\n    id: 'test:one-word',\n    text: 'Best',\n    surface: { type: 'heading' },\n    audience: 'users',\n    purpose: 'section title',\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.length, 0, 'single word should produce zero candidates');\n  assert.equal(result.findings.length, 0, 'single word should produce zero findings');\n});\n\n// ──────────────────────────────────────────────────────────\n// 19. No candidate ever replaces copy\n// ──────────────────────────────────────────────────────────\ntest('B6-013 no candidate includes a replacement field', () => {\n  const result = detectAntiSlop(fixtureItems(), {\n    claimProofLedger: { claims: [{ id: 'claim:market-position', disposition: 'unproven', evidenceRefs: [] }] },\n    binding,\n  });\n  for (const c of result.candidates) {\n    assert.equal(c.replacement, undefined, \"'`candidate ${c.ruleId} must not have replacement field`);\n    assert.equal(c.suggestedCopy, undefined, `candidate ${c.ruleId} must not have suggestedCopy field`);\n  }\n});\n'\"'@\n\"'$test | Out-File -FilePath \"D:'\"\\\\Claude\\\\tools\\\\skills\\\\nemesis\\\\tests\\\\content-l3-b6-013.test.mjs\\\" -Encoding utf8NoBOM\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command '$test = @'\"'\nimport test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nimport { fileURLToPath } from 'node:url';\nimport { dirname, join } from 'node:path';\nimport { detectAntiSlop } from '../providers/copy/anti-slop.mjs';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = dirname(__filename);\n\nconst binding = { repository: 'sha256:b6-013-test' };\n\nfunction fixtureItems() {\n  return JSON.parse(readFileSync(join(__dirname, '..', 'bench', 'corpora', 'copy', 'anti-slop', 'fixture-items.json'), 'utf8'));\n}\n\n// ──────────────────────────────────────────────────────────\n// 1. Generic opener detection\n// ──────────────────────────────────────────────────────────\ntest('B6-013 generic-opener: detects generic opening phrases', () => {\n  const result = detectAntiSlop([{\n    id: 'test:gen-opener',\n    text: \\\"In today's fast-paced digital world, every team needs better tools.\\\",\n    surface: { type: 'paragraph' },\n    audience: 'eng leaders',\n    purpose: 'introduce product',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.ok(result.candidates.some(c => c.ruleId === 'copy.anti-slop.generic-opener'),\n    'should detect generic opener');\n});\n\ntest('B6-013 generic-opener: technical near-miss is not flagged', () => {\n  const result = detectAntiSlop([{\n    id: 'test:gen-tech',\n    text: 'In this ever-changing digital world of version control, Git remains dominant.',\n    surface: { type: 'documentation' },\n    audience: 'developers',\n    purpose: 'explain version control landscape',\n    constraints: { technicalTerms: ['version control', 'Git'], technicalUse: true },\n    evidenceRefs: ['evidence:git-doc'],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.generic-opener' && c.contentItemIds.includes('test:gen-tech')), false,\n    'technical use should not be flagged');\n});\n\n// ──────────────────────────────────────────────────────────\n// 2. Empty intensifier detection\n// ──────────────────────────────────────────────────────────\ntest('B6-013 empty-intensifier: detects intensifier without measurable qualifier', () => {\n  const result = detectAntiSlop([{\n    id: 'test:empty-int',\n    text: 'Our incredibly fast parser makes development easy.',\n    surface: { type: 'paragraph' },\n    audience: 'developers',\n    purpose: 'describe capability',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.ok(result.candidates.some(c => c.ruleId === 'copy.anti-slop.empty-intensifier'),\n    'should detect empty intensifier');\n});\n\ntest('B6-013 empty-intensifier: measured qualifier suppresses finding', () => {\n  const result = detectAntiSlop([{\n    id: 'test:measured-int',\n    text: 'Our incredibly fast parser processes 12,000 events per second.',\n    surface: { type: 'paragraph' },\n    audience: 'engineers',\n    purpose: 'describe throughput',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.empty-intensifier' && c.contentItemIds.includes('test:measured-int')), false,\n    'measured qualifier should suppress');\n});\n\ntest('B6-013 empty-intensifier: technicalUse=true suppresses finding', () => {\n  const result = detectAntiSlop([{\n    id: 'test:tech-int',\n    text: 'The incredibly low-latency path handles p99 in under 3 ms.',\n    surface: { type: 'documentation' },\n    audience: 'platform engineers',\n    purpose: 'document performance',\n    constraints: { technicalTerms: ['low-latency'], technicalUse: true },\n    evidenceRefs: ['evidence:perf-doc'],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.empty-intensifier' && c.contentItemIds.includes('test:tech-int')), false,\n    'technicalUse should suppress');\n});\n\n// ──────────────────────────────────────────────────────────\n// 3. Unsupported superlative\n// ──────────────────────────────────────────────────────────\ntest('B6-013 unsupported-superlative: flags superlative without bound claims', () => {\n  const result = detectAntiSlop([{\n    id: 'test:supper',\n    text: 'We are the best analytics platform on the market.',\n    surface: { type: 'paragraph' },\n    audience: 'prospects',\n    purpose: 'establish position',\n    claimRefs: ['claim:pos'],\n    evidenceRefs: [],\n    binding,\n  }], {\n    claimProofLedger: { claims: [{ id: 'claim:pos', disposition: 'unproven', evidenceRefs: [] }] },\n    binding,\n  });\n  assert.ok(result.candidates.some(c => c.ruleId === 'copy.anti-slop.unsupported-superlative'),\n    'should detect unsupported superlative');\n});\n\ntest('B6-013 unsupported-superlative: bound claim suppresses finding', () => {\n  const result = detectAntiSlop([{\n    id: 'test:supper-bound',\n    text: 'We are the fastest query engine in benchmarks.',\n    surface: { type: 'paragraph' },\n    audience: 'prospects',\n    purpose: 'establish position',\n    claimRefs: ['claim:fastest'],\n    evidenceRefs: [],\n    binding,\n  }], {\n    claimProofLedger: { claims: [{ id: 'claim:fastest', disposition: 'bound', evidenceRefs: ['evidence:bench'] }] },\n    binding,\n  });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.unsupported-superlative' && c.contentItemIds.includes('test:supper-bound')), false,\n    'bound claim should suppress');\n});\n\ntest('B6-013 unsupported-superlative: technicalUse=true suppresses finding', () => {\n  const result = detectAntiSlop([{\n    id: 'test:supper-tech',\n    text: 'Select the best-fit algorithm for this data set.',\n    surface: { type: 'documentation' },\n    audience: 'data engineers',\n    purpose: 'give configuration instruction',\n    constraints: { technicalTerms: ['best-fit'], technicalUse: true },\n    evidenceRefs: ['evidence:algo'],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.unsupported-superlative' && c.contentItemIds.includes('test:supper-tech')), false,\n    'technicalUse should suppress');\n});\n\n// ──────────────────────────────────────────────────────────\n// 4. Interchangeable competitor copy\n// ──────────────────────────────────────────────────────────\ntest('B6-013 interchangeable-competitor-copy: detects generic comparison', () => {\n  const result = detectAntiSlop([{\n    id: 'test:competitor',\n    text: 'Better than competitors and ahead of the rest.',\n    surface: { type: 'paragraph' },\n    audience: 'buyers',\n    purpose: 'compare to market',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.ok(result.candidates.some(c => c.ruleId === 'copy.anti-slop.interchangeable-competitor-copy'),\n    'should detect generic competitor comparison');\n});\n\ntest('B6-013 interchangeable-competitor-copy: named competitor with differentiator suppresses', () => {\n  const result = detectAntiSlop([{\n    id: 'test:competitor-named',\n    text: 'Unlike Datadog, our agent uses 60% less memory on equivalent workloads.',\n    surface: { type: 'paragraph' },\n    audience: 'SREs',\n    purpose: 'compare specific capability',\n    constraints: { competitorNames: ['Datadog'] },\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.interchangeable-competitor-copy' && c.contentItemIds.includes('test:competitor-named')), false,\n    'named competitor with bounded outcome should not be flagged as generic');\n});\n\n// ──────────────────────────────────────────────────────────\n// 5. Passive unspecific CTA\n// ──────────────────────────────────────────────────────────\ntest('B6-013 passive-unspecific-cta: detects passive language in CTA context', () => {\n  const result = detectAntiSlop([{\n    id: 'test:cta-passive',\n    text: 'Your experience can be transformed with our solution.',\n    surface: { type: 'button' },\n    audience: 'users',\n    purpose: 'call to action',\n    desiredAction: 'sign up',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.ok(result.candidates.some(c => c.ruleId === 'copy.anti-slop.passive-unspecific-cta'),\n    'should detect passive CTA');\n});\n\ntest('B6-013 passive-unspecific-cta: active CTA is not flagged', () => {\n  const result = detectAntiSlop([{\n    id: 'test:cta-active',\n    text: 'Start your free trial today.',\n    surface: { type: 'button' },\n    audience: 'users',\n    purpose: 'call to action',\n    desiredAction: 'start trial',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.passive-unspecific-cta' && c.contentItemIds.includes('test:cta-active')), false,\n    'active CTA should not be flagged');\n});\n\ntest('B6-013 passive-unspecific-cta: non-CTA context suppresses finding', () => {\n  const result = detectAntiSlop([{\n    id: 'test:not-cta',\n    text: 'The dashboard can be configured to display custom metrics.',\n    surface: { type: 'documentation' },\n    audience: 'operators',\n    purpose: 'explain configuration options',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.passive-unspecific-cta' && c.contentItemIds.includes('test:not-cta')), false,\n    'non-CTA context should not be flagged');\n});\n\n// ──────────────────────────────────────────────────────────\n// 6. Abstract benefit stacking\n// ──────────────────────────────────────────────────────────\ntest('B6-013 abstract-benefit-stacking: detects three or more abstract terms', () => {\n  const result = detectAntiSlop([{\n    id: 'test:stacking',\n    text: 'Drive success through innovation and growth, unlocking value, excellence, and potential.',\n    surface: { type: 'paragraph' },\n    audience: 'leaders',\n    purpose: 'inspire',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.ok(result.candidates.some(c => c.ruleId === 'copy.anti-slop.abstract-benefit-stacking'),\n    'should detect abstract benefit stacking');\n});\n\ntest('B6-013 abstract-benefit-stacking: two abstract terms is not flagged', () => {\n  const result = detectAntiSlop([{\n    id: 'test:two-abstract',\n    text: 'We focus on innovation and growth for our customers.',\n    surface: { type: 'paragraph' },\n    audience: 'leaders',\n    purpose: 'state strategy',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.abstract-benefit-stacking' && c.contentItemIds.includes('test:two-abstract')), false,\n    'two abstract terms should not trigger stacking');\n});\n\n// ──────────────────────────────────────────────────────────\n// 7. Template repetition\n// ──────────────────────────────────────────────────────────\ntest('B6-013 template-repetition: detects duplicate content across items', () => {\n  const result = detectAntiSlop([\n    {\n      id: 'test:rep-a',\n      text: 'We help teams unlock their potential with solutions that inspire confidence.',\n      surface: { type: 'paragraph' },\n      audience: 'managers',\n      purpose: 'explain value',\n      claimRefs: [],\n      evidenceRefs: [],\n      binding,\n    },\n    {\n      id: 'test:rep-b',\n      text: 'We help teams unlock their potential with solutions that inspire confidence.',\n      surface: { type: 'paragraph' },\n      audience: 'managers',\n      purpose: 'explain value',\n      claimRefs: [],\n      evidenceRefs: [],\n      binding,\n    },\n  ], { binding });\n  const repCandidates = result.candidates.filter(c => c.ruleId === 'copy.anti-slop.template-repetition');\n  assert.ok(repCandidates.length >= 1, 'should detect template repetition');\n  assert.ok(repCandidates.some(c => c.contentItemIds.includes('test:rep-a')), 'should include first copy');\n  assert.ok(repCandidates.some(c => c.contentItemIds.includes('test:rep-b')), 'should include second copy');\n});\n\ntest('B6-013 template-repetition: unique content is not flagged', () => {\n  const result = detectAntiSlop([\n    {\n      id: 'test:uniq-a',\n      text: 'The parser handles JSON, YAML, and TOML with configurable error recovery.',\n      surface: { type: 'paragraph' },\n      audience: 'engineers',\n      purpose: 'describe format support',\n      claimRefs: [],\n      evidenceRefs: [],\n      binding,\n    },\n    {\n      id: 'test:uniq-b',\n      text: 'Error recovery modes include strict, lenient, and skip-and-log.',\n      surface: { type: 'paragraph' },\n      audience: 'engineers',\n      purpose: 'describe recovery modes',\n      claimRefs: [],\n      evidenceRefs: [],\n      binding,\n    },\n  ], { binding });\n  assert.equal(result.candidates.some(c => c.ruleId === 'copy.anti-slop.template-repetition'), false,\n    'unique content should not trigger repetition');\n});\n\n// ──────────────────────────────────────────────────────────\n// 8. Fake personalization\n// ──────────────────────────────────────────────────────────\ntest('B6-013 fake-personalization: detects unbound personalization language', () => {\n  const result = detectAntiSlop([{\n    id: 'test:fake-pers',\n    text: 'This recommendation was made just for you based on your interests.',\n    surface: { type: 'hint' },\n    audience: 'end users',\n    purpose: 'surface suggestion',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.ok(result.candidates.some(c => c.ruleId === 'copy.anti-slop.fake-personalization'),\n    'should detect fake personalization');\n});\n\ntest('B6-013 fake-personalization: bound personalization evidence suppresses', () => {\n  const result = detectAntiSlop([{\n    id: 'test:bound-pers',\n    text: 'This recommendation was made just for you based on your search history.',\n    surface: { type: 'hint' },\n    audience: 'end users',\n    purpose: 'surface suggestion',\n    personalizationRefs: ['behavior:recent-search'],\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.fake-personalization' && c.contentItemIds.includes('test:bound-pers')), false,\n    'bound personalization evidence should suppress');\n});\n\n// ──────────────────────────────────────────────────────────\n// 9. Vague transformation claims\n// ──────────────────────────────────────────────────────────\ntest('B6-013 vague-transformation: detects transformation without mechanism or outcome', () => {\n  const result = detectAntiSlop([{\n    id: 'test:vague',\n    text: 'Transform your business with our innovative approach.',\n    surface: { type: 'paragraph' },\n    audience: 'executives',\n    purpose: 'motivate adoption',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.ok(result.candidates.some(c => c.ruleId === 'copy.anti-slop.vague-transformation'),\n    'should detect vague transformation');\n});\n\ntest('B6-013 vague-transformation: mechanism + outcome suppresses finding', () => {\n  const result = detectAntiSlop([{\n    id: 'test:vague-bound',\n    text: 'Transform your CI pipeline with GitHub Actions to cut build times by 40%.',\n    surface: { type: 'paragraph' },\n    audience: 'devops engineers',\n    purpose: 'advise on CI',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.vague-transformation' && c.contentItemIds.includes('test:vague-bound')), false,\n    'mechanism + outcome should suppress');\n});\n\n// ──────────────────────────────────────────────────────────\n// 10. Informational filler\n// ──────────────────────────────────────────────────────────\ntest('B6-013 informational-filler: detects filler phrases', () => {\n  const result = detectAntiSlop([{\n    id: 'test:filler',\n    text: 'At the end of the day, the tool generates a report you can review.',\n    surface: { type: 'paragraph' },\n    audience: 'operators',\n    purpose: 'explain outcome',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.ok(result.candidates.some(c => c.ruleId === 'copy.anti-slop.informational-filler'),\n    'should detect informational filler');\n});\n\ntest('B6-013 informational-filler: content without filler is not flagged', () => {\n  const result = detectAntiSlop([{\n    id: 'test:no-filler',\n    text: 'The report includes CPU, memory, and network utilization per container.',\n    surface: { type: 'paragraph' },\n    audience: 'operators',\n    purpose: 'document report contents',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  assert.equal(result.candidates.some(c =>\n    c.ruleId === 'copy.anti-slop.informational-filler' && c.contentItemIds.includes('test:no-filler')), false,\n    'content without filler should not be flagged');\n});\n\n// ──────────────────────────────────────────────────────────\n// 11. Single word / short text guard (4-word minimum)\n// ──────────────────────────────────────────────────────────\ntest('B6-013 short text guard: items under 4 words produce no interpretive candidates', () => {\n  const result = detectAntiSlop([\n    { id: 'test:short-1', text: 'Revolutionary', surface: { type: 'heading' }, audience: 'buyers', purpose: 'label', binding },\n    { id: 'test:short-2', text: 'Incredible results', surface: { type: 'heading' }, audience: 'buyers', purpose: 'label', binding },\n    { id: 'test:short-3', text: 'Best-in-class', surface: { type: 'heading' }, audience: 'buyers', purpose: 'label', binding },\n  ], { binding });\n  const interpretive = result.candidates.filter(c => c.detectorKind === 'interpretive');\n  assert.equal(interpretive.length, 0, 'short text should not produce interpretive candidates');\n});\n\n// ──────────────────────────────────────────────────────────\n// 12. Context requirement: missing audience/purpose suppresses interpretive candidates\n// ──────────────────────────────────────────────────────────\ntest('B6-013 context requirement: items missing audience and purpose produce no interpretive candidates', () => {\n  const result = detectAntiSlop([{\n    id: 'test:no-context',\n    text: \\\"In today's fast-paced world, our platform delivers truly incredible results with guaranteed outcomes.\\\",\n    surface: { type: 'paragraph' },\n    binding,\n  }], { binding });\n  const interpretive = result.candidates.filter(c => c.detectorKind === 'interpretive');\n  assert.equal(interpretive.length, 0, 'missing context should suppress all interpretive candidates');\n});\n\n// ──────────────────────────────────────────────────────────\n// 13. Deterministic findings are exclusive to explicitBans\n// ──────────────────────────────────────────────────────────\ntest('B6-013 no interpretive rule produces a deterministic finding', () => {\n  const result = detectAntiSlop([{\n    id: 'test:determ-check',\n    text: \\\"In today's fast-paced digital world, our best platform transforms your experience with incredible impact.\\\",\n    surface: { type: 'paragraph' },\n    audience: 'everyone',\n    purpose: 'everything',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], { binding });\n  const deterministic = result.findings.filter(f => f.detectorKind === 'deterministic');\n  assert.equal(deterministic.length, 0, 'interpretive rules should not produce deterministic findings');\n  assert.ok(result.candidates.length > 0, 'should have interpretive candidates');\n});\n\ntest('B6-013 explicitBans produce deterministic findings only', () => {\n  const result = detectAntiSlop([{\n    id: 'test:ban-only',\n    text: 'Guaranteed returns are expected.',\n    surface: { type: 'paragraph' },\n    audience: 'investors',\n    purpose: 'project returns',\n    claimRefs: [],\n    evidenceRefs: [],\n    binding,\n  }], {\n    explicitBans: [{ id: 'claims.no-guaranteed-profit', phrase: 'guaranteed returns' }],\n    binding,\n  });\n  assert.equal(result.findings.length, 1);\n  assert.equal(result.findings[0].detectorKind, 'deterministic');\n  assert.equal(result.findings[0].ruleId, 'claims.no-guaranteed-profit');\n});\n\n// ──────────────────────────────────────────────────────────\n// 14. Feature vectors on every candidate\n// ──────────────────────────────────────────────────────────\ntest('B6-013 every candidate carries a complete feature vector', () => {\n  const result = detectAntiSlop([{\n    id: 'test:fv',\n    text: \\\"In today's fast-paced world, our best-in-class platform provides truly excellent service.\\\",\n    surface: { type: 'paragraph' },\n    audience: 'operators',\n    purpose: 'describe platform',\n    claimRefs: ['claim:quality'],\n    evidenceRefs: [],\n    binding,\n  }], {\n    claimProofLedger: { claims: [{ id: 'claim:quality', disposition: 'unproven', evidenceRefs: [] }] },\n    binding,\n  });\n  assert.ok(result.candidates.length > 0);\n  for (const c of result.candidates) {\n    const fv = c.featureVector;\n    assert.ok(fv, \"'`candidate ${c.ruleId} must have featureVector`);\n    assert.ok(fv.feature, `featureVector must have feature`);\n    assert.ok(fv.span, `featureVector must have span`);\n    assert.ok(typeof fv.context === '\"'object', 'featureVector.context must be object');\n    assert.ok(fv.claimType === 'bound-claim' || fv.claimType === 'unbound-copy', 'claimType must be bound-claim or unbound-copy');\n    assert.ok(typeof fv.surroundingSentence === 'string', 'featureVector.surroundingSentence must be string');\n    assert.ok(typeof fv.technicalUseExcluded === 'boolean', 'featureVector.technicalUseExcluded must be boolean');\n    assert.ok(typeof fv.personalizationEvidenceBound === 'boolean', 'featureVector.personalizationEvidenceBound must be boolean');\n  }\n});\n\n// ──────────────────────────────────────────────────────────\n// 15. Candidate claim includes \\\"because\\\" clause\n// ──────────────────────────────────────────────────────────\ntest('B6-013 candidate claims explain why copy is generic or unsupported', () => {\n  const result = detectAntiSlop([\n    { id: 'test:why-a', text: \\\"In today's fast-paced world, our product leads the market.\\\", surface: { type: 'paragraph' }, audience: 'users', purpose: 'introduce', claimRefs: [], evidenceRefs: [], binding },\n    { id: 'test:why-b', text: 'Our incredibly powerful engine changes everything.', surface: { type: 'paragraph' }, audience: 'users', purpose: 'describe', claimRefs: [], evidenceRefs: [], binding },\n    { id: 'test:why-c', text: 'At the end of the day, we provide solutions for your needs.', surface: { type: 'paragraph' }, audience: 'users', purpose: 'explain', claimRefs: [], evidenceRefs: [], binding },\n  ], { binding });\n  assert.ok(result.candidates.length >= 3);\n  for (const c of result.candidates) {\n    assert.ok(c.claim.includes('because'), \"'`claim must include '\"'because': \"'${c.claim}`);\n    assert.ok(c.claim.length > 30, `claim should be explanatory, not terse: ${c.claim}`);\n  }\n});\n\n// ──────────────────────────────────────────────────────────\n// 16. Fixture corpus round-trip\n// ──────────────────────────────────────────────────────────\ntest('\"'B6-013 fixture corpus produces expected rule coverage', () => {\n  const items = fixtureItems();\n  const result = detectAntiSlop(items, {\n    claimProofLedger: { claims: [{ id: 'claim:market-position', disposition: 'unproven', evidenceRefs: [] }] },\n    binding,\n  });\n  const ruleIds = new Set(result.candidates.map(c 