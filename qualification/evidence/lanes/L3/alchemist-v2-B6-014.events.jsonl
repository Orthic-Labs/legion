{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"\"C:\\\\Program Files\\\\PowerShell\\\\7\\\\pwsh.exe\" -Command '$content = @'\"'\nimport test from 'node:test';\nimport assert from 'node:assert/strict';\n\nimport { analyzeClarity } from '../providers/copy/clarity.mjs';\n\nconst binding = { repository: 'sha256:fixture-b6-014' };\n\nfunction item(overrides) {\n  return {\n    id: 'copy:test',\n    text: '',\n    surface: { type: 'paragraph' },\n    audience: 'test audience',\n    purpose: 'test purpose',\n    evidenceRefs: [],\n    binding,\n    ...overrides,\n  };\n}\n\n// ---------------------------------------------------------------------------\n// Candidate structural invariants\n// ---------------------------------------------------------------------------\n\ntest('B6-014 every candidate carries audience and content role', () => {\n  const result = analyzeClarity([\n    item({ id: 'c:ambig', text: 'It needs updating before you ship.', audience: 'developers' }),\n    item({ id: 'c:hedge', text: 'We may perhaps reconsider.', audience: 'team' }),\n    item({ id: 'c:passive', text: 'The record is deleted by the user.', audience: 'operators' }),\n    item({ id: 'c:clause', text: 'Run the command, although errors may occur.', audience: 'admins' }),\n  ], { binding });\n\n  assert.ok(result.candidates.length > 0);\n  for (const c of result.candidates) {\n    assert.ok(c.audience, \"'`${c.ruleId} must carry audience`);\n    assert.ok(c.contentRole, `${c.ruleId} must carry contentRole`);\n    assert.equal(c.kind, '\"'nemesis-copy-candidate');\n    assert.equal(c.verdict, 'UNADJUDICATED');\n    assert.equal(c.suggestionKind, 'meaning-preserving-editorial-option');\n  }\n});\n\ntest('B6-014 suggestion policy is advisory-only across all candidates', () => {\n  const result = analyzeClarity([\n    item({ id: 'c1', text: 'It works.', audience: 'users' }),\n    item({ id: 'c2', text: 'We may ship.', audience: 'team' }),\n    item({ id: 'c3', text: 'The report is generated by the server.', audience: 'admins' }),\n  ], { binding });\n\n  for (const c of result.candidates) {\n    assert.ok(c.suggestion, \"'`${c.ruleId} must have suggestion`);\n    assert.ok(\n      c.suggestionPolicy.includes('\"'advisory-only'),\n      \"'`${c.ruleId} suggestion must be advisory-only`,\n    );\n  }\n});\n\ntest('\"'B6-014 all candidates share the same denominator digest', () => {\n  const result = analyzeClarity([\n    item({ id: 'c1', text: 'It is great.', audience: 'users' }),\n    item({ id: 'c2', text: 'They may work.', audience: 'team' }),\n  ], { binding });\n\n  for (const c of result.candidates) {\n    assert.equal(c.denominatorDigest, result.denominatorDigest);\n  }\n});\n\n// ---------------------------------------------------------------------------\n// Ambiguous pronouns\n// ---------------------------------------------------------------------------\n\ntest('B6-014 flags ambiguous pronoun at sentence start', () => {\n  const result = analyzeClarity([\n    item({ text: 'It may be better.' }),\n  ], { binding });\n\n  assert.ok(result.candidates.some((c) => c.ruleId === 'copy.clarity.ambiguous-pronoun'));\n  const candidate = result.candidates.find((c) => c.ruleId === 'copy.clarity.ambiguous-pronoun');\n  assert.equal(candidate.span.text, 'It');\n  assert.equal(candidate.span.start, 0);\n});\n\ntest('B6-014 flags ambiguous \\\"this\\\" at sentence start', () => {\n  const result = analyzeClarity([\n    item({ text: 'This affects all users.' }),\n  ], { binding });\n\n  assert.ok(result.candidates.some((c) => c.ruleId === 'copy.clarity.ambiguous-pronoun'));\n  assert.equal(\n    result.candidates.find((c) => c.ruleId === 'copy.clarity.ambiguous-pronoun').span.text,\n    'This',\n  );\n});\n\ntest('B6-014 flags ambiguous \\\"that\\\" at sentence start', () => {\n  const result = analyzeClarity([\n    item({ text: 'That needs review.' }),\n  ], { binding });\n\n  assert.ok(result.candidates.some((c) => c.ruleId === 'copy.clarity.ambiguous-pronoun'));\n  assert.equal(\n    result.candidates.find((c) => c.ruleId === 'copy.clarity.ambiguous-pronoun').span.text,\n    'That',\n  );\n});\n\ntest('B6-014 flags ambiguous \\\"they\\\" at sentence start', () => {\n  const result = analyzeClarity([\n    item({ text: 'They are configured automatically.' }),\n  ], { binding });\n\n  assert.ok(result.candidates.some((c) => c.ruleId === 'copy.clarity.ambiguous-pronoun'));\n  assert.equal(\n    result.candidates.find((c) => c.ruleId === 'copy.clarity.ambiguous-pronoun').span.text,\n    'They',\n  );\n});\n\ntest('B6-014 does not flag mid-sentence pronouns', () => {\n  const result = analyzeClarity([\n    item({ text: 'Check it before submitting.' }),\n  ], { binding });\n\n  assert.equal(\n    result.candidates.some((c) => c.ruleId === 'copy.clarity.ambiguous-pronoun'),\n    false,\n  );\n});\n\n// ---------------------------------------------------------------------------\n// Hedging and repeated hedges\n// ---------------------------------------------------------------------------\n\ntest('B6-014 flags single hedge', () => {\n  const result = analyzeClarity([\n    item({ text: 'This may work for you.' }),\n  ], { binding });\n\n  assert.ok(result.candidates.some((c) => c.ruleId === 'copy.clarity.hedging'));\n  const c = result.candidates.find((c) => c.ruleId === 'copy.clarity.hedging');\n  assert.equal(c.span.text, 'may');\n});\n\ntest('B6-014 flags repeated hedges over the qualifying range', () => {\n  const result = analyzeClarity([\n    item({ text: 'It may perhaps possibly be done.' }),\n  ], { binding });\n\n  assert.ok(result.candidates.some((c) => c.ruleId === 'copy.clarity.repeated-hedge'));\n  assert.equal(result.candidates.some((c) => c.ruleId === 'copy.clarity.hedging'), false);\n  const c = result.candidates.find((c) => c.ruleId === 'copy.clarity.repeated-hedge');\n  assert.equal(c.span.text, 'may perhaps possibly');\n  assert.equal(c.span.start, 3);\n  assert.equal(c.span.end, 21);\n});\n\n// ---------------------------------------------------------------------------\n// Nominalization\n// ---------------------------------------------------------------------------\n\ntest('B6-014 flags nominalization not explained or required', () => {\n  const result = analyzeClarity([\n    item({ text: 'We need better utilization of resources.' }),\n  ], { binding });\n\n  assert.ok(result.candidates.some((c) => c.ruleId === 'copy.clarity.nominalization'));\n  assert.equal(\n    result.candidates.find((c) => c.ruleId === 'copy.clarity.nominalization').span.text,\n    'utilization',\n  );\n});\n\ntest('B6-014 does not penalize a nominalization required and explained for the audience', () => {\n  const result = analyzeClarity([\n    item({\n      text: 'Complete the utilization form.',\n      constraints: { requiredTerms: ['utilization'], explainedTerms: ['utilization'] },\n    }),\n  ], { binding });\n\n  assert.equal(\n    result.candidates.some((c) => c.ruleId === 'copy.clarity.nominalization'),\n    false,\n  );\n});\n\n// ---------------------------------------------------------------------------\n// Unexplained jargon\n// ---------------------------------------------------------------------------\n\ntest('B6-014 flags jargon not required or explained', () => {\n  const result = analyzeClarity([\n    item({ text: 'Use the widget to fetch data.' }),\n  ], {\n    jargon: ['widget'],\n    binding,\n  });\n\n  assert.ok(result.candidates.some((c) => c.ruleId === 'copy.clarity.unexplained-jargon'));\n  assert.equal(\n    result.candidates.find((c) => c.ruleId === 'copy.clarity.unexplained-jargon').span.text,\n    'widget',\n  );\n});\n\ntest('B6-014 does not penalize jargon when required and explained', () => {\n  const result = analyzeClarity([\n    item({\n      text: 'Configure the widget settings.',\n      constraints: { requiredTerms: ['widget'], explainedTerms: ['widget'] },\n    }),\n  ], {\n    jargon: ['widget'],\n    binding,\n  });\n\n  assert.equal(\n    result.candidates.some((c) => c.ruleId === 'copy.clarity.unexplained-jargon'),\n    false,\n  );\n});\n\ntest('B6-014 does not penalize jargon when technicalUse is true', () => {\n  const result = analyzeClarity([\n    item({\n      text: 'Rotate the nonce before retrying.',\n      constraints: { technicalUse: true },\n    }),\n  ], {\n    jargon: ['nonce'],\n    binding,\n  });\n\n  assert.equal(\n    result.candidates.some((c) => c.ruleId === 'copy.clarity.unexplained-jargon'),\n    false,\n  );\n});\n\n// ---------------------------------------------------------------------------\n// Non-specific language\n// ---------------------------------------------------------------------------\n\ntest('B6-014 flags non-specific language', () => {\n  const result = analyzeClarity([\n    item({ text: 'Various things need updating.' }),\n  ], { binding });\n\n  assert.ok(result.candidates.some((c) => c.ruleId === 'copy.clarity.non-specific-language'));\n  const c = result.candidates.find((c) => c.ruleId === 'copy.clarity.non-specific-language');\n  assert.equal(c.span.text, 'Various');\n});\n\n// ---------------------------------------------------------------------------\n// Passive / subject-action clarity\n// ---------------------------------------------------------------------------\n\ntest('B6-014 flags passive construction hiding the actor', () => {\n  const result = analyzeClarity([\n    item({ text: 'The record is deleted by the user.' }),\n  ], { binding });\n\n  assert.ok(result.candidates.some((c) => c.ruleId === 'copy.clarity.subject-action'));\n  const c = result.candidates.find((c) => c.ruleId === 'copy.clarity.subject-action');\n  assert.ok(c.span.text.includes('is deleted'));\n});\n\ntest('B6-014 does not flag a well-formed imperative', () => {\n  const result = analyzeClarity([\n    item({ text: 'Open the dashboard.' }),\n  ], { binding });\n\n  assert.equal(\n    result.candidates.some((c) => c.ruleId === 'copy.clarity.subject-action'),\n    false,\n  );\n});\n\n// ---------------------------------------------------------------------------\n// Nested clauses\n// ---------------------------------------------------------------------------\n\ntest('B6-014 flags nested clause that buries the main action', () => {\n  const result = analyzeClarity([\n    item({ text: 'When the job completes, review the logs carefully.' }),\n  ], { binding });\n\n  assert.ok(result.candidates.some((c) => c.ruleId === 'copy.clarity.nested-clause'));\n  const c = result.candidates.find((c) => c.ruleId === 'copy.clarity.nested-clause');\n  assert.equal(c.span.text, 'When the job completes,');\n});\n\n// ---------------------------------------------------------------------------\n// Buried instructions\n// ---------------------------------------------------------------------------\n\ntest('B6-014 flags buried instruction after a leading condition', () => {\n  const result = analyzeClarity([\n    item({ text: 'If the job fails, click retry.' }),\n  ], { binding });\n\n  assert.ok(result.candidates.some((c) => c.ruleId === 'copy.clarity.buried-instruction'));\n  const c = result.candidates.find((c) => c.ruleId === 'copy.clarity.buried-instruction');\n  assert.ok(c.span.text.includes('click retry'));\n});\n\n// ---------------------------------------------------------------------------\n// Control label deterministic rules\n// ---------------------------------------------------------------------------\n\ntest('B6-014 does not treat a specific label as vague when the control has an outcome', () => {\n  const result = analyzeClarity([\n    item({\n      text: 'Save changes',\n      surface: { type: 'button', controlId: 'save-changes' },\n    }),\n  ], {\n    controls: [{ id: 'save-changes', action: 'save', outcome: 'changes are persisted' }],\n    binding,\n  });\n\n  assert.equal(\n    result.findings.some((f) => f.ruleId === 'copy.clarity.control-label-vague'),\n    false,\n  );\n});\n\n// ---------------------------------------------------------------------------\n// Missing context coverage gaps\n// ---------------------------------------------------------------------------\n\ntest('B6-014 reports coverage gaps for items missing audience or purpose', () => {\n  const result = analyzeClarity([\n    item({ text: 'Something.', audience: null, purpose: null }),\n  ], { binding });\n\n  assert.ok(result.coverageGaps.some((gap) => gap.includes('context-missing:copy:test')));\n});\n\ntest('B6-014 reports no gap when audience and purpose are present', () => {\n  const result = analyzeClarity([\n    item({ text: 'Open the dashboard.', audience: 'ops', purpose: 'navigate' }),\n  ], { binding });\n\n  assert.equal(\n    result.coverageGaps.some((gap) => gap.includes('context-missing:copy:test')),\n    false,\n  );\n});\n\n// ---------------------------------------------------------------------------\n// Cross-cutting: suggestion safety\n// ---------------------------------------------------------------------------\n\ntest('B6-014 suggestion for passive construction preserves existing facts', () => {\n  const result = analyzeClarity([\n    item({ text: 'The report is generated by the scheduler.' }),\n  ], { binding });\n\n  const c = result.candidates.find((c) => c.ruleId === 'copy.clarity.subject-action');\n  assert.ok(c);\n  assert.ok(c.suggestion.length > 0);\n  assert.ok(\n    c.suggestion.includes('scheduler') || c.suggestion.includes('existing'),\n    'suggestion must reference existing facts or preserve meaning',\n  );\n});\n\ntest('B6-014 suggestion for nested clause retains the existing condition', () => {\n  const result = analyzeClarity([\n    item({ text: 'When the build finishes, run the tests.' }),\n  ], { binding });\n\n  const c = result.candidates.find((c) => c.ruleId === 'copy.clarity.nested-clause');\n  assert.ok(c);\n  assert.ok(c.suggestion.length > 0);\n});\n\ntest('B6-014 suggestion for repeated hedge preserves required qualifiers', () => {\n  const result = analyzeClarity([\n    item({ text: 'It may perhaps possibly be correct.' }),\n  ], { binding });\n\n  const c = result.candidates.find((c) => c.ruleId === 'copy.clarity.repeated-hedge');\n  assert.ok(c);\n  assert.ok(c.suggestion.includes('required'));\n});\n'@\n[System.IO.File]::WriteAllText(\\\"D:\\\\Claude\\\\tools\\\\skills\\\\nemesis\\\\tests\\\\content-l3-b6-014.test.mjs\\\", \"'$content, [System.Text.UTF8Encoding]::new($false))'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
