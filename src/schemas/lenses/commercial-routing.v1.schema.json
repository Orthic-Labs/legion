{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "availability", "privateOverlay"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "availability": { "const": "available" },
    "group": {
      "oneOf": [
        { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        { "type": "null" }
      ]
    },
    "privateOverlay": {
      "type": "object",
      "required": ["state", "fields"],
      "properties": {
        "state": { "const": "optional" },
        "fields": { "type": "array", "maxItems": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
