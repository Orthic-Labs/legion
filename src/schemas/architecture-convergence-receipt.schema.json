{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "architecture-convergence-receipt.v4", "title": "Architecture Convergence Receipt", "type": "object", "additionalProperties": false,
  "required": ["schema", "decision_id", "objective", "objective_lineage_id", "intent_epoch", "continuation_epoch", "execution_cancelled", "depth", "rigor", "pass_count", "pass_budget", "revision_ceiling", "decision_fingerprint", "evidence_fingerprint", "acceptance_fingerprint", "acceptance_ledger", "verification", "terminal_state"],
  "properties": {"schema": {"const": "architecture-convergence-receipt.v4"}, "decision_id": {"type": "string", "minLength": 1}, "objective": {"enum": ["sufficient", "optimize", "best_shape"]}, "objective_lineage_id": {"type": "string", "minLength": 1}, "intent_epoch": {"type": "integer", "minimum": 1}, "continuation_epoch": {"type": "integer", "minimum": 1}, "execution_cancelled": {"type": "boolean"}, "depth": {"enum": ["D0", "D1", "D2"]}, "rigor": {"enum": ["lite", "standard", "critical"]}, "pass_count": {"type": "integer", "minimum": 0}, "pass_budget": {"type": "integer", "minimum": 1}, "revision_ceiling": {"const": 3}, "decision_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "evidence_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "acceptance_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "acceptance_ledger": {"type": "object", "additionalProperties": false, "required": ["required", "passed", "open", "deferred", "out_of_scope"], "properties": {"required": {"type": "integer", "minimum": 0}, "passed": {"type": "integer", "minimum": 0}, "open": {"type": "integer", "minimum": 0}, "deferred": {"type": "integer", "minimum": 0}, "out_of_scope": {"type": "integer", "minimum": 0}}}, "verification": {"type": "object", "additionalProperties": false, "required": ["run_id", "observed_at", "integrated_state_identity", "acceptance_fingerprint", "freshness_verdict"], "properties": {"run_id": {"type": "string", "minLength": 1}, "observed_at": {"type": "string", "format": "date-time"}, "integrated_state_identity": {"type": "string", "minLength": 1}, "acceptance_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "freshness_verdict": {"enum": ["FRESH", "STALE", "EXPIRED", "STATE_MISMATCH"]}}}, "terminal_state": {"enum": ["CANDIDATE", "VERIFIED", "FAILED", "BLOCKED", "COMPLETE_WITH_DEBT"]}}
}
