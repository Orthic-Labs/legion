{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orthic.dev/schemas/security/attack-path-hypothesis-v1.json",
  "title": "AttackPathHypothesisV1",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "objectiveId",
    "status",
    "priority",
    "steps",
    "binding",
    "denominatorDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "attack-path-hypothesis"
    },
    "id": {
      "type": "string",
      "pattern": "^sha256:"
    },
    "objectiveId": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "PARTIALLY_SUPPORTED",
        "PROVEN",
        "REFUTED",
        "BLOCKED",
        "UNPROVEN"
      ]
    },
    "priority": {
      "enum": [
        "DIRECT_CROWN_JEWEL",
        "PRIVILEGE_ESCALATION",
        "CROSS_TENANT",
        "CREDENTIAL_PIVOT",
        "LATERAL_PIVOT",
        "CONTROL_BYPASS",
        "PERSISTENT_COMPROMISE",
        "DATA_EXFILTRATION",
        "INTEGRITY_DESTRUCTION",
        "AVAILABILITY_FAILURE",
        "PARTIAL_PATH"
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidateId",
          "role"
        ],
        "properties": {
          "candidateId": {
            "type": "string"
          },
          "role": {
            "enum": [
              "starter",
              "enabler",
              "pivot",
              "privilege-escalation",
              "control-bypass",
              "impact"
            ]
          },
          "producedFacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "attacker-position",
                    "knowledge",
                    "capability",
                    "credential-possession",
                    "principal-access",
                    "network-reachability",
                    "data-access",
                    "object-access",
                    "code-execution",
                    "workflow-state",
                    "control-bypass",
                    "persistence",
                    "availability-impact",
                    "integrity-impact",
                    "confidentiality-impact"
                  ]
                },
                "subject": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "action": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "object": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "scope": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "environment": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tenant": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "attributes": {
                  "type": "object"
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "id": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "unsatisfiedPreconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "attacker-position",
              "knowledge",
              "capability",
              "credential-possession",
              "principal-access",
              "network-reachability",
              "data-access",
              "object-access",
              "code-execution",
              "workflow-state",
              "control-bypass",
              "persistence",
              "availability-impact",
              "integrity-impact",
              "confidentiality-impact"
            ]
          },
          "subject": {
            "type": [
              "string",
              "null"
            ]
          },
          "action": {
            "type": [
              "string",
              "null"
            ]
          },
          "object": {
            "type": [
              "string",
              "null"
            ]
          },
          "scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "environment": {
            "type": [
              "string",
              "null"
            ]
          },
          "tenant": {
            "type": [
              "string",
              "null"
            ]
          },
          "attributes": {
            "type": "object"
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "blockedBy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "binding": {
      "$ref": "security-binding-v1.schema.json"
    },
    "denominatorDigest": {
      "type": "string",
      "pattern": "^sha256:"
    }
  },
  "additionalProperties": false
}
