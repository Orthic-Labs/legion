{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "representative-workload.v1", "title": "Representative Workload Contract", "type": "object", "additionalProperties": false,
  "required": ["schema", "acceptance_fingerprint", "required_items_exercised", "smallest_complete_slice", "actual_workflow", "actual_acceptance_surface", "environment", "representative_data", "artifact", "result", "matrix", "forbidden_proxies", "observed_failures", "hardening_disposition"],
  "properties": {"schema": {"const": "representative-workload.v1"}, "acceptance_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "required_items_exercised": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "smallest_complete_slice": {"type": "string", "minLength": 1}, "actual_workflow": {"type": "string", "minLength": 1}, "actual_acceptance_surface": {"type": "string", "minLength": 1}, "environment": {"type": "object", "additionalProperties": false, "required": ["os", "runtime", "browser_or_device", "locale_timezone_network"], "properties": {"os": {"type": "string", "minLength": 1}, "runtime": {"type": "string", "minLength": 1}, "browser_or_device": {"type": "string", "minLength": 1}, "locale_timezone_network": {"type": "string", "minLength": 1}}}, "representative_data": {"type": "string", "minLength": 1}, "artifact": {"type": "object", "additionalProperties": false, "required": ["kind", "sensitivity", "trust", "retention", "deletion_owner", "digest"], "properties": {"kind": {"enum": ["trace", "log", "screenshot", "video", "report", "receipt", "dataset"]}, "sensitivity": {"enum": ["public", "internal", "sensitive", "restricted"]}, "trust": {"enum": ["trusted", "untrusted_input", "generated_diagnostic"]}, "retention": {"type": "string", "minLength": 1}, "deletion_owner": {"type": "string", "minLength": 1}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}}, "result": {"type": "object", "additionalProperties": false, "required": ["status", "machine_readable", "gateable", "downloadable", "trajectory_correlation_id", "failure_signature"], "properties": {"status": {"enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE"]}, "machine_readable": {"type": "boolean"}, "gateable": {"type": "boolean"}, "downloadable": {"type": "boolean"}, "trajectory_correlation_id": {"type": ["string", "null"]}, "failure_signature": {"type": ["string", "null"]}}}, "matrix": {"type": "object", "additionalProperties": false, "required": ["rationale", "pr_subset", "release_set"], "properties": {"rationale": {"type": "string", "minLength": 1}, "pr_subset": {"type": "array", "items": {"type": "string"}}, "release_set": {"type": "array", "items": {"type": "string"}}}}, "forbidden_proxies": {"type": "array", "items": {"type": "string"}}, "observed_failures": {"type": "array", "items": {"type": "string"}}, "hardening_disposition": {"enum": ["REPAIR_OBSERVED", "DEFER", "OUT_OF_SCOPE", "SAFETY_BLOCK"]}}
}
