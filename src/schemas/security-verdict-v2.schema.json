{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orthic.dev/schemas/security-verdict-v2.json",
  "title": "SecurityVerdictV2",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "candidateId",
    "candidateProvider",
    "adjudicatorProvider",
    "adjudicatorContextId",
    "evidenceStrength",
    "verdict",
    "threatModel",
    "reachability",
    "impact",
    "variantAnalysisRequired"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "kind": {
      "const": "security-verdict"
    },
    "candidateId": {
      "type": "string"
    },
    "candidateProvider": {
      "type": "string"
    },
    "adjudicatorProvider": {
      "type": "string"
    },
    "adjudicatorContextId": {
      "type": "string"
    },
    "evidenceStrength": {
      "enum": [
        "possible",
        "strong-inference",
        "verified"
      ]
    },
    "verdict": {
      "enum": [
        "TRUE_POSITIVE",
        "LIKELY_TRUE_POSITIVE",
        "LIKELY_FALSE_POSITIVE",
        "FALSE_POSITIVE",
        "OUT_OF_SCOPE",
        "HARDENING_GAP",
        "MISUSE_HAZARD"
      ]
    },
    "severity": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        null
      ]
    },
    "threatModel": {
      "type": "string"
    },
    "attackerControl": {
      "type": "string"
    },
    "reachability": {
      "type": "string"
    },
    "trustBoundaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "impact": {
      "type": "string"
    },
    "proof": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "variantAnalysisRequired": {
      "type": "boolean"
    },
    "verdictDigest": {
      "type": "string",
      "pattern": "^sha256:"
    },
    "negativeControl": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "hypothesis",
            "method",
            "outcome"
          ],
          "properties": {
            "hypothesis": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "evidenceStrength": {
            "enum": [
              "strong-inference",
              "verified"
            ]
          }
        },
        "required": [
          "evidenceStrength"
        ]
      },
      "then": {
        "required": [
          "negativeControl"
        ],
        "properties": {
          "negativeControl": {
            "type": "object",
            "required": [
              "hypothesis",
              "method",
              "outcome"
            ],
            "properties": {
              "hypothesis": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
