{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orthic.dev/schemas/security-candidate-v2.json",
  "title": "SecurityCandidateV2",
  "description": "A security primitive proposed by a candidate generator. Never a finding: verdict is always UNADJUDICATED and evidenceStrength never verified. Typed fields are optional; absence means not asserted. v1 candidates upgrade on read.",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "provider",
    "claim",
    "verdict"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "kind": {
      "const": "security-candidate"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "ruleId": {
      "type": "string"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "candidateClass": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sinks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "attackerCapabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "trustBoundaryCrossings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredControls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observedControls": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "chainRoles": {
      "type": "array",
      "items": {
        "enum": [
          "starter",
          "enabler",
          "amplifier",
          "pivot",
          "privilege-escalation",
          "terminal"
        ]
      }
    },
    "entrypointRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assetRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidenceStrength": {
      "enum": [
        "possible",
        "strong-inference"
      ]
    },
    "verdict": {
      "const": "UNADJUDICATED"
    }
  },
  "additionalProperties": true
}
