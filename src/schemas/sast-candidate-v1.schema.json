{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orthic.dev/schemas/sast-candidate-v1.json",
  "title": "SastCandidateV1",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "provider", "ruleId", "candidateClass", "claim", "severityHint", "sinks", "evidenceRefs", "denominatorDigest", "verdict", "adjudicationRequired"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "kind": { "const": "security-candidate" },
    "id": { "type": "string", "pattern": "^sha256:" },
    "provider": { "type": "string" },
    "providerVersion": { "type": "string" },
    "ruleId": { "type": "string" },
    "candidateClass": { "const": "sast" },
    "claim": { "type": "string" },
    "severityHint": { "enum": ["critical", "high", "medium", "low", "info"] },
    "sources": { "type": "array", "items": { "type": "string" } },
    "sinks": { "type": "array", "items": { "type": "string" } },
    "attackerCapabilities": { "type": "array" },
    "preconditions": { "type": "array" },
    "effects": { "type": "array" },
    "assets": { "type": "array" },
    "trustBoundaryCrossings": { "type": "array" },
    "requiredControls": { "type": "array" },
    "observedControls": { "type": "array" },
    "chainRoles": { "type": "array" },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "detectorMetadata": { "type": "object" },
    "uncertainty": { "type": "array", "items": { "type": "string" } },
    "binding": { "type": ["object", "null"] },
    "denominatorDigest": { "type": "string", "pattern": "^sha256:" },
    "verdict": { "const": "UNADJUDICATED" },
    "adjudicationRequired": { "const": true }
  },
  "additionalProperties": true
}
