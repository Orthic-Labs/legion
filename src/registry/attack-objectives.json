{
  "schemaVersion": 1,
  "kind": "attack-objective-registry",
  "objectives": [
    {
      "id": "objective.crown-jewel-access",
      "priority": "DIRECT_CROWN_JEWEL",
      "matches": {
        "assetKinds": [
          "crown-jewel"
        ],
        "factKinds": [
          "data-access",
          "object-access",
          "code-execution",
          "principal-access"
        ]
      }
    },
    {
      "id": "objective.privilege-escalation",
      "priority": "PRIVILEGE_ESCALATION",
      "matches": {
        "factKind": "principal-access",
        "scopePatterns": [
          "admin",
          "owner",
          "control-plane",
          "release",
          "signing"
        ]
      }
    },
    {
      "id": "objective.cross-tenant",
      "priority": "CROSS_TENANT",
      "matches": {
        "factKinds": [
          "data-access",
          "object-access"
        ],
        "scopePatterns": [
          "cross-tenant",
          "cross-workspace",
          "cross-project"
        ]
      }
    },
    {
      "id": "objective.code-execution",
      "priority": "PERSISTENT_COMPROMISE",
      "matches": {
        "factKind": "code-execution"
      }
    },
    {
      "id": "objective.data-exfiltration",
      "priority": "DATA_EXFILTRATION",
      "matches": {
        "factKind": "confidentiality-impact"
      }
    },
    {
      "id": "objective.integrity-destruction",
      "priority": "INTEGRITY_DESTRUCTION",
      "matches": {
        "factKind": "integrity-impact"
      }
    },
    {
      "id": "objective.availability",
      "priority": "AVAILABILITY_FAILURE",
      "matches": {
        "factKind": "availability-impact"
      }
    },
    {
      "id": "objective.credential-pivot",
      "priority": "CREDENTIAL_PIVOT",
      "matches": {
        "factKind": "credential-possession"
      }
    },
    {
      "id": "objective.lateral-pivot",
      "priority": "LATERAL_PIVOT",
      "matches": {
        "factKind": "network-reachability"
      }
    },
    {
      "id": "objective.control-bypass",
      "priority": "CONTROL_BYPASS",
      "matches": {
        "factKind": "control-bypass"
      }
    }
  ],
  "priorityOrder": [
    "DIRECT_CROWN_JEWEL",
    "PRIVILEGE_ESCALATION",
    "CROSS_TENANT",
    "CREDENTIAL_PIVOT",
    "LATERAL_PIVOT",
    "CONTROL_BYPASS",
    "PERSISTENT_COMPROMISE",
    "DATA_EXFILTRATION",
    "INTEGRITY_DESTRUCTION",
    "AVAILABILITY_FAILURE",
    "PARTIAL_PATH"
  ]
}
