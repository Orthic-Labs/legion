      "version": "1",
      "family": "credentials",
      "description": "Credential material in repository artifacts.",
      "module": "src/providers/security/packs/credentials.mjs",
      "selector": {
        "op": "any",
        "selectors": [
          {
            "op": "sourceFilesAtLeast",
            "count": 1
          }
        ]
      },
      "modelRequirements": [
        "repository-artifact"
      ],
      "denominatorKind": "security-relevant-source-files",
      "benchmark": {
        "status": "unproven",
        "requiredForCleanClaim": true
      },
      "producesSecurityCandidates": true,
      "mayCloseOwnCandidates": false,
      "implementationState": "implemented"
