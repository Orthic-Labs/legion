      "paid": true,
      "priority": 65,
      "capabilities": ["keyword_data", "rank_observation", "competitors", "backlinks", "ai_visibility_estimate"]
    },
    "firecrawl": {
      "class": "host_tool",
      "availability": "host_tool",
      "tool_hint": "firecrawl_map",
      "paid": null,
      "priority": 40,
      "capabilities": ["url_discovery", "crawl"]
    }
