  "selection_rules": [
    "First-party evidence wins within its documented measured scope.",
    "Local deterministic evidence wins over paid duplication for mechanical owned-site checks.",
    "Paid providers are optional and require cost/provenance semantics.",
    "Manual first-party exports remain first-party evidence; manual availability is not equivalent to configured runtime automation.",
    "Provider estimates never overwrite first-party observations."
  ]
}