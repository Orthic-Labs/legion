{
  "schemaVersion": 1,
  "kind": "legion-authority-dispatch",
  "packetType": "direct",
  "repositoryRoot": "REPLACE_WITH_EXISTING_REPOSITORY_ROOT",
  "sourceRevision": "REPLACE_WITH_IMMUTABLE_GIT_SHA",
  "sourceArtifact": "REPLACE_WITH_SOURCE_ARTIFACT_IF_USING_CONTENT_DIGEST",
  "promptArtifact": "REPLACE_WITH_CAPTURED_PROMPT_ARTIFACT",
  "promptDigest": "sha256:REPLACE_WITH_REAL_PROMPT_SHA256",
  "modelRouting": {
    "modelTier": "MID",
    "workerProfile": "standard",
    "routingRationale": "Bounded independent implementation"
  },
  "objective": "Non-authoritative template: replace every example value before validation.",
  "authority": [
    "AGENTS.md",
    "task-specific source"
  ],
  "integrationOwner": "current orchestrator",
  "fileTouchPolicy": {
    "mode": "once-end-to-end",
    "plannedFiles": ["src/example.ts", "tests/example.test.ts"],
    "allowUnplannedFiles": false
  },
  "dispatches": [
    {
      "id": "A",
      "dependsOn": [],
      "lanes": ["lane-a-implementation", "lane-a-test"],
      "completionChecks": ["all A lane checks pass and changed paths reconcile"]
    }
  ],
  "workers": [
    {
      "id": "lane-a-implementation",
      "dispatch": "A",
      "executor": "configured worker",
      "allowlist": ["src/example.ts"],
      "read": ["tests/example.test.ts"],
      "forbidden": [".git", "secrets"],
      "checks": ["run implementation-focused check"],
      "dependencies": []
    },
    {
      "id": "lane-a-test",
      "dispatch": "A",
      "executor": "configured worker",
      "allowlist": ["tests/example.test.ts"],
      "read": ["src/example.ts"],
      "forbidden": [".git", "secrets"],
      "checks": ["run focused test"],
      "dependencies": []
    }
  ],
  "oracleAudit": {
    "required": true,
    "mode": "adversarial",
    "status": "required-before-execution",
    "checks": [
      "allowlist-completeness",
      "lane-disjointness",
      "dependency-validity",
      "maximum-safe-parallelization",
      "end-to-end-lane-closure"
    ]
  },
  "recovery": {
    "maxRetries": 2,
    "stopConditions": ["owned path is already dirty", "required private input is missing"],
    "returnFields": ["changedPaths", "checks", "blockers", "baselineRevision", "patchDigest"]
  }
}
