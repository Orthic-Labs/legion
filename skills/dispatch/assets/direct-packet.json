{
  "schemaVersion": 1,
  "kind": "legion-authority-dispatch",
  "packetType": "direct",
  "repositoryRoot": "REPLACE_WITH_EXISTING_REPOSITORY_ROOT",
  "sourceRevision": "REPLACE_WITH_IMMUTABLE_GIT_SHA",
  "sourceArtifact": "REPLACE_WITH_SOURCE_ARTIFACT_IF_USING_CONTENT_DIGEST",
  "promptArtifact": "REPLACE_WITH_CAPTURED_PROMPT_ARTIFACT",
  "promptDigest": "sha256:REPLACE_WITH_REAL_PROMPT_SHA256",
  "modelRouting": {
    "modelTier": "MID",
    "workerProfile": "standard",
    "routingRationale": "Bounded independent implementation"
  },
  "objective": "Non-authoritative template: replace every example value before validation.",
  "authority": [
    "AGENTS.md",
    "task-specific source"
  ],
  "integrationOwner": "current orchestrator",
  "fileTouchPolicy": {
    "mode": "once-end-to-end",
    "plannedFiles": ["src/example.ts", "tests/example.test.ts"],
    "allowUnplannedFiles": false,
    "ledger": [
      {"path": "src/example.ts", "owner": "lane-a-implementation", "operation": "edit", "lane": "lane-a-implementation", "finalCheck": "integration owner implementation-focused check"},
      {"path": "tests/example.test.ts", "owner": "lane-a-test", "operation": "edit", "lane": "lane-a-test", "finalCheck": "integration owner focused test"}
    ]
  },
  "sourcePortPolicy": {
    "applicable": false,
    "sourceImplementation": null,
    "sourceInventory": [],
    "directPortFirst": true,
    "targetLanguage": null,
    "rustTargetRequiresRustPort": true,
    "handRollReplacementWhileSourceExists": false
  },
  "workerPolicy": {
    "mode": "edit-only",
    "mayInspectReadPaths": true,
    "mayEditAllowlistOnly": true,
    "forbiddenActions": ["cargo", "tests", "builds", "generators", "installs", "commits", "pushes", "merges", "expensive-checks"],
    "intendedChecksRecordedFor": "integration owner"
  },
  "integrationPolicy": {
    "owner": "current orchestrator",
    "soleMerger": true,
    "runsCheckpoints": true,
    "mayRepairLaneOwnedFiles": false,
    "repairAction": "return to owning lane or redesign packet before execution"
  },
  "dispatches": [
    {
      "id": "A",
      "dependsOn": [],
      "lanes": ["lane-a-implementation", "lane-a-test"],
      "completionChecks": ["integration owner runs intended checks & all changed paths reconcile"]
    }
  ],
  "workers": [
    {
      "id": "lane-a-implementation",
      "dispatch": "A",
      "executorRequirement": {
        "semanticRequirement": "forbidden",
        "capabilities": ["structured-text-edit"],
        "effects": ["source-read", "artifact-write"],
        "authorityCeiling": ["workspace"],
        "completion": [{"kind": "exact-check", "id": "implementation-checkpoint"}],
        "escalation": {"permittedOn": [], "forbiddenOn": ["denied"]}
      },
      "allowlist": ["src/example.ts"],
      "read": ["tests/example.test.ts"],
      "forbidden": [".git", "secrets"],
      "checks": ["integration owner runs implementation-focused check after merge; worker runs no check"],
      "dependencies": []
    },
    {
      "id": "lane-a-test",
      "dispatch": "A",
      "executorRequirement": {
        "semanticRequirement": "forbidden",
        "capabilities": ["structured-text-edit"],
        "effects": ["source-read", "artifact-write"],
        "authorityCeiling": ["workspace"],
        "completion": [{"kind": "exact-check", "id": "test-checkpoint"}],
        "escalation": {"permittedOn": [], "forbiddenOn": ["denied"]}
      },
      "allowlist": ["tests/example.test.ts"],
      "read": ["src/example.ts"],
      "forbidden": [".git", "secrets"],
      "checks": ["integration owner runs focused test after merge; worker runs no test"],
      "dependencies": []
    }
  ],
  "oracleAudit": {
    "required": true,
    "mode": "adversarial",
    "status": "required-before-execution",
    "checks": [
      "allowlist-completeness",
      "lane-disjointness",
      "dependency-validity",
      "maximum-safe-parallelization",
      "end-to-end-lane-closure",
      "direct-port-priority",
      "worker-edit-only",
      "integration-owner-checkpoints",
      "exact-byte-review-pass"
    ]
  },
  "recovery": {
    "maxRetries": 2,
    "stopConditions": ["owned path is already dirty", "required private input is missing"],
    "returnFields": ["changedPaths", "checks", "blockers", "baselineRevision", "patchDigest"]
  }
}
