{
  "schemaVersion": 2,
  "kind": "legion-publication-policy",
  "contract": "release/distribution-contract.json",
  "note": "Node package is private development tooling. Public distribution uses signed GitHub payloads through branded direct bootstrap.",
  "channels": {
    "npm": {
      "allowed": false,
      "reason": "private-development-tooling"
    },
    "direct-bootstrap": {
      "allowed": false,
      "reason": "release-readiness-evidence-incomplete",
      "requiredEvidence": [
        "platform-artifacts",
        "platform-signatures",
        "provenance-attestations",
        "signed-release-manifest",
        "bootstrap-transaction",
        "rollback-transaction",
        "client-integration-health",
        "channel-authorization"
      ]
    }
  }
}
