{
  "schemaVersion": 1,
  "kind": "legion-publication-policy",
  "contract": "release/distribution-contract.json",
  "note": "Node package is private development tooling. Public distribution remains blocked until signed native-release evidence is complete.",
  "channels": {
    "npm": {
      "allowed": false,
      "reason": "private-development-tooling"
    },
    "signed-release": {
      "allowed": false,
      "reason": "release-readiness-evidence-incomplete",
      "requiredEvidence": [
        "immutable-action-pins",
        "platform-artifacts",
        "platform-signatures",
        "provenance-attestations",
        "package-manager-metadata",
        "channel-authorization"
      ]
    }
  }
}
