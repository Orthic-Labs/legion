{
  "schemaVersion": 2,
  "kind": "legion-distribution-contract",
  "nodePackage": {
    "name": "@orthic-labs/legion",
    "access": "private-development-tooling",
    "public": false,
    "channels": [
      "internal-pack",
      "local-test",
      "ci-test"
    ]
  },
  "nativeRelease": {
    "channel": "direct-bootstrap",
    "public": true,
    "status": "blocked",
    "payloadAuthority": "immutable-github-release",
    "bootstrapAuthority": "https://legion.orthiclabs.com/install.ps1",
    "origin": "installed",
    "executable": "%LOCALAPPDATA%\\Orthic Labs\\Legion\\current\\bin\\legion.exe",
    "bootstrap": {
      "provider": "github-pages",
      "mode": "custom-domain-wrapper",
      "stableKey": "site/install.ps1",
      "payloadAuthority": "immutable-github-release"
    },
    "manifestAuthority": "release-manifest.json+release-manifest.cat",
    "installRoot": "%LOCALAPPDATA%\\Orthic Labs\\Legion",
    "generation": "release-version:declarative-assets-sha256",
    "activation": [
      "legion setup repair --confirm",
      "legion setup status"
    ],
    "activationPath": "%LOCALAPPDATA%\\Orthic Labs\\Legion\\current\\bin\\legion.exe",
    "stablePaths": {
      "origin": "installed",
      "root": "%LOCALAPPDATA%\\Orthic Labs\\Legion",
      "current": "%LOCALAPPDATA%\\Orthic Labs\\Legion\\current",
      "executable": "%LOCALAPPDATA%\\Orthic Labs\\Legion\\current\\bin\\legion.exe",
      "versions": "%LOCALAPPDATA%\\Orthic Labs\\Legion\\versions",
      "previous": "%LOCALAPPDATA%\\Orthic Labs\\Legion\\.current-previous",
      "next": "%LOCALAPPDATA%\\Orthic Labs\\Legion\\.current-next",
      "integrationJournal": "%LOCALAPPDATA%\\Orthic Labs\\Legion\\integration-journal.json",
      "generation": "release-version:declarative-assets-sha256"
    },
    "forbiddenProductionBindings": [
      "repo",
      "dist",
      "target",
      "node_modules"
    ],
    "requiredEvidence": [
      "platform-artifacts",
      "platform-signatures",
      "provenance-attestations",
      "signed-release-manifest",
      "bootstrap-transaction",
      "rollback-transaction",
      "client-integration-health",
      "channel-authorization"
    ]
  },
  "releasePipeline": {
    "publicCi": {
      "provider": "github-actions",
      "repository": "Orthic-Labs/legion",
      "steps": [
        "compile",
        "test",
        "unsigned-qualification",
        "package-smoke",
        "sbom",
        "provenance",
        "unsigned-candidate"
      ],
      "signingCredentials": "forbidden",
      "output": "unsigned-candidate-only"
    },
    "protectedLocalHosts": {
      "execution": "protected-local-host",
      "steps": [
        "sign",
        "finalize",
        "upload"
      ],
      "signingCredentials": "local-only",
      "ciAccess": "forbidden",
      "rebuild": false,
      "input": "exact-unsigned-candidate"
    }
  }
}
