{
  "schemaVersion": 2,
  "kind": "legion-distribution-contract",
  "nodePackage": {
    "name": "@orthic-labs/legion",
    "access": "private-development-tooling",
    "public": false,
    "channels": ["internal-pack", "local-test", "ci-test"]
  },
  "nativeRelease": {
    "channel": "direct-bootstrap",
    "public": true,
    "status": "blocked",
    "payloadAuthority": "immutable-github-release",
    "bootstrapAuthority": "https://legion.orthiclabs.com/install.ps1",
    "manifestAuthority": "release-manifest.json+release-manifest.cat",
    "installRoot": "user-local-versioned-with-stable-current",
    "activation": ["legion setup repair --confirm", "legion setup status"],
    "requiredEvidence": [
      "platform-artifacts",
      "platform-signatures",
      "provenance-attestations",
      "signed-release-manifest",
      "bootstrap-transaction",
      "rollback-transaction",
      "client-integration-health",
      "channel-authorization"
    ]
  },
  "packageManagers": {
    "homebrew": "optional-alias-not-required",
    "winget": "optional-alias-not-required"
  }
}
