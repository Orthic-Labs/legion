{
  "schemaVersion": 1,
  "kind": "attack-path-bridge-registry",
  "bridges": [
    {
      "id": "bridge.credential-data-to-possession",
      "description": "Access to credential material may yield possession of the represented credential.",
      "from": { "kind": "data-access", "action": "read", "scope": "credential-material" },
      "to": { "kind": "credential-possession", "action": "possess" },
      "fieldMap": { "subject": "subject", "object": "object", "environment": "environment", "tenant": "tenant" },
      "evidenceStrength": "strong-inference",
      "relation": "leaks"
    },
    {
      "id": "bridge.credential-to-principal-access",
      "description": "Possession of a credential may enable access as its represented identity when an identity relation exists.",
      "from": { "kind": "credential-possession", "action": "possess" },
      "to": { "kind": "principal-access", "action": "authenticate" },
      "requiresModelRelation": "authenticates-as",
      "evidenceStrength": "strong-inference",
      "relation": "grants"
    },
    {
      "id": "bridge.internal-reach-to-service-entry",
      "description": "Internal network reach can satisfy reachability of an internal service entrypoint.",
      "from": { "kind": "network-reachability", "action": "connect" },
      "to": { "kind": "attacker-position", "action": "reach-entrypoint" },
      "requiresModelRelation": "can-reach",
      "evidenceStrength": "strong-inference",
      "relation": "pivots-to"
    },
    {
      "id": "bridge.code-execution-to-runtime-principal",
      "description": "Code execution in a process may grant the process identity and its scopes.",
      "from": { "kind": "code-execution", "action": "execute" },
      "to": { "kind": "principal-access", "action": "act-as" },
      "requiresModelRelation": "runs-as",
      "evidenceStrength": "strong-inference",
      "relation": "grants"
    },
    {
      "id": "bridge.object-write-to-workflow-state",
      "description": "Object write may alter privileged workflow state.",
      "from": { "kind": "object-access", "action": "write" },
      "to": { "kind": "workflow-state", "action": "alter" },
      "evidenceStrength": "possible",
      "relation": "mutates"
    },
    {
      "id": "bridge.prompt-injection-to-tool-control",
      "description": "Prompt injection may control tool arguments only when a tool-selection relation exists.",
      "from": { "kind": "control-bypass", "action": "influence-model" },
      "to": { "kind": "capability", "action": "control-tool-arguments" },
      "requiresModelRelation": "invokes",
      "evidenceStrength": "possible",
      "relation": "enables"
    },
    {
      "id": "bridge.tool-control-to-side-effect",
      "description": "Tool-argument control may lead to a side effect only when the tool capability and identity are modeled.",
      "from": { "kind": "capability", "action": "control-tool-arguments" },
      "to": { "kind": "object-access", "action": "write" },
      "requiresModelRelation": "runs-as",
      "evidenceStrength": "possible",
      "relation": "causes"
    },
    {
      "id": "bridge.cross-tenant-object-access-to-impact",
      "description": "Cross-tenant object access may constitute a confidentiality or integrity impact.",
      "from": { "kind": "object-access", "action": "read", "scope": "cross-tenant" },
      "to": { "kind": "confidentiality-impact", "action": "disclose" },
      "evidenceStrength": "strong-inference",
      "relation": "results-in"
    },
    {
      "id": "bridge.persistence-to-future-execution",
      "description": "Persistence write may lead to future execution only when an autoload relation exists.",
      "from": { "kind": "persistence", "action": "write" },
      "to": { "kind": "code-execution", "action": "execute" },
      "requiresModelRelation": "loads",
      "evidenceStrength": "possible",
      "relation": "enables"
    }
  ]
}
