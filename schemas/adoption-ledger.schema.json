{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "architecture-adoption-ledger.v3",
  "title": "Architecture Adoption Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ledger_version", "acceptance_fingerprint", "frozen_at", "stages", "consumption_dependencies"],
  "properties": {
    "schema": {"const": "architecture-adoption-ledger.v3"}, "ledger_version": {"type": "integer", "minimum": 1}, "acceptance_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "frozen_at": {"type": "string", "format": "date-time"},
    "stages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stage"}}, "consumption_dependencies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/consumptionDependency"}}
  },
  "$defs": {
    "stage": {"type": "object", "additionalProperties": false, "required": ["stage_id", "owner", "required_items", "produce_readiness", "integrate_readiness", "activate_readiness", "done_state"], "properties": {"stage_id": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "required_items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}, "produce_readiness": {"enum": ["NOT_READY", "READY_TO_PRODUCE", "PRODUCING", "PRODUCED"]}, "integrate_readiness": {"enum": ["NOT_READY", "READY_TO_INTEGRATE", "INTEGRATING", "INTEGRATED"]}, "activate_readiness": {"enum": ["NOT_READY", "READY_TO_ACTIVATE", "ACTIVATING", "ACTIVATED"]}, "done_state": {"enum": ["NOT_STARTED", "IN_PROGRESS", "CANDIDATE", "VERIFIED", "BLOCKED"]}, "integrated_state_identity": {"type": ["string", "null"]}, "verification_admission": {"$ref": "#/$defs/verificationAdmission"}}, "allOf": [{"if": {"properties": {"done_state": {"const": "VERIFIED"}}, "required": ["done_state"]}, "then": {"required": ["integrated_state_identity", "verification_admission"], "properties": {"integrated_state_identity": {"type": "string", "minLength": 1}, "required_items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/verifiedItem"}}}}}]},
    "item": {"type": "object", "additionalProperties": false, "required": ["acceptance_id", "outcome", "producer", "observable_surface", "verification_method", "evidence", "result"], "properties": {"acceptance_id": {"type": "string", "minLength": 1}, "outcome": {"type": "string", "minLength": 1}, "producer": {"type": "string", "minLength": 1}, "observable_surface": {"type": "string", "minLength": 1}, "verification_method": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}, "result": {"enum": ["OPEN", "PASS", "FAIL", "BLOCKED"]}}},
    "verifiedItem": {"allOf": [{"$ref": "#/$defs/item"}, {"type": "object", "required": ["result", "evidence"], "properties": {"result": {"const": "PASS"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}]},
    "verificationAdmission": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "stageId", "stageFingerprint", "runId", "taskId", "contractId", "integratedState", "admittedAt", "authentication"], "properties": {"schemaVersion": {"const": 1}, "kind": {"const": "arcane-adoption-verification"}, "stageId": {"type": "string", "minLength": 1}, "stageFingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "runId": {"type": "string", "minLength": 1}, "taskId": {"type": "string", "minLength": 1}, "contractId": {"type": "string", "minLength": 1}, "integratedState": {"type": "string", "minLength": 1}, "admittedAt": {"type": "string", "format": "date-time"}, "authentication": {"$ref": "#/$defs/authentication"}}},
    "authentication": {"type": "object", "additionalProperties": false, "required": ["alg", "keyId", "mac", "macDomain", "boundFieldsDigest"], "properties": {"alg": {"const": "HMAC-SHA256"}, "keyId": {"type": "string", "minLength": 1}, "mac": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "macDomain": {"const": "arcane-adoption-verification-v1"}, "boundFieldsDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "consumptionDependency": {"type": "object", "additionalProperties": false, "required": ["consumer_stage_id", "consumer_acceptance_id", "producer_stage_id", "producer_acceptance_id", "consumed_artifact_id", "consumption", "required_verification"], "properties": {"consumer_stage_id": {"type": "string", "minLength": 1}, "consumer_acceptance_id": {"type": "string", "minLength": 1}, "producer_stage_id": {"type": "string", "minLength": 1}, "producer_acceptance_id": {"type": "string", "minLength": 1}, "consumed_artifact_id": {"type": "string", "minLength": 1}, "consumption": {"enum": ["INTEGRATE", "ACTIVATE"]}, "required_verification": {"const": true}}}
  }
}
