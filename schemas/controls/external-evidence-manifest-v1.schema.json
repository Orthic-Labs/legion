{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legion-external-evidence-manifest-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "records": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "external-record",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "producer",
          "scope",
          "environment",
          "binding",
          "artifactDigest",
          "observedAt",
          "expiresAt",
          "limitations",
          "claimLevels"
        ],
        "properties": {
          "producer": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "binding": {
            "type": "object"
          },
          "artifactDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "observedAt": {
            "type": "string",
            "minLength": 1
          },
          "expiresAt": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "claimLevels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
