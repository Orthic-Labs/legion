{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orthic.dev/schemas/accepted-risk-v1.json",
  "title": "AcceptedRiskV1",
  "type": "object",
  "required": ["schemaVersion", "kind", "subjectKind", "subjectId", "acceptedBy", "reason", "acceptedAt", "expiresAt", "bindingDigest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "nemesis-accepted-risk" },
    "subjectKind": { "enum": ["finding", "attack-path", "systemic-root-cause"] },
    "subjectId": { "type": "string" },
    "acceptedBy": { "type": "string" },
    "reason": { "type": "string" },
    "acceptedAt": { "type": "string" },
    "expiresAt": { "type": ["string", "null"] },
    "bindingDigest": { "type": "string", "pattern": "^sha256:" }
  },
  "additionalProperties": true
}
