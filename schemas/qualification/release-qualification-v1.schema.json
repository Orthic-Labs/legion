{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legion-release-qualification-v1",
  "type": "object",
  "required": ["schemaVersion", "kind", "evidence", "knownGaps", "decision"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "legion-release-qualification" },
    "evidence": { "type": "array" },
    "knownGaps": { "type": "array" },
    "decision": { "enum": ["RELEASE", "INTERNAL_ONLY", "BLOCKED"] }
  }
}
