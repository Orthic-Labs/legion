{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legion-release-manifest-v1",
  "type": "object",
  "required": ["schemaVersion", "kind", "version", "sourceRevision", "artifacts", "channels"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "legion-release-manifest" },
    "version": { "type": "string", "minLength": 1 },
    "sourceRevision": { "type": "string", "minLength": 7 },
    "artifacts": { "type": "array", "minItems": 1 },
    "channels": { "type": "array" }
  }
}
