{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legion-release-contract-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "observed", "declared", "policy", "externalEvidence", "conflicts", "missing", "claimLevel", "requestedClaimLevel", "targetIds", "supportedPlatforms", "supportedVersions", "architectures", "browsers", "devices", "installationModes", "environments", "roles", "tenants", "plansAndEntitlements", "criticalJourneyIds", "dataClasses", "crownJewelAssets", "budgets", "unsupportedScenarios", "acceptedRiskAuthority", "releaseCandidates", "observedDeclaredConflicts", "missingDeclarations", "binding", "digest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "legion-release-contract" },
    "observed": { "type": "object" },
    "declared": { "type": "object" },
    "policy": { "type": "object" },
    "externalEvidence": { "type": "object" },
    "conflicts": { "$ref": "#/$defs/strings" },
    "missing": { "$ref": "#/$defs/strings" },
    "claimLevel": { "enum": ["inventory", "source", "runtime", "product", "release"] },
    "requestedClaimLevel": { "enum": ["inventory", "source", "runtime", "product", "release"] },
    "targetIds": { "$ref": "#/$defs/strings" },
    "supportedPlatforms": { "$ref": "#/$defs/strings" },
    "supportedVersions": { "$ref": "#/$defs/strings" },
    "architectures": { "$ref": "#/$defs/strings" },
    "browsers": { "$ref": "#/$defs/strings" },
    "devices": { "$ref": "#/$defs/strings" },
    "installationModes": { "$ref": "#/$defs/strings" },
    "environments": { "$ref": "#/$defs/strings" },
    "roles": { "$ref": "#/$defs/strings" },
    "tenants": { "$ref": "#/$defs/strings" },
    "plansAndEntitlements": { "$ref": "#/$defs/strings" },
    "criticalJourneyIds": { "$ref": "#/$defs/strings" },
    "dataClasses": { "$ref": "#/$defs/strings" },
    "crownJewelAssets": { "$ref": "#/$defs/strings" },
    "budgets": { "type": "object" },
    "unsupportedScenarios": { "type": "array" },
    "acceptedRiskAuthority": { "type": ["string", "null"] },
    "releaseCandidates": { "$ref": "#/$defs/strings" },
    "observedDeclaredConflicts": { "$ref": "#/$defs/strings" },
    "missingDeclarations": { "$ref": "#/$defs/strings" },
    "binding": { "type": ["object", "null"] },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "$defs": { "strings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } }
}
