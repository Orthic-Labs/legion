{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orthic.dev/schemas/sbom-receipt-v1.json",
  "title": "SbomReceiptV1",
  "type": "object",
  "required": ["schemaVersion", "kind", "provider", "packageCount", "sourceScope", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "nemesis-sbom-receipt" },
    "provider": { "const": "sbom.syft" },
    "providerVersion": { "type": "string" },
    "packageCount": { "type": "integer", "minimum": 0 },
    "sourceScope": { "type": "string" },
    "toolVersion": { "type": ["string", "null"] },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path", "digest"],
        "properties": {
          "kind": { "enum": ["cyclonedx-json", "spdx-json"] },
          "path": { "type": "string" },
          "digest": { "type": "string", "pattern": "^sha256:" }
        }
      }
    }
  },
  "additionalProperties": true
}
