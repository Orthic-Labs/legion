{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orthic.dev/legion/schemas/analysis-rule-pack.v1.schema.json",
  "title": "Legion executable-free analysis rule pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "packId", "version", "class", "engineContract", "rules"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "analysis-rule-pack"},
    "packId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "class": {"enum": ["A", "B", "C"]},
    "engineContract": {"const": "rust-regex-1"},
    "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}},
    "sourceProvenance": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "$defs": {
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "stableId", "kind", "severity", "confidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "stableId": {"type": "string", "minLength": 1},
        "kind": {"enum": ["lexical", "structural", "algorithmic"]},
        "severity": {"enum": ["error", "warning", "note", "info"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "dataClass": {"type": ["string", "null"]},
        "lifecycle": {"type": ["string", "null"]},
        "paths": {"type": "array", "items": {"$ref": "#/$defs/path"}},
        "matcher": {"$ref": "#/$defs/matcher"},
        "companions": {"$ref": "#/$defs/companions"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "uncertainty": {"type": "array", "items": {"type": "string"}},
        "coverage": {"$ref": "#/$defs/coverage"},
        "remediation": {"type": ["string", "null"]},
        "selector": {"$ref": "blueprint-selector.v1.schema.json"},
        "implementationKey": {"type": ["string", "null"]}
      }
    },
    "path": {
      "type": "object", "additionalProperties": false,
      "properties": {"prefix": {"type": ["string", "null"]}, "suffix": {"type": ["string", "null"]}, "exact": {"type": ["string", "null"]}}
    },
    "matcher": {
      "type": "object", "additionalProperties": false, "required": ["mode", "pattern"],
      "properties": {"mode": {"enum": ["regex", "literal"]}, "pattern": {"type": "string"}}
    },
    "companions": {
      "type": "object", "additionalProperties": false,
      "properties": {"required": {"type": "array", "items": {"$ref": "#/$defs/matcher"}}, "negative": {"type": "array", "items": {"$ref": "#/$defs/matcher"}}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "properties": {"extract": {"enum": ["span", "line", "match"]}, "authority": {"enum": ["lexical", "structural"]}}
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "properties": {"denominator": {"type": ["string", "null"]}, "gaps": {"type": "array", "items": {"type": "string"}}}
    }
  }
}
