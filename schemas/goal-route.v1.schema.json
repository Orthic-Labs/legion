{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://orthic.dev/legion/schemas/goal-route.v1.schema.json","title":"Legion typed goal route v1","type":"object","additionalProperties":false,
  "required": ["schema", "route_id", "purpose", "routine", "comparison_mode", "state_a", "state_b", "constraints", "candidates", "selected_route_id", "selected_critical_path", "parallel_lanes", "bottleneck", "deleted_work", "deferred_work", "invalidation"],
  "oneOf": [
    {"required": ["alchemist"], "not": {"required": ["forge"]}},
    {"required": ["forge"], "not": {"required": ["alchemist"]}}
  ],
  "properties": {
    "schema": {"const": "goal-route.v2"}, "route_id": {"type": "string", "minLength": 1}, "purpose": {"enum": ["DELIVERY", "DIAGNOSTIC"]}, "routine": {"type": "boolean"}, "comparison_mode": {"enum": ["COMPARE", "SINGLE_FEASIBLE"]},
    "state_a": {"$ref": "#/$defs/stateA"}, "state_b": {"$ref": "#/$defs/stateB"}, "constraints": {"type": "object", "additionalProperties": false, "required": ["authority", "safety", "scope", "quality", "cost"], "properties": {"authority": {"$ref": "#/$defs/constraint"}, "safety": {"$ref": "#/$defs/constraint"}, "scope": {"$ref": "#/$defs/constraint"}, "quality": {"$ref": "#/$defs/constraint"}, "cost": {"$ref": "#/$defs/constraint"}}},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}}, "selected_route_id": {"type": "string", "minLength": 1}, "selected_critical_path": {"type": "array", "items": {"type": "string"}}, "parallel_lanes": {"type": "array", "items": {"$ref": "#/$defs/lane"}}, "bottleneck": {"$ref": "#/$defs/bottleneck"}, "deleted_work": {"type": "array", "items": {"$ref": "#/$defs/workItem"}}, "deferred_work": {"type": "array", "items": {"$ref": "#/$defs/deferredItem"}}, "single_feasible_evidence": {"type": "array", "items": {"type": "string"}}, "invalidation": {"$ref": "#/$defs/invalidation"}, "alchemist": {"$ref": "#/$defs/alchemist"}, "forge": {"$ref": "#/$defs/alchemist", "description": "Read-only compatibility alias for predecessor GoalRoute artifacts."}
  },
  "$defs": {
    "evidence": {"type": "object", "additionalProperties": false, "required": ["locator", "sha256", "check"], "properties": {"locator": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "check": {"type": "string", "minLength": 1}}},
    "stateA": {"type": "object", "additionalProperties": false, "required": ["description", "evidence"], "properties": {"description": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}}},
    "proof": {"type": "object", "additionalProperties": false, "required": ["command", "expected", "evidence_path"], "properties": {"command": {"type": "string", "minLength": 1}, "expected": {"type": "string", "minLength": 1}, "evidence_path": {"type": "string", "minLength": 1}}},
    "stateB": {"type": "object", "additionalProperties": false, "required": ["description", "proof"], "properties": {"description": {"type": "string", "minLength": 1}, "proof": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/proof"}}}},
    "constraint": {"type": "object", "additionalProperties": false, "required": ["rule", "evidence_locator"], "properties": {"rule": {"type": "string", "minLength": 1}, "evidence_locator": {"type": "string", "minLength": 1}}},
    "step": {"type": "object", "additionalProperties": false, "required": ["id", "operation", "depends_on", "min_wall_ms", "kind", "b_state_delta"], "properties": {"id": {"type": "string", "minLength": 1}, "operation": {"type": "string", "minLength": 1}, "depends_on": {"type": "array", "items": {"type": "string"}}, "min_wall_ms": {"type": "integer", "minimum": 1}, "kind": {"enum": ["ADVANCE_B", "SAFETY_DEPENDENCY"]}, "b_state_delta": {"type": "string", "minLength": 1}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["id", "constraint_status", "constraint_evidence", "steps", "probabilities_bps", "retry_cost_ms", "rework_cost_ms", "nominal_critical_path_ms", "expected_time_to_verified_b_ms", "cost_units", "risk_units", "rework_units", "status", "evidence"], "properties": {"id": {"type": "string", "minLength": 1}, "constraint_status": {"enum": ["PASS", "FAIL"]}, "constraint_evidence": {"type": "string", "minLength": 1}, "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}, "probabilities_bps": {"type": "object", "additionalProperties": false, "required": ["retry", "terminal_failure"], "properties": {"retry": {"type": "integer", "minimum": 0, "maximum": 10000}, "terminal_failure": {"type": "integer", "minimum": 0, "maximum": 10000}}}, "retry_cost_ms": {"type": "integer", "minimum": 0}, "rework_cost_ms": {"type": "integer", "minimum": 0}, "nominal_critical_path_ms": {"type": "integer", "minimum": 0}, "expected_time_to_verified_b_ms": {"type": "integer", "minimum": 0}, "cost_units": {"type": "integer", "minimum": 0}, "risk_units": {"type": "integer", "minimum": 0}, "rework_units": {"type": "integer", "minimum": 0}, "status": {"enum": ["SELECTED", "REJECTED"]}, "dominance_reason": {"type": ["string", "null"]}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "lane": {"type": "object", "additionalProperties": false, "required": ["id", "steps", "reason"], "properties": {"id": {"type": "string", "minLength": 1}, "steps": {"type": "array", "items": {"type": "string"}}, "reason": {"type": "string", "minLength": 1}}},
    "bottleneck": {"type": "object", "additionalProperties": false, "required": ["step_id", "bound_ms", "resource"], "properties": {"step_id": {"type": "string", "minLength": 1}, "bound_ms": {"type": "integer", "minimum": 1}, "resource": {"type": "string", "minLength": 1}}},
    "workItem": {"type": "object", "additionalProperties": false, "required": ["item", "reason"], "properties": {"item": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}},
    "deferredItem": {"type": "object", "additionalProperties": false, "required": ["item", "until"], "properties": {"item": {"type": "string", "minLength": 1}, "until": {"type": "string", "minLength": 1}}},
    "invalidation": {"type": "object", "additionalProperties": false, "required": ["revision", "semantic_correction", "invalidates", "source_fingerprint_sha256"], "properties": {"revision": {"type": "integer", "minimum": 1}, "semantic_correction": {"enum": ["NONE", "RECOMPILED_FROM_ROOT"]}, "invalidates": {"type": "array", "items": {"type": "string"}}, "source_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "alchemist": {"type": "object", "additionalProperties": false, "required": ["required"], "properties": {"required": {"type": "boolean"}, "run_id": {"type": ["string", "null"]}, "state_ref": {"type": ["string", "null"]}, "checkpoint": {"type": ["string", "null"]}, "reason": {"type": ["string", "null"]}}}
  }
}
