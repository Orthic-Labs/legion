{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orthic.dev/schemas/execution-receipt-v1.json",
  "title": "ExecutionReceiptV1",
  "type": "object",
  "required": ["schemaVersion", "kind", "provider", "spawnStatus"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "nemesis-execution-result" },
    "provider": { "type": "string" },
    "command": {
      "type": ["object", "null"],
      "properties": {
        "executable": { "type": ["string", "null"] },
        "args": { "type": "array", "items": { "type": "string" } },
        "cwd": { "type": ["string", "null"] }
      }
    },
    "startedAt": { "type": ["string", "null"] },
    "completedAt": { "type": ["string", "null"] },
    "durationMs": { "type": ["integer", "null"] },
    "spawnStatus": { "enum": ["completed", "missing", "timeout", "signaled", "error", "blocked"] },
    "exitCode": { "type": ["integer", "null"] },
    "signal": { "type": ["string", "null"] },
    "timedOut": { "type": "boolean" },
    "stdoutArtifact": { "type": ["object", "null"] },
    "stderrArtifact": { "type": ["object", "null"] },
    "environmentKeys": { "type": "array", "items": { "type": "string" } },
    "sandboxReceipt": { "type": ["object", "null"] },
    "tool": { "type": ["object", "null"] },
    "providerResult": { "type": ["object", "null"] }
  },
  "additionalProperties": true
}
