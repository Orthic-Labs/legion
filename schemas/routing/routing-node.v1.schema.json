{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orthic.dev/legion/schemas/routing/routing-node.v1.schema.json",
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "kind"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "kind": { "const": "router" },
            "children": { "type": "array", "items": { "$ref": "#/$defs/node" } },
            "availability": { "enum": ["available", "unavailable"] }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "kind", "targetType", "targetRef"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "kind": { "const": "capability" },
            "targetType": { "enum": ["agent-dispatch", "content"] },
            "targetRef": { "type": "string", "minLength": 1 },
            "availability": { "enum": ["available", "unavailable"] }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "$ref": "#/$defs/node"
}
