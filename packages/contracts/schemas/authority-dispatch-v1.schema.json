{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legion-authority-dispatch-v1",
  "title": "AuthorityDispatch",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/sage" },
    { "$ref": "#/$defs/seer" },
    { "$ref": "#/$defs/alchemist" },
    { "$ref": "#/$defs/worker" }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "pathDigest": { "type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": { "path": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" } } },
    "routing": { "type": "object", "additionalProperties": false, "required": ["modelTier", "workerProfile", "routingRationale"], "properties": { "modelTier": { "type": "string", "minLength": 1 }, "workerProfile": { "type": "string", "minLength": 1 }, "routingRationale": { "type": "string", "minLength": 1 } } },
    "base": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "kind", "packetType", "sourceRevision", "promptDigest", "modelRouting"], "properties": { "schemaVersion": { "const": 1 }, "kind": { "const": "legion-authority-dispatch" }, "packetType": { "enum": ["sage", "seer", "alchemist", "worker"] }, "sourceRevision": { "type": "string", "minLength": 7 }, "promptDigest": { "$ref": "#/$defs/digest" }, "modelRouting": { "$ref": "#/$defs/routing" } } },
    "sage": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["routeBundle"], "properties": { "packetType": { "const": "sage" }, "routeBundle": { "allOf": [{ "$ref": "#/$defs/pathDigest" }, { "properties": { "path": { "pattern": "sage-(architect|diagnose)" } } }] } } }] },
    "seer": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["lens", "scope", "oracle"], "properties": { "packetType": { "const": "seer" }, "lens": { "type": "object", "additionalProperties": false, "required": ["id", "path", "digest"], "properties": { "id": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" } } }, "scope": { "type": "object", "additionalProperties": false, "required": ["read", "forbidden"], "properties": { "read": { "type": "array", "items": { "type": "string" } }, "forbidden": { "type": "array", "items": { "type": "string" } } } }, "oracle": { "$ref": "#/$defs/pathDigest" } } }] },
    "alchemist": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["executionContract", "scope"], "properties": { "packetType": { "const": "alchemist" }, "executionContract": { "type": "object", "additionalProperties": false, "required": ["id", "path", "digest", "sealed", "executable"], "properties": { "id": { "type": "string", "pattern": "^EC-\\d+$" }, "path": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/digest" }, "sealed": { "const": true }, "executable": { "const": true } } }, "scope": { "type": "object", "additionalProperties": false, "required": ["own", "contractOwn"], "properties": { "own": { "type": "array", "items": { "type": "string" } }, "contractOwn": { "type": "array", "items": { "type": "string" } } } } } }] },
    "worker": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["workerCapsule", "taskProjection", "artifactProjection", "oracle"], "properties": { "packetType": { "const": "worker" }, "workerCapsule": { "$ref": "#/$defs/pathDigest" }, "taskProjection": { "type": "object" }, "artifactProjection": { "type": "object" }, "oracle": { "$ref": "#/$defs/pathDigest" } } }] }
  }
}
