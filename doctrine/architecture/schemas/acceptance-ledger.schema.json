{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acceptance-ledger.v2",
  "title": "Frozen Acceptance Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ledger_version", "intent_epoch", "acceptance_manifest_fingerprint", "schedule_fingerprint", "schedule", "frozen_at", "items"],
  "properties": {
    "schema": {"const": "acceptance-ledger.v2"},
    "ledger_version": {"type": "integer", "minimum": 1},
    "intent_epoch": {"type": "integer", "minimum": 1},
    "acceptance_manifest_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "schedule_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "schedule": {
      "type": "object", "additionalProperties": false,
      "required": ["schedule_version", "waves"],
      "properties": {
        "schedule_version": {"type": "integer", "minimum": 1},
        "waves": {"type": "array", "items": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}
      }
    },
    "frozen_at": {"type": "string", "format": "date-time"},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "disposition", "source", "requirement", "owner", "dependencies", "item_fingerprint", "result", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^AC-[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "disposition": {"enum": ["REQUIRED", "DEFERRED", "OUT_OF_SCOPE"]},
        "source": {"type": "string", "minLength": 1}, "requirement": {"type": "string", "minLength": 1},
        "observable_acceptance_surface": {"type": "string", "minLength": 1}, "verification_method": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1}, "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "item_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "revisit_trigger": {"type": "string", "minLength": 1}, "result": {"enum": ["OPEN", "PASS", "FAIL", "NOT_APPLICABLE"]},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {"if": {"properties": {"disposition": {"const": "REQUIRED"}}}, "then": {"required": ["observable_acceptance_surface", "verification_method"]}},
        {"if": {"properties": {"disposition": {"const": "DEFERRED"}}}, "then": {"required": ["revisit_trigger"]}},
        {"if": {"properties": {"disposition": {"const": "OUT_OF_SCOPE"}}}, "then": {"properties": {"result": {"const": "NOT_APPLICABLE"}}}}
      ]
    }
  }
}
