{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"architecture-review-finding.v1", "title":"Architecture Review Finding", "type":"object", "additionalProperties":false,
  "required":["finding_id","fingerprint","verdict","triage_path","dismissal_gate","dismissal_evidence","kind","severity","confidence","reachability","control","impact","disposition","blocker_mapping","evidence","anchors","negative_evidence","affected_decision_ids","first_observed_at","last_observed_at","status","invalidation_cause","invalidation_scope","owner"],
  "properties": {
    "finding_id":{"type":"string","minLength":1},"fingerprint":{"type":"string","minLength":1},"verdict":{"enum":["true_positive","likely_true_positive","needs_more_info","likely_false_positive","false_positive","out_of_scope"]},"triage_path":{"type":"string","minLength":1},"dismissal_gate":{"enum":["process","reachability","control","real_impact","reproduction","bounds","environment","none"]},"dismissal_evidence":{"$ref":"#/$defs/strings"},
    "kind":{"enum":["confirmed_approach","sensitivity_point","trade_off_point","risk","non_risk","evidence_gap","assumption","constraint_conflict","debt","exception"]},"severity":{"enum":["blocker","required_this_slice","follow_up","advisory","nit"]},"confidence":{"enum":["confirmed","high","medium","low","unknown"]},"reachability":{"enum":["reachable","conditionally_reachable","unreachable","unknown"]},"control":{"enum":["attacker_or_user_controlled","internal_only","unknown"]},"impact":{"enum":["demonstrated","modeled","speculative","none"]},"disposition":{"enum":["valid","false_positive","defense_in_depth","not_applicable","unknown"]},"blocker_mapping":{"enum":["FAILED_ACCEPTANCE","FAILED_INVARIANT","SAFETY_BLOCK","NON_BLOCKING"]},
    "vulnerability_class":{"type":"string"},"root_cause":{"type":"string"},"trigger":{"type":"string"},"threat_model":{"type":"string"},"attacker_capability":{"type":"string"},"trust_boundary":{"type":"string"},"blast_radius":{"type":"string"},"coverage":{"type":"string"},"composed_with":{"$ref":"#/$defs/strings"},"claim":{"type":"string"},"evidence":{"$ref":"#/$defs/strings"},"anchors":{"$ref":"#/$defs/strings"},"negative_evidence":{"type":"array","items":{"type":"string"}},"violated_requirement_or_invariant":{"type":"string"},"frozen_acceptance_or_invariant_id":{"type":"string"},"safety_class":{"type":"string"},"affected_decision_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"first_observed_at":{"type":"string","minLength":1},"last_observed_at":{"type":"string","minLength":1},"status":{"enum":["open","addressed_candidate","verified_closed","refuted","accepted_risk","superseded"]},"resolution_reason":{"type":"string"},"caused_by":{"type":"array","items":{"type":"string"},"uniqueItems":true},"supersedes":{"type":"array","items":{"type":"string"},"uniqueItems":true},"minimum_correction":{"type":"string"},"invalidation_cause":{"enum":["premise_false","requirement_change","constraint_change","failed_falsification","security_safety_failure","external_semantic_change","invariant_unsatisfiable","user_reopen","none"]},"invalidation_scope":{"enum":["patch","plan","design","root","none"]},"retest_scope":{"type":"string"},"owner":{"type":"string","minLength":1}
  },"$defs":{"strings":{"type":"array","items":{"type":"string","minLength":1}}},
  "allOf":[{"if":{"properties":{"blocker_mapping":{"enum":["FAILED_ACCEPTANCE","FAILED_INVARIANT"]}}},"then":{"required":["frozen_acceptance_or_invariant_id","minimum_correction"]}},{"if":{"properties":{"blocker_mapping":{"const":"SAFETY_BLOCK"}}},"then":{"required":["safety_class","minimum_correction"]}},{"if":{"properties":{"status":{"const":"accepted_risk"}}},"then":{"required":["resolution_reason"]}}]
}
