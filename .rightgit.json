{
  "schemaVersion": 1,
  "compile": "github-actions-only",
  "lanes": [
    "ci",
    "release-candidate",
    "regenerate",
    "sign-existing"
  ],
  "matrix": {
    "os": [
      "windows-2025",
      "macos-15"
    ],
    "node": [
      "22.23.2"
    ]
  },
  "packageManager": "pnpm@11.24.0",
  "templateVersion": "1.8.0",
  "profile": "rust-hybrid",
  "gate": {
    "path": "scripts/gate.sh"
  },
  "rustCache": {
    "workspaces": [
      "engine"
    ],
    "requiredForGate": true
  },
  "candidate": {
    "buildScript": "ci:unsigned-candidate",
    "checkScript": "ci:unsigned-candidate-check",
    "admissionScript": "release:admission",
    "stageSummaryScript": "release:stage-summary",
    "artifactRoot": "legion-unsigned-candidate",
    "os": [
      "windows-2025",
      "macos-15"
    ],
    "targets": [
      {
        "os": "windows-2025",
        "platform": "windows",
        "architecture": "x86_64"
      },
      {
        "os": "macos-15",
        "platform": "macos",
        "architecture": "arm64"
      }
    ],
    "signWindows": true,
    "signMacos": true,
    "releaseChain": {
      "evidenceVerificationScript": "release:verify-evidence",
      "windowsFinalizeScript": "release:finalize-windows",
      "macosFinalizeScript": "release:finalize-macos",
      "installedQualificationScript": "release:qualify-installed",
      "publishScript": "release:publish-qualified",
      "qualificationRunnerVariable": "LEGION_QUALIFICATION_RUNNER"
    }
  },
  "devArtifact": {
    "windows": "unsigned",
    "windowsGlob": "dist/local-windows/installer/*",
    "retentionDays": 7,
    "dispatch": true,
    "mac": "unsigned",
    "macAppPath": "dist/dev-macos/Legion Installer.app"
  },
  "signExisting": {
    "macSignManifest": "packaging/macos/dev-sign-manifest.json",
    "macPayloadMetadata": "payload.json",
    "macPayloadMetadataSource": "dist/dev-macos/payload.json",
    "environment": "release"
  },
  "ciAllOs": true,
  "regenerate": {
    "script": "ci:regenerate"
  },
  "ciIncremental": true,
  "concurrency": {
    "mainPushes": "queue",
    "reason": "Preserve warm native caches & finish one batched qualification before signing its exact artifact."
  }
}
