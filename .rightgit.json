{
  "schemaVersion": 1,
  "lanes": [
    "ci",
    "release-candidate"
  ],
  "matrix": {
    "os": [
      "ubuntu-24.04",
      "windows-2025",
      "macos-15"
    ],
    "node": [
      "22.23.2"
    ]
  },
  "packageManager": "pnpm@11.24.0",
  "templateVersion": "1.4.0",
  "profile": "rust-hybrid",
  "gate": {
    "path": "scripts/ci/right-git-ci.sh"
  },
  "candidate": {
    "buildScript": "ci:unsigned-candidate",
    "checkScript": "ci:unsigned-candidate-check",
    "artifactRoot": "legion-unsigned-candidate",
    "os": [
      "windows-2025",
      "windows-11-arm",
      "macos-15",
      "macos-15-intel"
    ],
    "targets": [
      {
        "os": "windows-2025",
        "platform": "windows",
        "architecture": "x86_64"
      },
      {
        "os": "windows-11-arm",
        "platform": "windows",
        "architecture": "arm64"
      },
      {
        "os": "macos-15",
        "platform": "macos",
        "architecture": "arm64"
      },
      {
        "os": "macos-15-intel",
        "platform": "macos",
        "architecture": "x86_64"
      }
    ],
    "signWindows": true,
    "signMacos": true
  }
}
