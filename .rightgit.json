{
  "schemaVersion": 1,
  "compile": "github-actions-only",
  "lanes": [
    "ci",
    "release-candidate"
  ],
  "matrix": {
    "os": [
      "ubuntu-24.04",
      "windows-2025",
      "macos-15"
    ],
    "node": [
      "22.23.2"
    ]
  },
  "packageManager": "pnpm@11.24.0",
  "templateVersion": "1.8.0",
  "profile": "rust-hybrid",
  "gate": {
    "path": "scripts/gate.sh"
  },
  "rustCache": {
    "workspaces": [
      "engine"
    ]
  },
  "candidate": {
    "buildScript": "ci:unsigned-candidate",
    "checkScript": "ci:unsigned-candidate-check",
    "admissionScript": "release:admission",
    "stageSummaryScript": "release:stage-summary",
    "artifactRoot": "legion-unsigned-candidate",
    "os": [
      "windows-2025",
      "macos-15"
    ],
    "targets": [
      {
        "os": "windows-2025",
        "platform": "windows",
        "architecture": "x86_64"
      },
      {
        "os": "macos-15",
        "platform": "macos",
        "architecture": "arm64"
      }
    ],
    "signWindows": true,
    "signMacos": true,
    "releaseChain": {
      "evidenceVerificationScript": "release:verify-evidence",
      "windowsFinalizeScript": "release:finalize-windows",
      "macosFinalizeScript": "release:finalize-macos",
      "installedQualificationScript": "release:qualify-installed",
      "publishScript": "release:publish-qualified",
      "qualificationRunnerVariable": "LEGION_QUALIFICATION_RUNNER"
    }
  }
}
