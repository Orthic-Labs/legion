{
  "schemaVersion": 1,
  "lane": "native-app-store-connect-adapter",
  "review": "full for listed files",
  "purpose": "Source ledger for native Rust App Store Connect CLI/MCP transport, operation discovery, aliases, pagination, credential handling, and build upload.",
  "destination": ["engine/crates/legion-apple/src/app_store.rs", "engine/crates/legion-apple/src/app_store_openapi.rs", "engine/crates/legion-apple/src/app_store_upload.rs"],
  "nativeRules": [
    {"sourceLines": [1, 99], "destinationLines": [30, 99], "summary": "Offline discovery catalog exposes request, pagination, template/dry-run, aliases, payload limits, credential inputs, and concrete App Store Connect routes.", "disposition": "merged"},
    {"sourceLines": [102, 137], "destinationLines": [102, 137], "summary": "JSON action dispatch keeps discover local and makes execute an explicit caller field; unknown actions fail before transport.", "disposition": "merged"},
    {"sourceLines": [1, 84], "destinationLines": [142, 263], "summary": "Native aliases resolve apps, builds, TestFlight beta groups/testers/pre-release versions, metadata localizations, submissions, and signing resources to API relationship routes.", "disposition": "merged"},
    {"sourceLines": [1, 84], "destinationLines": [323, 413], "summary": "Request planning validates method/path/query/body shape, fixed HTTPS origin, deterministic query encoding, and bounded JSON bodies.", "disposition": "merged"},
    {"sourceLines": [1, 84], "destinationLines": [266, 321], "summary": "Pagination follows only bounded same-origin links.next GET requests and stops on the first HTTP failure without following its next link.", "disposition": "merged"},
    {"sourceLines": [1, 84], "destinationLines": [450, 500], "summary": "ASC token or issuer/key/private-key credentials use redacted bearer transport and bounded private-key/env reads; ES256 JWT uses App Store Connect audience and 18-minute expiry.", "disposition": "merged"},
    {"sourceLines": [1, 84], "destinationLines": [531, 617], "summary": "Transport disables redirects, bounds Content-Length and streamed response bytes, preserves exact status/data, extracts links.next and processing state, and rejects non-443 or foreign origins.", "disposition": "merged"},
    {"sourceLines": [1, 84], "destinationLines": [620, 710], "summary": "Local tests cover catalog, dry-run redaction, path/origin restrictions, query ordering, pagination bounds, aliases, fixture status/state parsing, and unknown actions.", "disposition": "merged"},
    {"sourceLines": [1, 174], "destinationLines": [1, 407], "summary": "Bounded local OpenAPI JSON discovery indexes operationId/method/path, resolves local refs with cycle/depth/count limits, validates path/query/body inputs, and delegates fixed-origin template/run transport.", "disposition": "merged"},
    {"sourceLines": [1, 398], "destinationLines": [1, 570], "summary": "Native build upload reserves Apple build/upload-file resources, validates exact IPA/PKG size and contiguous operations, opens artifacts once without following links, retains the inspected handle through upload, streams bounded presigned chunks under one total deadline without ASC credentials, verifies Apple SHA_256/MD5 checksums, commits uploaded state, reconciles one ambiguous commit via parent state, redacts presigned response fields, and reports processing separately from publication.", "disposition": "merged"}
  ],
  "operationMapping": [
    {"alias": "apps", "operations": ["list", "view", "create", "update", "delete"], "routes": ["/v1/apps", "/v1/apps/{id}"], "destinationLines": [191, 208]},
    {"alias": "builds", "operations": ["list", "view"], "routes": ["/v1/builds", "/v1/builds/{id}"], "destinationLines": [201, 208], "note": "Binary upload and processing remain distinct API/workflow stages; transport success never claims publication."},
    {"alias": "testflight", "operations": ["list", "view", "create", "update", "delete"], "resources": ["group", "tester", "prerelease"], "routes": ["/v1/betaGroups", "/v1/apps/{id}/betaGroups", "/v1/betaGroups/{id}/betaTesters", "/v1/betaTesters/{id}", "/v1/preReleaseVersions", "/v1/preReleaseVersions/{id}"], "destinationLines": [191, 227]},
    {"alias": "metadata", "operations": ["list", "view", "create", "update", "delete"], "resources": ["version", "localization", "appinfo"], "routes": ["/v1/appStoreVersions", "/v1/appStoreVersions/{id}/appStoreVersionLocalizations", "/v1/appStoreVersionLocalizations/{id}", "/v1/appInfos/{id}/appInfoLocalizations", "/v1/appInfoLocalizations/{id}"], "destinationLines": [191, 227]},
    {"alias": "submission", "operations": ["list", "view", "submit"], "routes": ["/v1/appStoreVersionSubmissions", "/v1/appStoreVersionSubmissions/{id}", "/v1/appStoreVersions/{id}/appStoreVersionSubmission"], "destinationLines": [191, 227]},
    {"alias": "signing", "operations": ["list", "view", "create", "update", "delete"], "resources": ["bundleid", "certificate", "profile"], "routes": ["/v1/bundleIds", "/v1/bundleIds/{id}", "/v1/certificates", "/v1/certificates/{id}", "/v1/profiles", "/v1/profiles/{id}"], "destinationLines": [191, 208]}
  ],
