{
  "name": "@orthic-labs/legion",
  "version": "0.3.18",
  "private": true,
  "description": "Legion routes engineering, research, editorial, design, and commercial work through explicit authority, execution, and evidence controls.",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Orthic Labs",
    "url": "https://github.com/Orthic-Labs"
  },
  "homepage": "https://github.com/Orthic-Labs/legion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orthic-Labs/legion.git"
  },
  "bugs": {
    "url": "https://github.com/Orthic-Labs/legion/issues"
  },
  "keywords": [
    "legion",
    "audit",
    "authority",
    "sage",
    "alchemist",
    "arcane",
    "covenant",
    "claude-code",
    "mcp",
    "code-review",
    "static-analysis",
    "sarif"
  ],
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    ".claude-plugin/",
    ".codex-plugin/",
    "agents/",
    "hooks/",
    "src/config/naming-registry.json",
    "src/config/capability-aliases.json",
    "src/config/naming-legacy-allowlist.json",
    "src/config/portability-allowlist.json",
    "doctrine/",
    "src/evals/architecture/",
    "src/roster/",
    "src/packages/contracts/",
    "src/lib/",
    "src/registry/",
    "src/schemas/",
    "skills/",
    "references/",
    "release/version.json",
    "release/distribution-contract.json",
    "MANIFEST.package.json",
    "README.md",
    "docs/CHANGELOG.md",
    "LICENSE",
    "docs/THIRD_PARTY_NOTICES.md",
    "package.json"
  ],
  "scripts": {
    "ci:unsigned-candidate": "cargo run -q --locked --release --manifest-path engine/Cargo.toml -p xtask -- prepare-unsigned-candidate",
    "ci:unsigned-candidate-check": "cargo run -q --locked --release --manifest-path engine/Cargo.toml -p xtask -- prepare-unsigned-candidate --check",
    "closure:check": "cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- check-dependency-closure",
    "deps:cargo:outdated": "rightkit cargo outdated --manifest-path engine/Cargo.toml",
    "deps:cargo:upgrade": "rightkit cargo upgrade --manifest-path engine/Cargo.toml",
    "deps:pnpm:outdated": "pnpm outdated",
    "deps:pnpm:upgrade": "pnpm update --latest",
    "legion:check": "cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- check-canonical-names && cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- check-authority-parity && cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- check-blueprint-config && cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- check-portability && cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- check-version-parity && cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- generate-schemas --check && cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- check-dependency-closure && cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- check-publication-surface && cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- check-packed-import-closure && cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- check-distribution-contract && cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- check-release-obligations && cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- generate-codex-skill-sidecars --check && cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- generate-skill-catalog --check && cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- generate-host-projection --check && cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- refresh-local-skill-manifests --check && cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- generate-manifest --check && cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- generate-catalogs --check && cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- verify-plugin-parity --check --structural-only && cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- native-cli-inventory && cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- check-native-cli-surface",
    "naming:check": "cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- check-canonical-names",
    "native-cli:capture-rust": "cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- native-cli-capture-rust",
    "native-cli:inventory": "cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- native-cli-inventory",
    "native-cli:parity-installed": "cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- native-cli-parity-installed",
    "native-cli:surface-check": "cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- check-native-cli-surface",
    "native:assemble": "cargo run -q --locked --release --manifest-path engine/Cargo.toml -p xtask -- assemble-native-release",
    "native:check:local": "rightkit cargo check --manifest-path engine/Cargo.toml --workspace --all-targets --locked --release --target x86_64-pc-windows-msvc",
    "native:smoke": "cargo run -q --locked --release --manifest-path engine/Cargo.toml -p xtask -- native-installed-smoke",
    "plugin:dev": "cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- plugin-dev",
    "plugin:surface": "cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- verify-plugin-parity",
    "plugin:verify": "cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- verify-plugin-parity --check",
    "release:admission": "cargo run -q --locked --release --manifest-path engine/Cargo.toml -p xtask -- release-admission",
    "release:build:win:unsigned": "cargo run -q --locked --release --manifest-path engine/Cargo.toml -p xtask -- release-local-windows-development --build-only",
    "release:doctor": "right-release doctor --platform win",
    "release:finalize-macos": "cargo run -q --locked --release --manifest-path engine/Cargo.toml -p xtask -- release-finalize-macos",
    "release:finalize-windows": "cargo run -q --locked --release --manifest-path engine/Cargo.toml -p xtask -- release-finalize-windows",
    "release:local:win:unsigned": "cargo run -q --locked --release --manifest-path engine/Cargo.toml -p xtask -- release-local-windows-development",
    "release:publish-qualified": "cargo run -q --locked --release --manifest-path engine/Cargo.toml -p xtask -- release-publish-qualified",
    "release:qualify-installed": "cargo run -q --locked --release --manifest-path engine/Cargo.toml -p xtask -- release-qualify-installed",
    "release:stage-summary": "cargo run -q --locked --release --manifest-path engine/Cargo.toml -p xtask -- release-stage-summary",
    "release:verify-evidence": "cargo run -q --locked --release --manifest-path engine/Cargo.toml -p xtask -- release-evidence-verification",
    "schemas:check": "cargo run -q --locked --manifest-path engine/Cargo.toml -p legion-dev -- generate-schemas --check",
    "test": "cargo test --locked --manifest-path engine/Cargo.toml -p legion-dev -p xtask -p legion-contracts",
    "windows:finalize": "cargo run -q --locked --release --manifest-path engine/Cargo.toml -p xtask -- package-windows-release --finalize",
    "windows:package": "cargo run -q --locked --release --manifest-path engine/Cargo.toml -p xtask -- package-windows-release",
    "windows:publish": "cargo run -q --locked --release --manifest-path engine/Cargo.toml -p xtask -- package-windows-release --finalize --publish-github",
    "windows:qualify": "cargo run -q --locked --release --manifest-path engine/Cargo.toml -p xtask -- qualify-windows-release"
  },
  "dependencies": {
    "@rightkit/hooks": "0.1.1"
  },
  "devDependencies": {
    "@rightkit/ax": "0.2.4",
    "@rightkit/git": "0.2.24",
    "@rightkit/release": "0.2.105"
  }
}
