{
  "name": "@orthic-labs/legion",
  "version": "0.1.0-dev.0",
  "description": "Evidence-governed whole-repository audit engine.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "legion": "./bin/legion.mjs"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./contracts": "./lib/contracts/index.mjs",
    "./provider-sdk": "./lib/providers/sdk/index.mjs",
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "bin/",
    "audit-complete.mjs",
    "audit-finalize.mjs",
    "audit-plan.mjs",
    "audit-run.mjs",
    "audit-runtime.mjs",
    "audit-verify.mjs",
    "collect-facts.mjs",
    "render-report.mjs",
    "security-chain-pipeline.mjs",
    "security-pipeline.mjs",
    "adapters/",
    "lib/",
    "providers/",
    "registry/",
    "schemas/",
    "integrations/",
    "skills/",
    "scripts/self-test.mjs",
    "scripts/generate-schemas.mjs",
    "scripts/package-smoke.mjs",
    "scripts/check-publication-policy.mjs",
    "scripts/qualify-book.mjs",
    "scripts/report-to-sarif.mjs",
    "references/",
    "MANIFEST.package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "package.json"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "self-test": "node scripts/self-test.mjs",
    "schemas:check": "node scripts/generate-schemas.mjs --check",
    "prepack": "node scripts/check-publication-policy.mjs --channel internal-pack && node scripts/generate-schemas.mjs --check && node --test --test-concurrency=1 tests/*.test.mjs"
  }
}
