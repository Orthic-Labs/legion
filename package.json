{
  "name": "@orthic-labs/nemesis",
  "version": "0.1.0-dev.0",
  "description": "Evidence-governed whole-repository audit engine.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "nemesis": "./bin/nemesis.mjs"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./contracts": "./lib/contracts/index.mjs",
    "./provider-sdk": "./lib/providers/sdk/index.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "providers/",
    "registry/",
    "schemas/",
    "scripts/",
    "references/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "package.json"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "self-test": "node scripts/self-test.mjs",
    "schemas:check": "node scripts/generate-schemas.mjs --check",
    "prepack": "node scripts/check-publication-policy.mjs --channel internal-pack && npm run schemas:check && npm test"
  }
}
