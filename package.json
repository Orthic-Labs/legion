{
  "name": "@orthic-labs/legion",
  "version": "0.3.13",
  "private": true,
  "description": "Legion routes engineering, research, editorial, design, and commercial work through explicit authority, execution, and evidence controls.",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Orthic Labs",
    "url": "https://github.com/Orthic-Labs"
  },
  "homepage": "https://github.com/Orthic-Labs/legion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orthic-Labs/legion.git"
  },
  "bugs": {
    "url": "https://github.com/Orthic-Labs/legion/issues"
  },
  "keywords": [
    "legion",
    "audit",
    "authority",
    "sage",
    "alchemist",
    "arcane",
    "covenant",
    "claude-code",
    "mcp",
    "code-review",
    "static-analysis",
    "sarif"
  ],
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": "./src/lib/index.mjs",
    "./contracts": "./src/lib/contracts/index.mjs",
    "./provider-sdk": "./src/lib/providers/sdk/index.mjs",
    "./schemas/*": "./src/schemas/*",
    "./auto-jury": "./src/lib/auto-jury.mjs"
  },
  "files": [
    ".claude-plugin/",
    ".codex-plugin/",
    "agents/",
    "hooks/",
    "src/config/naming-registry.json",
    "src/config/capability-aliases.json",
    "src/config/naming-legacy-allowlist.json",
    "src/config/portability-allowlist.json",
    "doctrine/",
    "src/evals/architecture/",
    "src/roster/",
    "src/packages/context/",
    "src/packages/contracts/",
    "src/bin/",
    "tools/audit/audit-complete.mjs",
    "tools/audit/audit-finalize.mjs",
    "tools/audit/audit-plan.mjs",
    "tools/audit/audit-run.mjs",
    "tools/audit/audit-runtime.mjs",
    "tools/audit/audit-verify.mjs",
    "tools/audit/collect-facts.mjs",
    "tools/audit/render-report.mjs",
    "tools/audit/security-chain-pipeline.mjs",
    "tools/audit/security-pipeline.mjs",
    "src/adapters/",
    "src/lib/",
    "src/providers/",
    "src/registry/",
    "src/schemas/",
    "src/integrations/",
    "skills/",
    "scripts/self-test.mjs",
    "scripts/generate-schemas.mjs",
    "scripts/normalize-provider-result.mjs",
    "scripts/check-publication-policy.mjs",
    "scripts/check-publication-surface.mjs",
    "scripts/check-packed-import-closure.mjs",
    "scripts/check-distribution-contract.mjs",
    "scripts/check-portability.mjs",
    "scripts/check-version-parity.mjs",
    "scripts/check-canonical-names.mjs",
    "scripts/check-dependency-closure.mjs",
    "scripts/generate-codex-skill-sidecars.mjs",
    "scripts/lib/",
    "scripts/report-to-sarif.mjs",
    "scripts/run-architecture-evals.mjs",
    "references/",
    "release/version.json",
    "release/distribution-contract.json",
    "MANIFEST.package.json",
    "README.md",
    "docs/CHANGELOG.md",
    "LICENSE",
    "docs/THIRD_PARTY_NOTICES.md",
    "package.json"
  ],
  "scripts": {
    "architecture-evals": "node scripts/run-architecture-evals.mjs --json",
    "biome": "biome lint . --max-diagnostics=1000",
    "biome:check": "biome lint . --max-diagnostics=1000",
    "ci:unsigned-candidate": "node scripts/ci/prepare-unsigned-candidate.mjs",
    "ci:unsigned-candidate-check": "node scripts/ci/prepare-unsigned-candidate.mjs --check",
    "closure:check": "node scripts/check-dependency-closure.mjs",
    "legion:check": "node scripts/check-canonical-names.mjs && node scripts/check-authority-parity.mjs && node scripts/check-portability.mjs && node scripts/check-version-parity.mjs && node scripts/generate-schemas.mjs --check && node scripts/check-dependency-closure.mjs && node scripts/check-publication-surface.mjs && node scripts/check-packed-import-closure.mjs && node scripts/check-distribution-contract.mjs && node scripts/check-release-obligations.mjs && node scripts/generate-codex-skill-sidecars.mjs --check && pnpm biome:check && node scripts/generate-skill-catalog.mjs --check && node scripts/generate-host-projection.mjs --check && node scripts/refresh-local-skill-manifests.mjs --check && node scripts/generate-manifest.mjs --check && node scripts/generate-catalogs.mjs --check && node scripts/verify-plugin-parity.mjs --check --structural-only",
    "naming:check": "node scripts/check-canonical-names.mjs",
    "native:assemble": "node scripts/assemble-native-release.mjs",
    "plugin:dev": "node scripts/plugin-dev.mjs",
    "plugin:surface": "node scripts/verify-plugin-parity.mjs",
    "plugin:verify": "node scripts/verify-plugin-parity.mjs --check",
    "release:admission": "node scripts/release/installer-release-chain.mjs admission",
    "release:doctor": "right-release doctor --platform win",
    "release:finalize-macos": "node scripts/release/installer-release-chain.mjs finalize-macos",
    "release:finalize-windows": "node scripts/release/installer-release-chain.mjs finalize-windows",
    "release:publish-qualified": "node scripts/release/installer-release-chain.mjs publish-qualified",
    "release:qualify-installed": "node scripts/release/installer-release-chain.mjs qualify-installed",
    "release:stage-summary": "node scripts/release/installer-release-chain.mjs stage-summary",
    "release:verify-evidence": "node scripts/release/installer-release-chain.mjs evidence-verification",
    "schemas:check": "node scripts/generate-schemas.mjs --check",
    "self-test": "node scripts/self-test.mjs",
    "stage9-runtime-evals": "node scripts/run-stage9-runtime-evals.mjs",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "test:python": "node -e \"const{spawnSync}=require('child_process');const c=process.platform==='win32'?'py':'python3';const a=c==='py'?['-3.11']:[];const s=[...a,'-m','unittest','discover','-s','skills/alchemist/tests','-v'];const d=spawnSync(c,s,{stdio:'inherit'});if(d.error&&d.error.code==='ENOENT'){console.error('WARNING: no Python interpreter found; skipping Python test suites (pnpm test:python)');process.exit(0)}if(d.status!==0)process.exit(d.status??1);const t=spawnSync(c,[...a,'src/lib/dispatch-validator/test_validate_dispatch.py'],{stdio:'inherit'});if(t.error&&t.error.code==='ENOENT'){console.error('WARNING: no Python interpreter found; skipping Python test suites (pnpm test:python)');process.exit(0)}process.exit(t.status??1)\"",
    "windows:finalize": "node scripts/package-windows-release.mjs --finalize",
    "windows:package": "node scripts/package-windows-release.mjs",
    "windows:publish": "node scripts/package-windows-release.mjs --finalize --publish-github",
    "windows:qualify": "node scripts/qualify-windows-release.mjs"
  },
  "dependencies": {
    "@rightkit/hooks": "0.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@rightkit/ax": "0.2.1",
    "@rightkit/git": "0.2.24",
    "@rightkit/release": "0.2.101"
  }
}
