{
  "name": "@orthic-labs/legion",
  "version": "0.1.0-dev.0",
  "description": "Legion routes engineering, research, editorial, design, and commercial work through explicit authority, execution, and evidence controls.",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Orthic Labs",
    "url": "https://github.com/Orthic-Labs"
  },
  "homepage": "https://github.com/Orthic-Labs/legion#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Orthic-Labs/legion.git"
  },
  "bugs": {
    "url": "https://github.com/Orthic-Labs/legion/issues"
  },
  "keywords": [
    "legion",
    "audit",
    "authority",
    "sage",
    "alchemist",
    "oracle",
    "arcane",
    "covenant",
    "claude-code",
    "mcp",
    "code-review",
    "static-analysis",
    "sarif"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "legion": "./bin/legion.mjs"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./contracts": "./lib/contracts/index.mjs",
    "./provider-sdk": "./lib/providers/sdk/index.mjs",
    "./schemas/*": "./schemas/*"
  },
  "files": [
    ".claude-plugin/",
    ".codex-plugin/",
    "agents/",
    "hooks/",
    "config/naming-registry.json",
    "config/naming-legacy-allowlist.json",
    "doctrine/",
    "evals/architecture/",
    "roster/",
    "packages/arcane/",
    "packages/contracts/",
    "packages/oracle/",
    "bin/",
    "audit-complete.mjs",
    "audit-finalize.mjs",
    "audit-plan.mjs",
    "audit-run.mjs",
    "audit-runtime.mjs",
    "audit-verify.mjs",
    "audit-fix/",
    "audit-visual/",
    "collect-facts.mjs",
    "render-report.mjs",
    "security-chain-pipeline.mjs",
    "security-pipeline.mjs",
    "adapters/",
    "lib/",
    "!lib/orthic_transcripts/selftest.py",
    "!lib/orthic_transcripts/tests/",
    "providers/",
    "registry/",
    "schemas/",
    "integrations/",
    "skills/",
    "scripts/self-test.mjs",
    "scripts/generate-schemas.mjs",
    "scripts/package-smoke.mjs",
    "scripts/check-publication-policy.mjs",
    "scripts/check-canonical-names.mjs",
    "scripts/qualify-book.mjs",
    "scripts/report-to-sarif.mjs",
    "scripts/run-architecture-evals.mjs",
    "scripts/refresh-skill-parity.mjs",
    "references/",
    "SKILL.md",
    "MANIFEST.package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "package.json"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "architecture-evals": "node scripts/run-architecture-evals.mjs --json",
    "self-test": "node scripts/self-test.mjs",
    "naming:check": "node scripts/check-canonical-names.mjs",
    "legion:check": "node scripts/check-canonical-names.mjs && node scripts/generate-schemas.mjs --check",
    "schemas:check": "node scripts/generate-schemas.mjs --check",
    "prepack": "node scripts/check-publication-policy.mjs --channel internal-pack && node scripts/check-canonical-names.mjs && node scripts/generate-schemas.mjs --check && node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "dependencies": {
    "@rightkit/hooks": "0.1.0"
  }
}
