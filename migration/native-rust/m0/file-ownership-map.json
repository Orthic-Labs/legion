  "waves": [
    {
      "id": "M1",
      "lanes": ["M1-native-core-vertical-slice"],
      "dependsOn": [],
      "rationale": "The minimal Rust API, binding handshake, policy decision, receipt, CLI, and stdio MCP surface must exist before any package, client, or machine lifecycle can be exercised."
    },
    {
      "id": "M2",
      "lanes": ["M2-portable-integration-and-adapters"],
      "dependsOn": ["M1"],
      "rationale": "Portable package contents and mechanical adapters bind to the M1 installed-command, MCP, catalog, schema, and release identity surface."
    },
    {
      "id": "M3",
      "lanes": ["M3-install-setup-and-state"],
      "dependsOn": ["M2"],
      "rationale": "Machine setup verifies and transactionally registers the M2 adapters/package, then owns persistent-state lifecycle and platform installation paths."
    },
    {
      "id": "M4-M5",
      "lanes": ["M4-capability-migration", "M5-provider-migration"],
      "dependsOn": ["M3"],
      "rationale": "After installed lifecycle proof, broad capability porting and the provider/external-tool boundary have no shared owned file and may run in parallel."
    },
    {
      "id": "M6",
      "lanes": ["M6-installed-product-qualification"],
      "dependsOn": ["M4-M5"],
      "rationale": "Qualification requires the complete installed lifecycle, capabilities, provider boundary, and release binding."
    },
    {
      "id": "M7",
      "lanes": ["M7-hard-cut-and-legacy-deletion"],
      "dependsOn": ["M6"],
      "rationale": "Legacy deletion and distribution/claim cutover are destructive and remain blocked on signed installed-product qualification."
    },
    {
      "id": "M8",
      "lanes": ["M8-cleanup-and-production-observation"],
      "dependsOn": ["M7"],
      "rationale": "Post-cut observation may only begin after the losing product routes are absent and canonical native distribution is active."
    }
  ],
