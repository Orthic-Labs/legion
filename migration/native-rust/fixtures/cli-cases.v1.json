      "expected": {"exit_code": 0, "json": {"kind": "legion-providers", "required_arrays": ["providers"], "contains": {"providers[].id": "framework.major-suite"}}},
      "normalization": {"ignore_paths": ["$.providers[*].version", "$.providers[*].observedAt"], "sort_paths": ["$.providers[*].id"]},
      "deltas": []
