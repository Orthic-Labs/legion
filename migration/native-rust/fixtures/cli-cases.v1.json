        {"path": "src/lib/cli/run.mjs", "symbol": "unknown command dispatch"},
        {"path": "tests/cli.test.mjs", "symbol": "unknown subcommand exits 4"}
      ],
      "input": {"argv": ["frobnicate"]},
      "expected": {"exit_code": 4, "stdout": "", "stderr_contains": ["unknown command"]},
      "normalization": {"ignore_paths": [], "sort_paths": []},
      "deltas": []
    },
    {
