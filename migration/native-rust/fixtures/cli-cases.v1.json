        {"path": "src/lib/cli/help.mjs", "symbol": "COMMANDS/renderHelp"},
        {"path": "tests/cli.test.mjs", "symbol": "--help/--version tests"}
      ],
      "input": {"argv": ["--help"]},
      "expected": {"exit_code": 0, "stdout_contains": ["Usage: legion <command>", "Commands:"], "stderr": ""},
      "normalization": {"ignore_paths": [], "sort_paths": []},
      "deltas": []
    },
    {
      "case_id": "cli-02-unknown-command",
