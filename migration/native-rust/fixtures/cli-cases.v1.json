        {"path": "src/lib/cli/commands/languages.mjs", "symbol": "languages command"},
        {"path": "tests/cli.test.mjs", "symbol": "languages --json"}
      ],
      "input": {"argv": ["languages", "--json"]},
      "expected": {"exit_code": 0, "json": {"kind": "legion-languages", "required_arrays": ["languages"]}},
