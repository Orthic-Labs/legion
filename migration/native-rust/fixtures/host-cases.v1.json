        {"path": "tests/host-adapter-safety.test.mjs", "symbol": "malformed config fails closed"}
      ],
      "input": {"config": ".codex/config.toml", "content": "<<<<<<< HEAD", "operation": "install"},
      "expected": {"error_code": "HARNESS_CONFLICT", "content_changed": false},
      "normalization": {"ignore_paths": ["$.error.message"], "sort_paths": []},
