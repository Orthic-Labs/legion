{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Three-run observed native Claude Code capture; separate source-owned maintainer provenance required",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "host", "binary", "commands", "exports", "ledger", "cases", "packetPlan", "members"],
  "properties": {
    "schema": {"const": "legion-reasoning-native-host-capture/2"},
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "runtime", "sessionId"],
      "properties": {"platform": {"const": "macos"}, "runtime": {"const": "claude-code"}, "sessionId": {"type": "string", "minLength": 1}}
    },
    "binary": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "sourceCommit", "artifactId", "runId", "runAttempt", "jobId", "repository"],
      "properties": {
        "sha256": {"$ref": "#/$defs/digest"}, "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "artifactId": {"type": "integer", "minimum": 1}, "runId": {"type": "integer", "minimum": 1},
        "runAttempt": {"type": "integer", "minimum": 1}, "jobId": {"type": "integer", "minimum": 1},
        "repository": {"const": "Orthic-Labs/legion"}
      }
    },
    "commands": {
      "type": "array", "minItems": 15,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "memberId", "argv", "cwd", "environmentNames", "exitCode", "stdout", "stderr", "run"],
        "properties": {
          "role": {"enum": ["preflight", "plan-preflight", "dispatch-preflight", "plan", "dispatch", "run", "verify", "export"]},
          "memberId": {"type": ["string", "null"], "pattern": "^run-0[1-3]$"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string", "minLength": 1},
          "environmentNames": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}},
          "exitCode": {"enum": [0, 2]}, "stdout": {"$ref": "#/$defs/reference"}, "stderr": {"$ref": "#/$defs/reference"},
          "run": {"type": "string", "minLength": 1}
        }
      }
    },
    "exports": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/reference"}},
    "ledger": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "maxPhysicalAdmissions", "perCallReservationTokens", "reservationCeilingTokens", "width", "retries", "reclaims", "callIds", "admissionUnits", "physicalCalls", "reservedTokens", "actualUsageTokens", "earmarkedTokens"],
      "properties": {
        "kind": {"const": "runner-owned-cumulative-admissions"}, "maxPhysicalAdmissions": {"const": 44},
        "perCallReservationTokens": {"const": 150000}, "reservationCeilingTokens": {"const": 6600000},
        "width": {"const": 1}, "retries": {"const": 0}, "reclaims": {"const": 0},
        "callIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "admissionUnits": {"type": "integer", "minimum": 0, "maximum": 44},
        "physicalCalls": {"type": "integer", "minimum": 0, "maximum": 44},
        "reservedTokens": {"type": "integer", "minimum": 0, "maximum": 6600000},
        "actualUsageTokens": {"type": "integer", "minimum": 0, "maximum": 6600000},
        "earmarkedTokens": {"type": "integer", "minimum": 0, "maximum": 6600000}
      }
    },
    "cases": {"$ref": "#/$defs/reference"}, "packetPlan": {"$ref": "#/$defs/reference"},
    "members": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/member"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "member": {
      "type": "object", "additionalProperties": false,
      "required": ["memberId", "memberIndex", "providerIds", "caseIds", "sourceRoot", "run", "sourceFiles", "manifest", "preflight", "authorization", "checkpoint"],
      "properties": {
        "memberId": {"type": "string", "pattern": "^run-0[1-3]$"}, "memberIndex": {"type": "integer", "minimum": 0, "maximum": 2},
        "providerIds": {"type": "array", "minItems": 5, "maxItems": 6, "uniqueItems": true, "items": {"type": "string"}},
        "caseIds": {"type": "array", "minItems": 10, "maxItems": 12, "uniqueItems": true, "items": {"type": "string"}},
        "sourceRoot": {"type": "string", "minLength": 1}, "run": {"type": "string", "minLength": 1},
        "sourceFiles": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/digest"}},
        "manifest": {"$ref": "#/$defs/reference"}, "preflight": {"$ref": "#/$defs/reference"},
        "authorization": {"$ref": "#/$defs/reference"},
        "checkpoint": {"$ref": "#/$defs/reference"}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "provider", "family", "stage", "scope", "qualificationEligible", "productionQualification", "wholeProviderQualification", "auditCleanClaim", "cases", "qualificationDigest"],
      "properties": {
        "schema": {"const": "legion-reasoning-runtime-accuracy/1"}, "provider": {"type": "string"},
        "family": {"const": "reasoning-runtime"}, "stage": {"const": "finding"},
        "scope": {"const": "known-answer-fixture-cases"}, "qualificationEligible": {"const": true},
        "productionQualification": {"const": false}, "wholeProviderQualification": {"const": false}, "auditCleanClaim": {"const": false},
        "qualificationDigest": {"$ref": "#/$defs/digest"},
        "cases": {"type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "object", "additionalProperties": false,
            "required": ["caseId", "requestId", "run", "matched", "observedFindingIds"],
            "properties": {"caseId": {"type": "string"}, "requestId": {"type": "string"}, "run": {"type": "string"},
              "matched": {"const": true}, "observedFindingIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}
          }
        }
      }
    }
  }
}
